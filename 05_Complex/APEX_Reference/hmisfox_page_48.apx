    dynamicAction amount-1-manual-override (
        name: Amount 1 Manual Override
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P48_AMOUNT_1
        }

        action native-execute-plsql-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ($v("P48_SOURCE_MODE")) {
                      p48RefreshImportPaymentTotals();
                    } else {
                      window.p48InvoicePreview.refresh({
                        immediate: true
                      });
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: N
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P48_AMOUNT_1_AUTO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

