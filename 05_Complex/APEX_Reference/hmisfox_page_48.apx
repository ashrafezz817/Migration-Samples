        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(doc_name) || ' - ' || docid as d,
                       docid as r
                  from doctors
                 where nvl(doc_active, 1) <> 0
                   and clinicid = :P48_CLINICID
                 order by upper(trim(doc_name)), docid
                ```
            displayExtraValues: false
            nullDisplayValue: - Select Doctor -
        }
        cascadingLov {
            parentItems: P48_CLINICID
        }
        layout {
