                t-ButtonRegion--noUI
            ]
        }
        advanced {
            htmlDomId: invoice_payment_buttons
        }
    )

    region invoice-services-locked (
        name: Invoice Services Import
        title: Invoice Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.seq_id line_no,
                       c.c001 source_type,
                       c.c002 source_id,
                       c.c003 serviceid,
                       c.c005 has_price_override,
                       c.n004 price_override,
                       c.c013 pat_serv_req_row_id,
                       c.c014 package_service_id,
                       c.c015 package_instance_id,
                       c.c016 package_line_role,
                       to_number(c.c017) package_component_order,
                       to_number(c.c018) package_parent_line_id,
                       c.c019 package_pricing_method,
                       c.c040 package_definition_token,
                
                       coalesce(
                         c.c039,
                         (
                           select max(s.servicedesc)
                             from services s
                            where upper(trim(s.serviceid)) =
                                  upper(trim(c.c003))
                              and s.list_id = :P48_LIST_ID
                         ),
                         c.c003
                       )
                       || ' ['
                       || c.c003
                       || ']' servicedesc,
                
                       c.n001 qty,
                
                       /* Price and gross */
                       to_number(c.c020) price,
                       to_number(c.c021) my_price,
                
                       /* System plan discount */
                       to_number(c.c027) plan_discount_pct,
                       to_number(c.c028) plan_discount_amount,
                
                       /* Manual discount */
                       nvl(c.c029, 'N') manual_discount_type,
                       to_number(c.c030) manual_discount_pct,
                       to_number(c.c031) manual_discount_amount,
                
                       /* Effective combined discount */
                       c.c032 discount_source,
                       to_number(c.c033) effective_discount_pct,
                       to_number(c.c034) total_discount_amount,
                
                       /* Net, shares, and VAT */
                       to_number(c.c022) my_net,
                       to_number(c.c023) the_pay,
                       to_number(c.c025) vat_val_pat,
                       to_number(c.c024) the_comp,
                       to_number(c.c026) vat_val_co,
                
                       /* Additional calculated metadata */
                       to_number(c.c035) vat_rate,
                       to_number(c.c036) vat_val_pat_ex,
                       c.c037 allow_manual_discount,
                       c.c038 allow_price_override
                
                  from apex_collections c
                 where c.collection_name = 'BIL_IMPORT_PREVIEW_LINES'
                 order by c.seq_id
                ```
        }
        layout {
            sequence: 70
            parentRegion: @container
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            htmlDomId: invoice_services_locked
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                  :P48_SOURCE_MODE in ('NEW_VISIT', 'REQUEST')
                  and nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
            ]
        }

