        column SERVICEID (
            type: popupLov
            heading {
                heading: Service
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            search {
                matchType: startsWith
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select s.serviceid || ' - ' || s.servicedesc as display_value,
                           s.serviceid                            as return_value
                      from price_plan_dtl ppd
                      join services s
                        on s.list_id   = ppd.list_id
                       and s.serviceid = ppd.serviceid
                      join price_list_master plm
                        on plm.list_id = ppd.list_id
                     where ppd.list_id   = :P48_LIST_ID
                       and ppd.plan_code = :P48_PLAN_CODE
                    
                       -- Normal services only. Packages use Import Package.
                       and s.is_package = 2
                    
                       -- Current price list must not be cancelled.
                       and nvl(plm.canceld, 0) = 0
                    
                     order by s.servicedesc,
                              s.serviceid
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 100
                stretch: never
            }
            appearance {
                width: 220
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: SERVICEID
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

