    button import-offer (
        buttonName: IMPORT_OFFER
        label: Add Bundle
        layout {
            sequence: 30
            region: @import-offer
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        advanced {
            htmlDomId: btn_import_offer
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                and :P48_PAYTYPE = 1
                and fnd_app_security.has_permission(
                      'BILLING_PATIENT_INVOICES_CREATE'
                    ) = 'TRUE'
                ```
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function showBundleError(pageItem, message) {
                      apex.message.clearErrors();
                    
                      apex.message.showErrors([{
                        type: "error",
                        location: ["page", "inline"],
                        pageItem: pageItem,
                        message: message,
                        unsafe: false
                      }]);
                    
                      apex.item(pageItem).setFocus();
                    }
                    
                    var bundleQty =
                      apex.item(
                        "P48_BUNDLE_QTY"
                      ).getNativeValue();
                    
                    if (!$v("P48_OFFER_ID")) {
                      showBundleError(
                        "P48_OFFER_ID",
                        "Select a Bundled Offer first."
                      );
                      return;
                    }
                    
                    if (
                      !$v("P48_BUNDLE_QTY") ||
                      !Number.isFinite(bundleQty) ||
                      bundleQty <= 0 ||
                      Math.floor(bundleQty) !== bundleQty
                    ) {
                      showBundleError(
                        "P48_BUNDLE_QTY",
                        "Bundle quantity must be a positive whole number."
                      );
                      return;
                    }
                    
                    p48LoadBundledOfferLinesIntoIg({
                      processName:
                        "GET_BUNDLED_OFFER_IG_LINES",
                    
                      pageItems:
                        "#P48_SOURCE_MODE,#P48_MODE,#P48_PATIENTNO," +
                        "#P48_PAYTYPE,#P48_INFO_CENTER_ID,#P48_OFFER_ID,#P48_BUNDLE_QTY",
                    
                      successMessage:
                        "Bundled Offer added."
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    button import-package (
        buttonName: IMPORT_PACKAGE
        label: Import Package
        layout {
            sequence: 20
            region: @import-package
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }
        advanced {
            htmlDomId: btn_import_package
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                and fnd_app_security.has_permission(
                      'BILLING_PATIENT_INVOICES_CREATE'
                    ) = 'TRUE'
                ```
        }

        triggerAction native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @import-package
            }
            execution {
                sequence: 40
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P48_PACKAGE_SERVICEID
            }
        )

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (!$v("P48_PACKAGE_SERVICEID")) {
                      apex.message.clearErrors();
                      apex.message.showErrors([{
                        type: "error",
                        location: ["page", "inline"],
                        pageItem: "P48_PACKAGE_SERVICEID",
                        message: "Select a package first.",
                        unsafe: false
                      }]);
                      apex.item("P48_PACKAGE_SERVICEID").setFocus();
                      return;
                    }
                    
                    p48LoadPackageImportLinesIntoIg({
                      processName: "GET_PACKAGE_LINES_FOR_IG",
                      pageItems:"#P48_SOURCE_MODE,#P48_MODE,#P48_PACKAGE_SERVICEID," + "#P48_LIST_ID,#P48_PLAN_CODE",
                      successMessage: "Package services added.",
                      errorMessage: "Package services could not be loaded."
                    });
                    ```
            }
            execution {
                sequence: 30
            }
        )

    )

