    region invoice-summary-card (
        name: Invoice Summary Card
        type: staticContent
        source {
            htmlCode:
                ```html
                <section
                  class="inv-card"
                  aria-labelledby="invoice-summary-heading"
                  data-payer-type="&P48_PAYTYPE!ATTR."
                  data-class-name="&P48_CLASS_NAME!ATTR."
                  data-mode="&P48_MODE!ATTR."
                  data-deductible-cap="&P48_MAX_DEDUCTIBLE!ATTR."
                >
                  <div class="inv-card__head">
                    <div class="inv-card__head-left">
                
                      <h2
                        id="invoice-summary-heading"
                        class="inv-card__kicker"
                      >
                        Patient Invoice
                      </h2>
                
                      <p class="inv-card__name">
                        &P48_PATIENT_NAME!HTML.
                      </p>
                    </div>
                
                  <span
                    class="inv-card__badge app-badge app-badge--light app-badge--md"
                    role="status"
                    aria-label="Invoice mode"
                    data-mode="&P48_MODE!ATTR."
                  >
                    &P48_DISPLAY_MODE!HTML.
                  </span>
                  </div>
                
                  <dl class="inv-card__body">
                
                    <div class="inv-field">
                      <dt class="inv-field__label">
                        Invoice No
                      </dt>
                      <dd class="inv-field__value">
                        &P48_INV_NO!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field">
                      <dt class="inv-field__label">
                        MRN
                      </dt>
                      <dd class="inv-field__value">
                        &P48_PATIENTNO!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field">
                      <dt class="inv-field__label">
                        Mobile
                      </dt>
                      <dd class="inv-field__value">
                        &P48_MOBILE_NO!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field">
                      <dt class="inv-field__label">
                        Coverage
                      </dt>
                      <dd class="inv-field__value">
                        &P48_COVERAGE_TYPE!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field inv-field--wide inv-field--payer">
                      <dt class="inv-field__label">
                        Company
                      </dt>
                      <dd class="inv-field__value">
                        &P48_COMP_NAME!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field inv-field--class">
                      <dt class="inv-field__label">
                        Class
                      </dt>
                      <dd class="inv-field__value">
                        &P48_CLASS_NAME!HTML.
                      </dd>
                    </div>
                
                    <div class="inv-field inv-field--deductible">
                      <dt class="inv-field__label">
                        Patient Deductible Cap
                      </dt>
                
                      <dd class="inv-field__value">
                        &P48_MAX_DEDUCTIBLE!HTML.
                        &P48_CURR_CODE!HTML.
                      </dd>
                
                      <dd class="inv-field__help">
                        Maximum across eligible invoice services.
                      </dd>
                    </div>
                
                  </dl>
                </section>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @invoice-context
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: invoice_summary_card
        }
    )

