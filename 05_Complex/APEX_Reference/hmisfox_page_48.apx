    process add-bundled-offer-to-draft (
        name: GET_BUNDLED_OFFER_IG_LINES
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_lines           bil_invoice_api.t_editable_preview_line_tab;
                  l_idx             pls_integer;
                  l_bundle_qty      number;
                  l_service_display varchar2(4000);
                
                  procedure write_num (
                    p_name  in varchar2,
                    p_value in number
                  )
                  is
                  begin
                    apex_json.write(
                      p_name,
                      nvl(p_value, 0)
                    );
                  end write_num;
                
                begin
                  if :P48_SOURCE_MODE is not null then
                    raise_application_error(
                      -20882,
                      'Bundled Offer can be added only in manual invoice mode.'
                    );
                  end if;
                
                  if upper(nvl(:P48_MODE, 'CREATE')) = 'VIEW' then
                    raise_application_error(
                      -20883,
                      'Cannot add Bundled Offer in view mode.'
                    );
                  end if;
                
                  if :P48_PATIENTNO is null then
                    raise_application_error(
                      -20885,
                      'Patient is required before adding a Bundled Offer.'
                    );
                  end if;
                
                  if nvl(:P48_PAYTYPE, 0) <> 1 then
                    raise_application_error(
                      -20886,
                      'Bundled Offers are available only for Cash invoices.'
                    );
                  end if;
                
                  if :P48_OFFER_ID is null then
                    raise_application_error(
                      -20887,
                      'Select a Bundled Offer first.'
                    );
                  end if;
                
                  if :P48_BUNDLE_QTY is null
                     or not regexp_like(trim(:P48_BUNDLE_QTY), '^\d+$')
                  then
                    raise_application_error(
                      -20888,
                      'Bundle quantity must be a positive whole number.'
                    );
                  end if;
                
                  l_bundle_qty :=
                    to_number(:P48_BUNDLE_QTY);
                
                  if l_bundle_qty <= 0 then
                    raise_application_error(
                      -20888,
                      'Bundle quantity must be a positive whole number.'
                    );
                  end if;
                
                  /*
                   * Browser-model bundle import.
                   * No BIL_INV_DRAFT_LINES insert/update/delete happens here.
                   */
                  bil_invoice_api.get_bundled_offer_ig_lines(
                    p_patientno      => :P48_PATIENTNO,
                    p_paytype        => :P48_PAYTYPE,
                    p_invoice_date   => sysdate,
                    p_info_center_id => :P48_INFO_CENTER_ID,
                    p_offer_id       => :P48_OFFER_ID,
                    p_bundle_qty     => l_bundle_qty,
                    o_lines          => l_lines
                  );
                
                  apex_json.open_object;
                  apex_json.write('success', true);
                  apex_json.write('message', 'Bundled Offer added.');
                  apex_json.open_array('lines');
                
                  l_idx :=
                    l_lines.first;
                
                  while l_idx is not null loop
                    /*
                     * API should already return components only.
                     * This guard keeps the browser clean if that ever changes.
                     */
                    if nvl(l_lines(l_idx).offer_type, -1) = 0
                       and upper(nvl(l_lines(l_idx).offer_line_role, '~')) = 'COMPONENT'
                    then
                      l_service_display :=
                        trim(l_lines(l_idx).serviceid)
                        || case
                             when trim(l_lines(l_idx).servicedesc) is not null
                             then ' - ' || trim(l_lines(l_idx).servicedesc)
                           end;
                
                      apex_json.open_object;
                
                      apex_json.write('sourceType', 'BUNDLE');
                      apex_json.write('sourceId', to_char(l_lines(l_idx).offer_id));
                
                      apex_json.write('serviceId', l_lines(l_idx).serviceid);
                      apex_json.write('serviceDisplay', l_service_display);
                      apex_json.write('serviceDesc', l_lines(l_idx).servicedesc);
                
                      write_num('qty', l_lines(l_idx).qty);
                
                      write_num('unitPrice', l_lines(l_idx).price);
                      write_num('price', l_lines(l_idx).price);
                      write_num('myPrice', l_lines(l_idx).my_price);
                      write_num('grossAmount', l_lines(l_idx).my_price);
                
                      apex_json.write(
                        'discountType',
                        nvl(l_lines(l_idx).manual_discount_type, 'N')
                      );
                
                      write_num(
                        'disc',
                        l_lines(l_idx).manual_discount_pct
                      );
                
                      write_num(
                        'myDisc',
                        l_lines(l_idx).manual_discount_amount
                      );
                
                      write_num('myNet', l_lines(l_idx).my_net);
                      write_num('netAmount', l_lines(l_idx).my_net);
                
                      write_num('thePay', l_lines(l_idx).the_pay);
                      write_num('patientShare', l_lines(l_idx).the_pay);
                
                      write_num('theComp', l_lines(l_idx).the_comp);
                      write_num('providerShare', l_lines(l_idx).the_comp);
                
                      write_num('vatRate', l_lines(l_idx).vat_rate);
                
                      write_num('vatValPat', l_lines(l_idx).vat_val_pat);
                      write_num('patientVat', l_lines(l_idx).vat_val_pat);
                
                      write_num('vatValCo', l_lines(l_idx).vat_val_co);
                      write_num('providerVat', l_lines(l_idx).vat_val_co);
                
                      write_num(
                        'patientVatExemptAmount',
                        l_lines(l_idx).vat_val_pat_ex
                      );
                
                      apex_json.write('reqNeedA', l_lines(l_idx).req_need_a);
                      apex_json.write('reqAStatus', l_lines(l_idx).req_a_status);
                
                      apex_json.write(
                        'allowManualDiscount',
                        nvl(l_lines(l_idx).allow_manual_discount, 'N')
                      );
                
                      apex_json.write(
                        'allowPriceOverride',
                        nvl(l_lines(l_idx).allow_price_override, 'N')
                      );
                
                      /*
                       * Package columns intentionally blank for bundle rows.
                       */
                      apex_json.write('packageServiceId', '');
                      apex_json.write('packageInstanceId', '');
                      apex_json.write('packageLineRole', '');
                      apex_json.write('packageComponentOrder', '');
                      apex_json.write('packageParentLineId', '');
                      apex_json.write('packagePricingMethod', '');
                
                      /*
                       * Persistent offer evidence.
                       */
                      apex_json.write('offerId', l_lines(l_idx).offer_id);
                      apex_json.write('offerDtlId', l_lines(l_idx).offer_dtl_id);
                      apex_json.write('offerType', l_lines(l_idx).offer_type);
                      apex_json.write('offerInstanceId', l_lines(l_idx).offer_instance_id);
                      apex_json.write('offerLineRole', l_lines(l_idx).offer_line_role);
                      apex_json.write('offerParentLineId', l_lines(l_idx).offer_parent_line_id);
                      apex_json.write('offerPriceApplied', l_lines(l_idx).offer_price_applied);
                      apex_json.write('offerDisApplied', l_lines(l_idx).offer_dis_applied);
                      apex_json.write('offerNameSnapshot', l_lines(l_idx).offer_name_snapshot);
                      apex_json.write(
                        'offerObjectVersionNumber',
                        l_lines(l_idx).offer_object_version_number
                      );
                      apex_json.write(
                        'offerDtlObjectVersionNumber',
                        l_lines(l_idx).offer_dtl_object_version_number
                      );
                
                      apex_json.close_object;
                    end if;
                
                    l_idx :=
                      l_lines.next(l_idx);
                  end loop;
                
                  apex_json.close_array;
                  apex_json.close_object;
                
                exception
                  when others then
                    apex_debug.error(
                      'GET_BUNDLED_OFFER_IG_LINES failed: %s',
                      sqlerrm
                    );
                
                    apex_json.open_object;
                    apex_json.write('success', false);
                
                    if sqlcode between -20999 and -20000 then
                      apex_json.write(
                        'message',
                        regexp_replace(
                          sqlerrm,
                          '^ORA-[0-9]{5}:[[:space:]]*',
                          ''
                        )
                      );
                    else
                      apex_json.write(
                        'message',
                        'Bundled Offer could not be loaded.'
                      );
                    end if;
                
                    apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 70
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 44019096142214726
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fnd_app_security.has_permission('BILLING_PATIENT_INVOICES_CREATE') = 'TRUE'
        }
    )

    process apply-manual-coverage-context (
        name: Apply Manual Coverage Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_ctx            bil_types.t_patient_context;
                  l_cash_comp_code companys.comp_code%type;
                  l_cash_comp_name companys.comp_name%type;
                  l_plan_code      price_plan_m.plan_code%type;
                  l_list_id        price_plan_m.list_id%type;
                  l_curr_code      price_list_master.curr_code%type;
                  l_info_center_id price_list_master.the_info_center%type;
                  l_paytype        number;
                  l_is_credit      varchar2(1);
                begin
                  if :P48_PATIENTNO is null then
                    raise_application_error(
                      -20886,
                      'Patient is required.'
                    );
                  end if;
                
                  l_is_credit :=
                    patient_util.is_credit_patient(
                      p_patientno => :P48_PATIENTNO
                    );
                
                  :P48_IS_CREDIT_PATIENT :=
                    l_is_credit;
                
                  l_paytype :=
                    to_number(:P48_MANUAL_PAYTYPE);
                
                  if l_is_credit = 'N'
                     and l_paytype <> 1
                  then
                    raise_application_error(
                      -20890,
                      'This Cash patient cannot use Insurance / Direct Contract.'
                    );
                  end if;
                
                  if l_is_credit = 'N' then
                    l_paytype :=
                      1;
                
                    :P48_MANUAL_PAYTYPE :=
                      1;
                  end if;
                
                  :P48_PAYTYPE :=
                    l_paytype;
                
                  if l_paytype = 1 then
                    l_cash_comp_code :=
                      ins_comp_util.get_cash_comp_code;
                
                    select get_price_plan(
                             :G_INFO_CENTER_ID,
                             l_cash_comp_code
                           )
                      into l_plan_code
                      from dual;
                
                    select list_id
                      into l_list_id
                      from price_plan_m
                     where plan_code = l_plan_code;
                
                    select comp_name
                      into l_cash_comp_name
                      from companys
                     where comp_code = l_cash_comp_code;
                
                    select curr_code,
                           the_info_center
                      into l_curr_code,
                           l_info_center_id
                      from price_list_master
                     where list_id = l_list_id;
                
                    :P48_COVERAGE_MODE :=
                      'CASH';
                
                    :P48_COVERAGE_TYPE :=
                      'Cash';
                
                    :P48_COMP_NAME :=
                      l_cash_comp_name;
                
                    :P48_CLASS_NAME :=
                      null;
                
                    :P48_MAX_DEDUCTIBLE :=
                      null;
                
                    :P48_PLAN_CODE :=
                      l_plan_code;
                
                    :P48_LIST_ID :=
                      l_list_id;
                
                    :P48_CURR_CODE :=
                      l_curr_code;
                
                    :P48_INFO_CENTER_ID :=
                      l_info_center_id;
                
                  elsif l_paytype = 2 then
                    bil_patient_context.get_context(
                      p_patientno    => :P48_PATIENTNO,
                      p_invoice_date => sysdate,
                      o_context      => l_ctx
                    );
                
                    if nvl(
                         l_ctx.is_cash,
                         'N'
                       ) = 'Y'
                    then
                      raise_application_error(
                        -20887,
                        'This patient does not have an insurance/direct contract context.'
                      );
                    end if;
                
                    select curr_code,
                           the_info_center
                      into l_curr_code,
                           l_info_center_id
                      from price_list_master
                     where list_id = l_ctx.list_id;
                
                    :P48_COVERAGE_MODE :=
                      'CREDIT';
                
                    :P48_COVERAGE_TYPE :=
                      case
                        when l_ctx.coverage_type =
                             'DIRECT_CONTRACT'
                        then
                          'Direct Contract'
                        else
                          'Insurance'
                      end;
                
                    :P48_COMP_NAME :=
                      l_ctx.comp_name;
                
                    :P48_CLASS_NAME :=
                      l_ctx.class_name;
                
                    :P48_MAX_DEDUCTIBLE :=
                      case
                        when l_ctx.max_deductable is null then
                          null
                        else
                          to_char(
                            l_ctx.max_deductable,
                            'FM999G999G999G990D00'
                          )
                      end;
                
                    :P48_PLAN_CODE :=
                      l_ctx.plan_code;
                
                    :P48_LIST_ID :=
                      l_ctx.list_id;
                
                    :P48_CURR_CODE :=
                      l_curr_code;
                
                    :P48_INFO_CENTER_ID :=
                      l_info_center_id;
                
                  else
                    raise_application_error(
                      -20888,
                      'Coverage type is required.'
                    );
                  end if;
                
                exception
                  when no_data_found then
                    raise_application_error(
                      -20889,
                      'Unable to apply coverage context. Check cash company, price plan, and price list setup.'
                    );
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 31389032418549413
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                and :P48_MANUAL_PAYTYPE in ('1', '2')
                ```
        }
    )

    process apply-request-coverage-context (
        name: Apply Request Coverage Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_cash_comp_code companys.comp_code%type;
                  l_cash_comp_name companys.comp_name%type;
                  l_plan_code      price_plan_m.plan_code%type;
                  l_list_id        price_plan_m.list_id%type;
                  l_curr_code      price_list_master.curr_code%type;
                  l_info_center_id price_list_master.the_info_center%type;
                begin
                  if :P48_COVERAGE_MODE = 'CASH' then
                    l_cash_comp_code := ins_comp_util.get_cash_comp_code;
                
                    select get_price_plan(:G_INFO_CENTER_ID, l_cash_comp_code)
                      into l_plan_code
                      from dual;
                
                    select list_id
                      into l_list_id
                      from price_plan_m
                     where plan_code = l_plan_code;
                
                    select comp_name
                      into l_cash_comp_name
                      from companys
                     where comp_code = l_cash_comp_code;
                
                    select curr_code,
                           the_info_center
                      into l_curr_code,
                           l_info_center_id
                      from price_list_master
                     where list_id = l_list_id;
                
                    :P48_PAYTYPE := 1;
                
                    -- Temporary invoice context. Do not write these values to PATIENT.
                    :P48_PLAN_CODE := l_plan_code;
                    :P48_LIST_ID := l_list_id;
                
                    -- Existing Invoice Summary Card Items.
                    :P48_COVERAGE_TYPE  := 'Cash';
                    :P48_COMP_NAME      := l_cash_comp_name;
                    :P48_CLASS_NAME     := null;
                    :P48_MAX_DEDUCTIBLE := null;
                    :P48_CURR_CODE      := l_curr_code;
                    :P48_INFO_CENTER_ID := l_info_center_id;
                  elsif :P48_COVERAGE_MODE = 'CREDIT' then
                    :P48_PAYTYPE := 2;
                
                    /*
                      Keep the normal patient insurance context already loaded by the existing
                      Page 48 Load Patient Context process. Do not blank or overwrite
                      P48_COMP_NAME, P48_CLASS_NAME, P48_COVERAGE_TYPE, P48_LIST_ID, or
                      P48_PLAN_CODE here.
                    */
                  end if;
                exception
                  when no_data_found then
                    raise_application_error(
                      -20891,
                      'Unable to apply request coverage context for mode ' ||
                      :P48_COVERAGE_MODE ||
                      '. Check cash company, price plan, and price list setup.'
                    );
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 23988431555599350
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_SOURCE_MODE = 'REQUEST'
                and nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_COVERAGE_MODE in ('CASH', 'CREDIT')
                and :P48_PATIENTNO is not null
                and :P48_VISIT_UNIQUE is not null
                ```
        }
    )

    process build-locked-lines-collection-ajax (
        name: BUILD_LOCKED_LINES_COLLECTION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_totals bil_invoice_api.t_preview_totals;
                  l_result bil_import.t_import_result;
                  
                begin
                  bil_invoice_api.build_import_preview_collection(
                    p_source_mode     => :P48_SOURCE_MODE,
                    p_patientno       => :P48_PATIENTNO,
                    p_paytype         => :P48_PAYTYPE,
                    p_clinicid        => :P48_CLINICID,
                    p_visit_unique    => :P48_VISIT_UNIQUE,
                    p_app_id          => :APP_ID,
                    p_app_session_id  => :APP_SESSION,
                    p_app_user        => :APP_USER,
                    p_inv_date        => sysdate,
                    p_seed_serviceid  => :P48_SEED_SERVICEID,
                    p_final_disc      => nvl(apex_session_state.get_number('P48_FINALDISC'),0),
                    p_amount_1        => nvl(apex_session_state.get_number('P48_AMOUNT_1'),0),
                    p_amount_2        => nvl(apex_session_state.get_number('P48_AMOUNT_2'),0),
                    p_amount_1_auto   => nvl(:P48_AMOUNT_1_AUTO, 'Y'),
                    p_collection_name => bil_invoice_api.c_import_preview_collection,
                    p_docid           => :P48_DOCID,
                    p_new_visit_type  => :P48_NEW_VISIT_TYPE,
                    p_info_center_id  => :P48_INFO_CENTER_ID,
                    o_totals          => l_totals,
                    o_import_result   => l_result
                  );
                
                  apex_json.open_object;
                  apex_json.write('success', true);
                  apex_json.write('lineCount', l_totals.line_count);
                
                  apex_json.open_object('totals');
                  apex_json.write('gross', l_totals.total_gross);
                  apex_json.write('discount', l_totals.total_discount);
                  apex_json.write('net', l_totals.total_net);
                  apex_json.write('patPay', l_totals.pat_pay);
                  apex_json.write('compPay', l_totals.comp_pay);
                  apex_json.write('vatPat', l_totals.vat_total_pat);
                  apex_json.write('vatCo', l_totals.vat_total_co);
                  apex_json.write('amountDue', l_totals.cash_collected);
                  apex_json.write('amount1', l_totals.amount_1);
                  apex_json.write('amount2', l_totals.amount_2);
                  apex_json.write('remainingAmount', l_totals.remaining_amount);
                  apex_json.write('paymentStatus', l_totals.payment_status);
                  apex_json.close_object;
                
                  apex_json.close_object;
                  
                exception
                  when others then
                    apex_debug.error(
                      'BUILD_LOCKED_LINES_COLLECTION failed: %s',
                      sqlerrm
                    );
                
                    apex_json.open_object;
                    apex_json.write('success', false);
                    apex_json.write(
                      'message',
                      'Could not refresh invoice payment totals.'
                    );
                    apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 27776447346769127
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fnd_app_security.has_permission('BILLING_PATIENT_INVOICES_CREATE') = 'TRUE'
        }
    )

    process calculate-editable-invoice-preview (
        name: CALCULATE_EDITABLE_INVOICE_PREVIEW
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_values       apex_json.t_values;
                  l_line_count   pls_integer;
                  l_out_idx      pls_integer := 0;
                
                  l_header       bil_invoice_engine.t_header_input;
                
                  l_visible_lines       bil_invoice_engine.t_line_input_tab;
                  l_visible_client_ids  bil_invoice_api.t_client_id_tab;
                
                  l_full_lines          bil_invoice_engine.t_line_input_tab;
                  l_full_client_ids     bil_invoice_api.t_client_id_tab;
                
                  l_preview      bil_invoice_api.t_editable_preview_line_tab;
                  l_totals       bil_invoice_api.t_preview_totals;
                
                  function get_varchar2 (
                    p_path in varchar2,
                    p0     in number default null
                  ) return varchar2
                  is
                  begin
                    return apex_json.get_varchar2(
                             p_values => l_values,
                             p_path   => p_path,
                             p0       => p0
                           );
                  end get_varchar2;
                
                  function get_number (
                    p_path in varchar2,
                    p0     in number default null
                  ) return number
                  is
                  begin
                    return apex_json.get_number(
                             p_values => l_values,
                             p_path   => p_path,
                             p0       => p0
                           );
                  end get_number;
                
                  procedure write_num (
                    p_name  in varchar2,
                    p_value in number
                  )
                  is
                  begin
                    apex_json.write(
                      p_name,
                      nvl(p_value, 0)
                    );
                  end write_num;
                
                  procedure write_required_num (
                      p_name  in varchar2,
                      p_value in number
                    )
                    is
                    begin
                    apex_json.write(
                        p_name,
                        p_value
                    );
                    end write_required_num;
                
                  procedure assert_qty (
                    p_qty       in number,
                    p_serviceid in varchar2,
                    p_context   in varchar2
                  )
                  is
                  begin
                    if p_qty is null
                       or p_qty <= 0
                       or p_qty <> trunc(p_qty)
                    then
                      raise_application_error(
                        -20903,
                        'Quantity must be a positive whole number.'
                        || p_context
                        || ' '
                        || nvl(p_serviceid, 'Unknown')
                        || '.'
                      );
                    end if;
                  end assert_qty;
                
                  procedure add_visible_json_line (
                    p_json_index in pls_integer
                  )
                  is
                  begin
                    l_out_idx := l_out_idx + 1;
                
                    l_visible_client_ids(l_out_idx) :=
                      get_varchar2(
                        'lines[%d].clientId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).serviceid :=
                      get_varchar2(
                        'lines[%d].serviceId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).qty :=
                      get_number(
                        'lines[%d].qty',
                        p_json_index
                      );
                
                    /*
                     * Bundle parent rows are hidden from the IG.
                     * Visible bundle component rows still have SERVICEID.
                     */
                    assert_qty(
                      p_qty       => l_visible_lines(l_out_idx).qty,
                      p_serviceid => l_visible_lines(l_out_idx).serviceid,
                      p_context   => 'service'
                    );
                
                    l_visible_lines(l_out_idx).price_override :=
                      get_number(
                        'lines[%d].priceOverride',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).use_price_override :=
                      nvl(
                        get_varchar2(
                          'lines[%d].usePriceOverride',
                          p_json_index
                        ),
                        'N'
                      );
                
                    l_visible_lines(l_out_idx).discount_type :=
                      nvl(
                        get_varchar2(
                          'lines[%d].discountType',
                          p_json_index
                        ),
                        'N'
                      );
                
                    l_visible_lines(l_out_idx).disc :=
                      nvl(
                        get_number(
                          'lines[%d].disc',
                          p_json_index
                        ),
                        0
                      );
                
                    l_visible_lines(l_out_idx).my_disc :=
                      get_number(
                        'lines[%d].myDisc',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).teeth_no :=
                      get_varchar2(
                        'lines[%d].teethNo',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).tooth_surface :=
                      get_varchar2(
                        'lines[%d].toothSurface',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).teeth_no2 :=
                      get_varchar2(
                        'lines[%d].teethNo2',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).pat_serv_req_row_id :=
                      get_number(
                        'lines[%d].patServReqRowId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).approv_ref_no :=
                      get_varchar2(
                        'lines[%d].approvRefNo',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).claim_no :=
                      get_varchar2(
                        'lines[%d].claimNo',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).req_need_a :=
                      get_number(
                        'lines[%d].reqNeedA',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).req_a_status :=
                      get_number(
                        'lines[%d].reqAStatus',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_service_id :=
                      get_varchar2(
                        'lines[%d].packageServiceId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_instance_id :=
                      get_varchar2(
                        'lines[%d].packageInstanceId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_line_role :=
                      get_varchar2(
                        'lines[%d].packageLineRole',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_component_order :=
                      get_number(
                        'lines[%d].packageComponentOrder',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_parent_line_id :=
                      get_number(
                        'lines[%d].packageParentLineId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_pricing_method :=
                      get_varchar2(
                        'lines[%d].packagePricingMethod',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).package_definition_token :=
                      get_varchar2(
                        'lines[%d].packageDefinitionToken',
                        p_json_index
                      );  
                
                    l_visible_lines(l_out_idx).offer_id :=
                      get_number(
                        'lines[%d].offerId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_dtl_id :=
                      get_number(
                        'lines[%d].offerDtlId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_type :=
                      get_number(
                        'lines[%d].offerType',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_instance_id :=
                      get_varchar2(
                        'lines[%d].offerInstanceId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_line_role :=
                      get_varchar2(
                        'lines[%d].offerLineRole',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_parent_line_id :=
                      get_number(
                        'lines[%d].offerParentLineId',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_price_applied :=
                      get_number(
                        'lines[%d].offerPriceApplied',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_dis_applied :=
                      get_number(
                        'lines[%d].offerDisApplied',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_name_snapshot :=
                      get_varchar2(
                        'lines[%d].offerNameSnapshot',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_object_version_number :=
                      get_number(
                        'lines[%d].offerObjectVersionNumber',
                        p_json_index
                      );
                
                    l_visible_lines(l_out_idx).offer_dtl_object_version_number :=
                      get_number(
                        'lines[%d].offerDtlObjectVersionNumber',
                        p_json_index
                      );
                  end add_visible_json_line;
                
                begin
                  if fnd_app_security.has_permission(
                       'BILLING_PATIENT_INVOICES_CREATE'
                     ) <> 'TRUE'
                  then
                    raise_application_error(
                      -20901,
                      'You are not authorized to calculate invoice totals.'
                    );
                  end if;
                
                  if apex_application.g_x01 is null then
                    raise_application_error(
                      -20902,
                      'Invoice preview request is empty.'
                    );
                  end if;
                
                  apex_json.parse(
                    p_values => l_values,
                    p_source => apex_application.g_x01
                  );
                
                  /* ------------------------------------------------------------------------
                   * Header context
                   * ---------------------------------------------------------------------- */
                
                  l_header.patientno :=
                    get_varchar2(
                      'header.patientno'
                    );
                
                  /*
                   * Page 48 currently uses system date for the editable preview calculation.
                   */
                  l_header.invdate :=
                    sysdate;
                
                  l_header.paytype :=
                    get_number(
                      'header.paytype'
                    );
                
                  l_header.clinicid :=
                    get_number(
                      'header.clinicid'
                    );
                
                  l_header.docid :=
                    get_number(
                      'header.docid'
                    );
                
                  l_header.curr_code :=
                    get_varchar2(
                      'header.currCode'
                    );
                
                  l_header.finaldisc :=
                    nvl(
                      get_number(
                        'header.finalDisc'
                      ),
                      0
                    );
                
                  l_header.finaldisc_perc :=
                    null;
                
                  l_header.user_no :=
                    :G_USER_ID;
                
                  l_header.info_center_id :=
                    :P48_INFO_CENTER_ID;
                
                  /* ------------------------------------------------------------------------
                   * Parse visible IG lines only.
                   *
                   * With Option B:
                   * - bundled-offer parent row is hidden from the IG;
                   * - visible component rows are still submitted;
                   * - helper expands full occurrence from BIL_INV_DRAFT_LINES.
                   * ---------------------------------------------------------------------- */
                
                  l_line_count :=
                    nvl(
                      apex_json.get_count(
                        p_values => l_values,
                        p_path   => 'lines'
                      ),
                      0
                    );
                
                  for i in 1 .. l_line_count loop
                    add_visible_json_line(
                      p_json_index => i
                    );
                  end loop;
                
                  /* ------------------------------------------------------------------------
                   * Expand bundled offers from draft.
                   *
                   * This adds hidden bundle parent rows back for the engine while preserving
                   * visible component client IDs for the AJAX response.
                   * ---------------------------------------------------------------------- */
                
                    bil_invoice_api.expand_bundled_offer_ig_lines(
                        p_visible_lines      => l_visible_lines,
                        p_visible_client_ids => l_visible_client_ids,
                        o_full_lines         => l_full_lines,
                        o_full_client_ids    => l_full_client_ids
                        );
                
                  /* ------------------------------------------------------------------------
                   * Authoritative calculation
                   * ---------------------------------------------------------------------- */
                
                  bil_invoice_api.calculate_editable_invoice_preview(
                    p_header        => l_header,
                    p_lines         => l_full_lines,
                    p_client_ids    => l_full_client_ids,
                    p_amount_1      => get_number(
                                         'payment.amount1'
                                       ),
                    p_amount_2      => get_number(
                                         'payment.amount2'
                                       ),
                    p_amount_1_auto => nvl(
                                         get_varchar2(
                                           'payment.amount1Auto'
                                         ),
                                         'Y'
                                       ),
                    o_lines         => l_preview,
                    o_totals        => l_totals
                  );
                
                  /* ------------------------------------------------------------------------
                   * JSON response
                   * ---------------------------------------------------------------------- */
                
                  apex_json.open_object;
                
                  apex_json.write(
                    'success',
                    true
                  );
                
                  apex_json.open_array(
                    'lines'
                  );
                
                  declare
                    l_idx pls_integer;
                  begin
                    l_idx :=
                      l_preview.first;
                
                    while l_idx is not null loop
                      /*
                       * Hidden bundle parent has no client_id.
                       * Do not send it back to the IG.
                       */
                      if l_preview(l_idx).client_id is not null
                        or (
                            nvl(l_preview(l_idx).offer_type, -1) = 0
                            and upper(nvl(l_preview(l_idx).offer_line_role, '~')) = 'COMPONENT'
                            )
                        then
                        apex_json.open_object;
                
                        apex_json.write(
                          'clientId',
                          l_preview(l_idx).client_id
                        );
                
                        apex_json.write(
                          'lineNo',
                          l_preview(l_idx).line_no
                        );
                
                        apex_json.write(
                          'serviceId',
                          l_preview(l_idx).serviceid
                        );
                
                        apex_json.write(
                          'serviceDesc',
                          l_preview(l_idx).servicedesc
                        );
                
                        apex_json.write(
                          'categoryId',
                          l_preview(l_idx).catid
                        );
                
                        apex_json.write(
                          'listId',
                          l_preview(l_idx).list_id
                        );
                
                        apex_json.write(
                          'currencyCode',
                          l_preview(l_idx).curr_code
                        );
                
                        write_num(
                          'qty',
                          l_preview(l_idx).qty
                        );
                
                        write_num(
                          'unitPrice',
                          l_preview(l_idx).price
                        );
                
                        /*
                         * Backward-compatible alias.
                         */
                        write_num(
                          'price',
                          l_preview(l_idx).price
                        );
                
                        write_required_num(
                          'grossAmount',
                          l_preview(l_idx).my_price
                        );
                
                        write_num(
                          'planDiscountPct',
                          l_preview(l_idx).plan_discount_pct
                        );
                
                        write_num(
                          'planDiscountAmount',
                          l_preview(l_idx).plan_discount_amount
                        );
                
                        apex_json.write(
                          'manualDiscountType',
                          l_preview(l_idx).manual_discount_type
                        );
                
                        write_num(
                          'manualDiscountPct',
                          l_preview(l_idx).manual_discount_pct
                        );
                
                        write_num(
                          'manualDiscountAmount',
                          l_preview(l_idx).manual_discount_amount
                        );
                
                        apex_json.write(
                          'discountSource',
                          l_preview(l_idx).discount_source
                        );
                
                        write_num(
                          'effectiveDiscountPct',
                          l_preview(l_idx).disc
                        );
                
                        write_required_num(
                          'totalDiscountAmount',
                          l_preview(l_idx).my_disc
                        );
                
                        write_required_num(
                          'netAmount',
                          l_preview(l_idx).my_net
                        );
                
                        write_required_num(
                          'patientShare',
                          l_preview(l_idx).the_pay
                        );
                
                        write_required_num(
                          'providerShare',
                          l_preview(l_idx).the_comp
                        );
                
                        write_num(
                          'vatRate',
                          l_preview(l_idx).vat_rate
                        );
                
                        write_required_num(
                          'patientVat',
                          l_preview(l_idx).vat_val_pat
                        );
                
                        write_required_num(
                          'providerVat',
                          l_preview(l_idx).vat_val_co
                        );
                
                        write_num(
                          'patientVatExemptAmount',
                          l_preview(l_idx).vat_val_pat_ex
                        );
                
                        write_num(
                          'patientVatExempt',
                          l_preview(l_idx).vat_val_pat_ex
                        );
                
                        apex_json.write(
                          'reqNeedA',
                          l_preview(l_idx).req_need_a
                        );
                
                        apex_json.write(
                          'reqAStatus',
                          l_preview(l_idx).req_a_status
                        );
                
                        apex_json.write(
                          'allowManualDiscount',
                          l_preview(l_idx).allow_manual_discount
                        );
                
                        apex_json.write(
                          'allowPriceOverride',
                          l_preview(l_idx).allow_price_override
                        );
                
                        apex_json.write(
                          'packageServiceId',
                          l_preview(l_idx).package_service_id
                        );
                
                        apex_json.write(
                          'packageInstanceId',
                          l_preview(l_idx).package_instance_id
                        );
                
                        apex_json.write(
                          'packageLineRole',
                          l_preview(l_idx).package_line_role
                        );
                
                        apex_json.write(
                          'packageComponentOrder',
                          l_preview(l_idx).package_component_order
                        );
                
                        apex_json.write(
                          'packageParentLineId',
                          l_preview(l_idx).package_parent_line_id
                        );
                
                        apex_json.write(
                          'packagePricingMethod',
                          l_preview(l_idx).package_pricing_method
                        );
                
                        apex_json.write(
                          'packageDefinitionToken',
                          l_preview(l_idx).package_definition_token
                        );
                
                        apex_json.write(
                          'offerId',
                          l_preview(l_idx).offer_id
                        );
                
                        apex_json.write(
                          'offerDtlId',
                          l_preview(l_idx).offer_dtl_id
                        );
                
                        apex_json.write(
                          'offerType',
                          l_preview(l_idx).offer_type
                        );
                
                        apex_json.write(
                          'offerInstanceId',
                          l_preview(l_idx).offer_instance_id
                        );
                
                        apex_json.write(
                          'offerLineRole',
                          l_preview(l_idx).offer_line_role
                        );
                
                        apex_json.write(
                          'offerParentLineId',
                          l_preview(l_idx).offer_parent_line_id
                        );
                
                        apex_json.write(
                          'offerPriceApplied',
                          l_preview(l_idx).offer_price_applied
                        );
                
                        apex_json.write(
                          'offerDisApplied',
                          l_preview(l_idx).offer_dis_applied
                        );
                
                        apex_json.write(
                          'offerNameSnapshot',
                          l_preview(l_idx).offer_name_snapshot
                        );
                
                        apex_json.write(
                          'offerObjectVersionNumber',
                          l_preview(l_idx).offer_object_version_number
                        );
                
                        apex_json.write(
                          'offerDtlObjectVersionNumber',
                          l_preview(l_idx).offer_dtl_object_version_number
                        );
                
                        apex_json.close_object;
                      end if;
                
                      l_idx :=
                        l_preview.next(
                          l_idx
                        );
                    end loop;
                  end;
                
                  apex_json.close_array;
                
                  /* ------------------------------------------------------------------------
                   * Totals
                   * ---------------------------------------------------------------------- */
                
                  apex_json.open_object(
                    'totals'
                  );
                
                  write_num(
                    'lineCount',
                    l_totals.line_count
                  );
                
                  write_required_num(
