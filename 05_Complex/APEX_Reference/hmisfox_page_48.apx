page 48 (
    name: Patient Invoice
    alias: PATIENT-INVOICE
    title: Patient Invoice
    pageGroup: @billing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: [
            #APP_FILES#page48-function-and-global-variable-declaration.js
            #APP_FILES#page48-invoice-preview.js
            #APP_FILES#page48-invoice-services-init.js
        ]
    }
    css {
        fileUrls: #APP_FILES#badges.css
        inline:
            ```css
            /* =========================================================
               Invoice Summary Card Container
               ========================================================= */
            
            .inv-card {
              border-radius: 16px;
              background: #fff;
              box-shadow:
                0 2px 8px rgba(15, 23, 42, 0.07),
                0 1px 2px rgba(15, 23, 42, 0.04);
              overflow: hidden;
            }
            
            
            /* =========================================================
               Invoice Summary Card Header
               ========================================================= */
            
            .inv-card__head {
              padding: 14px 18px 13px;
              display: flex;
              align-items: flex-start;
              justify-content: space-between;
              gap: 12px;
              border-bottom: 1px solid #f1f5f9;
            }
            
            .inv-card__head-left {
              min-width: 0;
            }
            
            .inv-card__kicker {
              font-size: 12px;
              font-weight: 500;
              letter-spacing: .08em;
              text-transform: uppercase;
              color: var(--ut-component-text-muted-color, #64748b);
              margin: 0 0 4px;
            }
            
            .inv-card__name {
              margin: 0;  
              font-size: 16px;
              font-weight: 600;
              color: var(--ut-component-text-title-color, #0f172a);
              white-space: normal;
              overflow: visible;
              text-overflow: clip;
              overflow-wrap: anywhere;
              line-height: 1.3;
            }
            
            .inv-field__help {
              margin: 3px 0 0;
              font-size: 9px;
              line-height: 1.25;
              font-weight: 400;
              color: var(--ut-component-text-muted-color, #475569);
            }
            
            /* =========================================================
               Invoice Summary Card Conditional Field Visibility
               ========================================================= */
            
            .inv-card[data-payer-type="1"] .inv-field--payer,
            .inv-card[data-payer-type="1"] .inv-field--class,
            .inv-card[data-payer-type="1"] .inv-field--deductible,
            .inv-card[data-class-name=""] .inv-field--class,
            .inv-card[data-deductible-cap=""] .inv-field--deductible,
            .inv-card[data-mode="VIEW"] .inv-field--deductible {
              display: none;
            }
            
            
            /* =========================================================
               Invoice Summary Card Mode Badge
               ========================================================= */
            
            .inv-card__badge {
              flex-shrink: 0;
              margin-top: 2px;
              letter-spacing: .03em;
            }
            
            .inv-card__badge[data-mode="CREATE"] {
              --badge-light-background: #dcfce7;
              --badge-light-foreground: #166534;
            }
            
            .inv-card__badge[data-mode="VIEW"] {
              --badge-light-background: #f1f5f9;
              --badge-light-foreground: #334155;
            }
            
            
            /* =========================================================
               Invoice Summary Card Body Grid
               ========================================================= */
            
            .inv-card__body {
              margin: 0;
              padding: 12px;
              display: grid;
              grid-template-columns: repeat(4, minmax(0, 1fr));
              gap: 7px;
            }
            
            .inv-field {
              padding: 9px 11px;
              border-radius: 10px;
              background: #f8fafc;
              min-width: 0;
            }
            
            .inv-field--wide {
              grid-column: span 2;
            }
            
            .inv-field__label {
              display: block;
              margin: 0 0 3px;
              font-size: 11px;
              font-weight: 500;
              letter-spacing: .06em;
              text-transform: uppercase;
              color: var(--ut-component-text-muted-color, #64748b);
              margin-bottom: 3px;
            }
            
            .inv-field__value {
              display: block;
              margin: 0;
              font-size: 13px;
              font-weight: 500;
              color: #1e293b;
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
              min-height: 18px;
            }
            
            .inv-field--payer .inv-field__value,
            .inv-field--class .inv-field__value {
              white-space: normal;
              overflow: visible;
              text-overflow: clip;
              overflow-wrap: anywhere;
              line-height: 1.3;
            }
            
            
            /* =========================================================
               Invoice Summary Card Responsive Layout
               ========================================================= */
            
            @media (max-width: 640px) {
              .inv-card__head {
                flex-direction: column;
              }
            
              .inv-card__body {
                grid-template-columns: repeat(2, minmax(0, 1fr));
              }
            
              .inv-field--wide {
                grid-column: span 2;
              }
            }
            
            @media (max-width: 400px) {
              .inv-card__body {
                grid-template-columns: 1fr;
              }
            
              .inv-field--wide {
                grid-column: span 1;
              }
            }
            
            
            /* =========================================================
               Display Only Item Alignment
               Right-aligns Display Only page items using display-right class
               ========================================================= */
            
            .display-right.apex-item-display-only,
            .display-right.display_only,
            .display-right .apex-item-display-only,
            .display-right .display_only {
              display: block;
              width: 100%;
              text-align: right;
            }
            
            
            /* =========================================================
               Invoice Context Equal Height Layout
               Makes the Invoice Summary Card and Invoice Entry regions stretch
               to the same height inside the parent Static Content region
               ========================================================= */
            
            #invoice_context > .container > .row,
            #invoice_context .t-Region-body > .container > .row {
              display: flex;
              align-items: stretch;
            }
            
            
            /* =========================================================
               Invoice Context Grid Column Stretch
               Makes the APEX grid columns behave like stretchable flex columns
               ========================================================= */
            
            #invoice_context > .container > .row > [class*="col-"],
            #invoice_context .t-Region-body > .container > .row > [class*="col-"] {
              display: flex;
            }
            
            
            /* =========================================================
               Invoice Context Child Region Stretch
               Makes child regions fill the full height of their grid columns
               ========================================================= */
            
            #invoice_context > .container > .row > [class*="col-"] > *,
            #invoice_context .t-Region-body > .container > .row > [class*="col-"] > * {
              width: 100%;
              flex: 1 1 auto;
            }
            
            
            /* =========================================================
               Invoice Entry Region Height
               Makes the Invoice Entry region fill the stretched height
               ========================================================= */
            
            #invoice_entry,
            #invoice_entry .t-Region,
            #invoice_entry .t-Region-bodyWrap {
              height: 100%;
            }
            
            
            /* =========================================================
               Invoice Entry Vertical Centering
               Centers the Invoice Entry page items vertically inside the card
               ========================================================= */
            
            #invoice_entry .t-Region-body {
              height: 100%;
              display: flex;
              align-items: center;
            }
            
            #invoice_entry .t-Region-body > .container {
              width: 100%;
            }
            
            /* =========================================================
               Invoice Totals
               Keeps totals compact and aligns the group to the right
               ========================================================= */
               
            #invoice_totals .t-Region-body > .container > .row {
              display: flex;
              flex-wrap: wrap;
              justify-content: flex-end;
              align-items: flex-start;
            }
            
            #invoice_totals .t-Form-fieldContainer {
              margin-block-end: 0;
            }
            
            /* =========================================================
               Page 48 Invoice Services — Compact IG Headers
               ========================================================= */
            
            #invoice_services .a-GV-headerLabel {
              white-space: normal;
              line-height: 1.1;
              text-align: center;
              overflow: visible;
              text-overflow: clip;
            }
            
            #invoice_services .a-GV-header {
              height: auto;
              min-height: 42px;
              vertical-align: middle;
            }
            
            /* Keep numeric cells compact. */
            #invoice_services .a-GV-cell {
              padding-left: 5px;
              padding-right: 5px;
            }
            
            /* Service remains readable but does not consume excessive width. */
            #invoice_services td[headers*="SERVICEID"],
            #invoice_services th[data-idx*="SERVICEID"] {
              min-width: 180px;
            }
            ```
    }
    security {
        authorizationScheme: @has-permission
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region container (
        name: Container
        type: staticContent
        layout {
            sequence: 60
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--hiddenOverflow
            ]
        }
    )

    region hidden-items (
        name: Hidden Items
        type: staticContent
        layout {
            sequence: 10
            slot: regionBody
        }
    )

    region import-offer (
        name: Add Bundled Offer
        type: staticContent
        layout {
            sequence: 120
            slot: regionBody
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size600x400
            ]
        }
        advanced {
            htmlDomId: import_offer_dlg
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                and :P48_PAYTYPE = 1
                ```
        }
    )

    region import-package (
        name: Import Package
        type: staticContent
        layout {
            sequence: 110
            slot: regionBody
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: import_package_dlg
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                ```
        }
    )

    region invoice-context (
        name: Invoice Context
