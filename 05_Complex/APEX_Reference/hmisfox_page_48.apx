            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: invoice_entry
        }
        readOnly {
            type: item=value
            item: P48_MODE
            value: VIEW
        }
    )

    region invoice-lock (
