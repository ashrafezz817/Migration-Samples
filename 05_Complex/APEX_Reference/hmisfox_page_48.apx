    process save-invoice (
        name: Create Invoice
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                    declare
                  c_import_preview_collection constant varchar2(30) := bil_invoice_api.c_import_preview_collection;
                
                  l_open_print varchar2(1) :=
                    case
                      when apex_application.g_request = 'CREATE_INVOICE_AND_PRINT' then
                        'Y'
                      else
                        'N'
                    end;
                
                  l_header           bil_invoice_engine.t_header_input;
                  l_lines            bil_invoice_engine.t_line_input_tab;
                  l_invoice_datetime t_inv.invdate%type := sysdate;
                  l_idx              pls_integer := 0;
                  l_result           bil_invoice_api.t_full_invoice_result;
                  l_amount_1         t_inv.amount_1%type;
                  l_amount_2         t_inv.amount_2%type;
                  l_preview_totals   bil_invoice_api.t_preview_totals;
                  l_import_result    bil_import.t_import_result;
                  l_source_mode      varchar2(30) := upper(trim(:P48_SOURCE_MODE));
                
                  l_full_lines         bil_invoice_engine.t_line_input_tab;
                  l_visible_client_ids bil_invoice_api.t_client_id_tab;
                  l_full_client_ids    bil_invoice_api.t_client_id_tab;
                
                  l_final_preview_lines  bil_invoice_api.t_editable_preview_line_tab;
                  l_final_preview_totals bil_invoice_api.t_preview_totals;
                
                  function item_value (
                    p_item_name in varchar2
                  ) return varchar2
                  is
                  begin
                    return apex_util.get_session_state(p_item_name);
                  end item_value;
                
                    function item_num (
                      p_item_name in varchar2
                    ) return number
                    is
                    begin
                      return apex_session_state.get_number(
                        p_item_name
                      );
                    end item_num;
                
                  procedure rebuild_locked_lines
                  is
                  begin
                    /*
                     * Manual invoices use BIL_INV_DRAFT_LINES and do not need
                     * the import preview collection.
                     */
                    if nvl(l_source_mode, 'MANUAL')
                         not in ('NEW_VISIT', 'REQUEST')
                    then
                      return;
                    end if;
                
                    /*
                     * Recreate the collection from the current database state.
                     * This replaces the potentially stale preview created when
                     * Page 48 was originally rendered.
                     */
                    bil_invoice_api.build_import_preview_collection(
                      p_source_mode       => l_source_mode,
                      p_patientno         => :P48_PATIENTNO,
                      p_paytype           => :P48_PAYTYPE,
                      p_clinicid          => :P48_CLINICID,
                      p_visit_unique      => :P48_VISIT_UNIQUE,
                      p_app_id            => :APP_ID,
                      p_app_session_id    => :APP_SESSION,
                      p_app_user          => :APP_USER,
                      p_inv_date          => l_invoice_datetime,
                      p_seed_serviceid    => :P48_SEED_SERVICEID,
                      p_final_disc        => nvl(item_num('P48_FINALDISC'), 0),
                      p_amount_1          => nvl(item_num('P48_AMOUNT_1'), 0),
                      p_amount_2          => nvl(item_num('P48_AMOUNT_2'), 0),
                      p_amount_1_auto     => nvl(:P48_AMOUNT_1_AUTO, 'Y'),
                      p_collection_name   => c_import_preview_collection,
                      p_docid           => :P48_DOCID,
                      p_new_visit_type  => :P48_NEW_VISIT_TYPE,
                      p_info_center_id  => :P48_INFO_CENTER_ID,
                      o_totals            => l_preview_totals,
                      o_import_result     => l_import_result
                    );
                
                    if nvl(l_preview_totals.line_count, 0) = 0 then
                      raise_application_error(
                        -20898,
                        case l_source_mode
                          when 'REQUEST' then
                            'The selected requested services are no longer available for invoicing.'
                          else
                            'The new visit service is no longer available for invoicing.'
                        end
                      );
                    end if;
                
                    /*
                     * The source data or invoice date may have changed since the
                     * original preview. Use the newly calculated totals and payment.
                     */
                    :P48_TOTAL_GROSS      := l_preview_totals.total_gross;
                    :P48_TOTAL_DISCOUNT   := l_preview_totals.total_discount;
                    :P48_TOTAL_NET        := l_preview_totals.total_net;
                    :P48_PAT_PAY          := l_preview_totals.pat_pay;
                    :P48_COMP_PAY         := l_preview_totals.comp_pay;
                    :P48_VAT_TOTAL_PAT    := l_preview_totals.vat_total_pat;
                    :P48_VAT_TOTAL_CO     := l_preview_totals.vat_total_co;
                    :P48_AMOUNT_DUE   := l_preview_totals.cash_collected;
                    :P48_AMOUNT_1         := l_preview_totals.amount_1;
                    :P48_AMOUNT_2         := l_preview_totals.amount_2;
                    :P48_REMAINING_AMOUNT := l_preview_totals.remaining_amount;
                    :P48_PAYMENT_STATUS   := l_preview_totals.payment_status;
                  end rebuild_locked_lines;
                
                  procedure build_header
                  is
                  begin
                    l_amount_1 :=  nvl(item_num('P48_AMOUNT_1'),0);
                    l_amount_2 :=  nvl(item_num('P48_AMOUNT_2'),0);
                
                    l_header.patientno         := :P48_PATIENTNO;
                    l_header.invdate           := l_invoice_datetime;
                    l_header.invtypeid         := 1;
                    l_header.paytype           := :P48_PAYTYPE;
                    l_header.sub_paytype       := item_num('P48_SUB_PAYTYPE');
                    l_header.sub_paytype2      := item_num('P48_SUB_PAYTYPE2');
                    l_header.clinicid          := :P48_CLINICID;
                    l_header.docid             := :P48_DOCID;
                    l_header.curr_code         := item_value('P48_CURR_CODE');
                    l_header.pre_authorization := null;
                    l_header.claim_no          := null;
                    l_header.claim_flag        := null;
                    l_header.note_no           := null;
                    l_header.finaldisc_perc    := null;
                    l_header.finaldisc         := nvl(item_num('P48_FINALDISC'),0);
                    l_header.amount_1          := l_amount_1;
                    l_header.amount_2          := l_amount_2;
                    l_header.add_to_list       := item_num('P48_ADD_TO_LIST');
                    l_header.user_no           := item_num('G_USER_ID');
                    l_header.info_center_id    := item_num('P48_INFO_CENTER_ID');
                  end build_header;
                
                procedure build_lines
                is
                begin
                  l_lines.delete;
                  l_idx := 0;
                
                  /* =========================================================================
                     * Locked REQUEST / NEW_VISIT lines.
                     *
                     * These rows come from the authoritative backend rebuild and may include
                     * normal services or expanded package parent/component lines.
                   * ======================================================================= */
                  if l_source_mode in (
                       'NEW_VISIT',
                       'REQUEST'
                     )
                  then
                    if not apex_collection.collection_exists(
                             c_import_preview_collection
                           )
                    then
                      raise_application_error(
                        -20898,
                        'No locked invoice lines were available to save.'
                      );
                    end if;
                
                    for r in (
                      select seq_id,
                             c001 source_type,
                             c002 source_id,
                             c003 serviceid,
                             c004 discount_type,
                             c005 has_price_override,
                             c006 teeth_no,
                             c007 tooth_surface,
                             c008 teeth_no2,
                             c009 approv_ref_no,
                             c010 claim_no,
                             c011 req_need_a,
                             c012 req_a_status,
                             c013 pat_serv_req_row_id,
                             c014 package_service_id,
                             c015 package_instance_id,
                             c016 package_line_role,
                             to_number(c017) package_component_order,
                             to_number(c018) package_parent_line_id,
                             c019 package_pricing_method,
                             c040 package_definition_token,
                             n001 qty,
                             n002 disc,
                             n003 my_disc,
                             n004 price_override,
                             n005 approv_validity,
                             d001 approv_date
                        from apex_collections
                       where collection_name =
                             c_import_preview_collection
                       order by seq_id
                    ) loop
                      /*
                       * Preview and final create must use the same exact quantity.
                       * Never silently replace a missing quantity with one.
                       */
                      if r.qty is null
                         or r.qty <= 0
                         or r.qty <> trunc(r.qty)
                      then
                        raise_application_error(
                          -20903,
                          'Quantity must be a positive whole number '
                          || nvl(
                               r.serviceid,
                               'Unknown'
                             )
                          || '.'
                        );
                      end if;
                
                      l_idx :=
                        l_idx + 1;
                
                      l_lines(l_idx).serviceid :=
                        r.serviceid;
                
                      l_lines(l_idx).qty :=
                        r.qty;
                
                      l_lines(l_idx).price_override :=
                        r.price_override;
                
                      l_lines(l_idx).use_price_override :=
                        nvl(
                          r.has_price_override,
                          'N'
                        );
                
                      /*
                       * Manual discount inputs only.
                       *
                       * Plan discount and effective discount are calculated by the backend.
                       */
                      l_lines(l_idx).discount_type :=
                        nvl(
                          r.discount_type,
                          'N'
                        );
                
                      l_lines(l_idx).disc :=
                        nvl(
                          r.disc,
                          0
                        );
                
                      l_lines(l_idx).my_disc :=
                        r.my_disc;
                
                      l_lines(l_idx).teeth_no :=
                        r.teeth_no;
                
                      l_lines(l_idx).tooth_surface :=
                        r.tooth_surface;
                
                      l_lines(l_idx).teeth_no2 :=
                        r.teeth_no2;
                
                      l_lines(l_idx).pat_serv_req_row_id :=
                        to_number(
                          r.pat_serv_req_row_id
                        );
                
                      l_lines(l_idx).approv_date :=
                        r.approv_date;
                
                      l_lines(l_idx).approv_validity :=
                        r.approv_validity;
                
                      l_lines(l_idx).approv_ref_no :=
                        r.approv_ref_no;
                
                      l_lines(l_idx).claim_no :=
                        r.claim_no;
                
                      l_lines(l_idx).req_need_a :=
                        to_number(
                          r.req_need_a
                        );
                
                      l_lines(l_idx).req_a_status :=
                        to_number(
                          r.req_a_status
                        );
                
                      /*
                       * Package metadata was generated by the authoritative locked-source
                       * backend rebuild. The invoice engine revalidates it after locking the
                       * physical request and rebuilds request packages again before insert.
                       */
                      l_lines(l_idx).package_service_id :=
                        r.package_service_id;
                
                      l_lines(l_idx).package_instance_id :=
                        r.package_instance_id;
                
                      l_lines(l_idx).package_line_role :=
                        r.package_line_role;
                
                      l_lines(l_idx).package_component_order :=
                        r.package_component_order;
                
                      l_lines(l_idx).package_parent_line_id :=
                        r.package_parent_line_id;
                
                      l_lines(l_idx).package_pricing_method :=
                        r.package_pricing_method;
                
                      l_lines(l_idx).package_definition_token :=
                        r.package_definition_token;  
                    end loop;
                
                    if l_idx = 0 then
                      raise_application_error(
                        -20898,
                        'No locked invoice lines were available to save.'
                      );
                    end if;
                
                  /* =========================================================================
                   * Manual IG lines, including package and offer imports
                   *
                   * The Interactive Grid DML process runs before this process and persists
                   * the current browser model into BIL_INV_DRAFT_LINES.
                   * ======================================================================= */
                  else
                    for r in (
                      select d.line_id,
                             d.seq_no,
                             d.source_type,
                             d.source_id,
                             d.serviceid,
                             d.qty,
                
                             /*
                              * Package pricing is never represented as a price override.
                              */
                             case
                               when d.package_service_id is not null
                               then null
                               else d.price_override
                             end price_override,
                
                             case
                               when d.package_service_id is not null
                               then 'N'
                               else nvl(
                                      d.use_price_override,
                                      'N'
                                    )
                             end use_price_override,
                
                             /*
                              * These are manual inputs only.
                              */
                             nvl(
                               d.discount_type,
                               'N'
                             ) discount_type,
                
                             d.disc,
                             d.my_disc,
                             d.teeth_no,
                             d.tooth_surface,
                             d.teeth_no2,
                             d.pat_serv_req_row_id,
                             d.approv_date,
                             d.approv_validity,
                             d.approv_ref_no,
                             d.claim_no,
                             d.req_need_a,
                             d.req_a_status,
                
                             /*
                              * Persistent package metadata from BIL_INV_DRAFT_LINES.
                              */
                             d.package_service_id,
                             d.package_instance_id,
                             d.package_line_role,
                             d.package_component_order,
                             d.package_parent_line_id,
                             d.package_definition_token,
                
                             /*
                              * PACKAGE_PRICING_METHOD is a query-only IG value and is not
                              * stored in BIL_INV_DRAFT_LINES.
                              *
                              * Resolve it from the authoritative package parent service.
                              */
                             case
                               when d.package_service_id is not null
                               then (
                                 select max(
                                          s.package_pricing_method
                                        )
                                   from services s
                                  where s.serviceid =
                                        d.package_service_id
                                    and s.list_id =
                                        :P48_LIST_ID
                               )
                             end package_pricing_method,
                
                             /*
                              * Persistent bundled offer metadata from BIL_INV_DRAFT_LINES.
                              */
                
                             d.offer_id,
                             d.offer_dtl_id,
                             d.offer_type,
                             d.offer_instance_id,
                             d.offer_line_role,
                             d.offer_parent_line_id,
                             d.offer_price_applied,
                             d.offer_dis_applied,
                             d.offer_name_snapshot,
                             d.offer_object_version_number,
                             d.offer_dtl_object_version_number
                
                        from bil_inv_draft_lines d
                       where d.app_session_id =
                             :APP_SESSION
                         and d.draft_id =
                             :P48_DRAFT_ID
                         and not (
                            nvl(d.offer_type, -1) = 0
                            and nvl(d.offer_line_role, '~') = 'PARENT'
                            )    
                       order by nvl(
                                  d.seq_no,
                                  d.line_id
                                )
                    ) loop
                      /*
                       * Use exactly the quantity stored by the IG.
                       */
                      if r.qty is null
                         or r.qty <= 0
                         or r.qty <> trunc(r.qty)
                      then
                        raise_application_error(
                          -20903,
                          'Quantity must be a positive whole number for service '
                          || nvl(
                               r.serviceid,
                               'Unknown'
                             )
                          || '.'
                        );
                      end if;
                
                      /*
                       * Every package row must resolve its configured pricing method.
                       */
                      if r.package_service_id is not null
                         and r.package_pricing_method is null
                      then
                        raise_application_error(
                          -20904,
                          'Package pricing method could not be resolved for package '
                          || r.package_service_id
                          || '.'
                        );
                      end if;
                
                      /*
                       * Package rows must carry a stable package occurrence identifier.
                       */
                      if r.package_service_id is not null
                         and r.package_instance_id is null
                      then
                        raise_application_error(
                          -20905,
                          'Package instance ID is missing for package '
                          || r.package_service_id
                          || '.'
                        );
                      end if;
                
                      /*
                       * Package rows must explicitly identify parent/component role.
                       */
                      if r.package_service_id is not null
                         and r.package_line_role is null
                      then
                        raise_application_error(
                          -20906,
                          'Package line role is missing for package '
                          || r.package_service_id
                          || '.'
                        );
                      end if;
                
                      l_idx :=
                        l_idx + 1;
                
                      l_lines(l_idx).serviceid :=
                        r.serviceid;
                
                      l_lines(l_idx).qty :=
                        r.qty;
                
                      l_lines(l_idx).price_override :=
                        r.price_override;
                
                      l_lines(l_idx).use_price_override :=
                        r.use_price_override;
                
                      /*
                       * Manual discount inputs only.
                       *
                       * Do not copy:
                       *
                       * PLAN_DISCOUNT_PCT
                       * PLAN_DISCOUNT_AMOUNT
                       * EFFECTIVE_DISCOUNT_PCT
                       * TOTAL_DISCOUNT_AMOUNT
                       *
                       * into the engine input.
                       */
                      l_lines(l_idx).discount_type :=
                        r.discount_type;
                
                      l_lines(l_idx).disc :=
                        nvl(
                          r.disc,
                          0
                        );
                
                      l_lines(l_idx).my_disc :=
                        r.my_disc;
                
                      l_lines(l_idx).teeth_no :=
                        r.teeth_no;
                
                      l_lines(l_idx).tooth_surface :=
                        r.tooth_surface;
                
                      l_lines(l_idx).teeth_no2 :=
                        r.teeth_no2;
                
                      l_lines(l_idx).pat_serv_req_row_id :=
                        r.pat_serv_req_row_id;
                
                      l_lines(l_idx).approv_date :=
                        r.approv_date;
                
                      l_lines(l_idx).approv_validity :=
                        r.approv_validity;
                
                      l_lines(l_idx).approv_ref_no :=
                        r.approv_ref_no;
                
                      l_lines(l_idx).claim_no :=
                        r.claim_no;
                
                      l_lines(l_idx).req_need_a :=
                        r.req_need_a;
                
                      l_lines(l_idx).req_a_status :=
                        r.req_a_status;
                
                      /*
                       * Complete package input contract.
                       */
                      l_lines(l_idx).package_service_id :=
                        r.package_service_id;
                
                      l_lines(l_idx).package_instance_id :=
                        r.package_instance_id;
                
                      l_lines(l_idx).package_line_role :=
                        r.package_line_role;
                
                      l_lines(l_idx).package_component_order :=
                        r.package_component_order;
                
                      l_lines(l_idx).package_parent_line_id :=
                        r.package_parent_line_id;
                
                      l_lines(l_idx).package_pricing_method :=
                        r.package_pricing_method;
                
                      l_lines(l_idx).package_definition_token :=
                        r.package_definition_token;  
                
                
                      /*
                       * Complete bundled offer input contract.
                       */
                
                      l_lines(l_idx).offer_id :=
                        r.offer_id;
                
                      l_lines(l_idx).offer_dtl_id :=
                        r.offer_dtl_id;
                
                      l_lines(l_idx).offer_type :=
                        r.offer_type;
                
                      l_lines(l_idx).offer_instance_id :=
                        r.offer_instance_id;
                
                      l_lines(l_idx).offer_line_role :=
                        r.offer_line_role;
                
                      l_lines(l_idx).offer_parent_line_id :=
                        r.offer_parent_line_id;
                
                      l_lines(l_idx).offer_price_applied :=
                        r.offer_price_applied;
                
                      l_lines(l_idx).offer_dis_applied :=
                        r.offer_dis_applied;
                
                      l_lines(l_idx).offer_name_snapshot :=
                        r.offer_name_snapshot;
                
                      l_lines(l_idx).offer_object_version_number :=
                        r.offer_object_version_number;
                
                      l_lines(l_idx).offer_dtl_object_version_number :=
                        r.offer_dtl_object_version_number;  
                    end loop;
                  end if;
                
                  if l_idx = 0 then
                    raise_application_error(
                      -20899,
                      'Add at least one invoice line.'
                    );
                  end if;
                end build_lines;
                
                procedure refresh_manual_offer_evidence
                is
                  l_i pls_integer;
                begin
                  /*
                   * Final server-side preview.
                   *
                   * This removes dependency on whether the browser-side async preview
                   * finished saving OFFER_* evidence into BIL_INV_DRAFT_LINES before submit.
                   */
                  bil_invoice_api.calculate_editable_invoice_preview(
                    p_header        => l_header,
                    p_lines         => l_lines,
                    p_client_ids    => l_full_client_ids,
                    p_amount_1      => l_amount_1,
                    p_amount_2      => l_amount_2,
                    p_amount_1_auto => nvl(:P48_AMOUNT_1_AUTO, 'Y'),
                    o_lines         => l_final_preview_lines,
                    o_totals        => l_final_preview_totals
                  );
                
                  l_i := l_lines.first;
                
                  while l_i is not null loop
                    if l_final_preview_lines.exists(l_i) then
                      /*
                       * Copy only backend-owned offer evidence.
                       * Do not overwrite manual discount inputs here.
                       */
                      l_lines(l_i).offer_id :=
                        l_final_preview_lines(l_i).offer_id;
                
                      l_lines(l_i).offer_dtl_id :=
                        l_final_preview_lines(l_i).offer_dtl_id;
                
                      l_lines(l_i).offer_type :=
                        l_final_preview_lines(l_i).offer_type;
                
                      l_lines(l_i).offer_instance_id :=
                        l_final_preview_lines(l_i).offer_instance_id;
                
                      l_lines(l_i).offer_line_role :=
                        l_final_preview_lines(l_i).offer_line_role;
                
                      l_lines(l_i).offer_parent_line_id :=
                        l_final_preview_lines(l_i).offer_parent_line_id;
                
                      l_lines(l_i).offer_price_applied :=
                        l_final_preview_lines(l_i).offer_price_applied;
                
                      l_lines(l_i).offer_dis_applied :=
                        l_final_preview_lines(l_i).offer_dis_applied;
                
                      l_lines(l_i).offer_name_snapshot :=
                        l_final_preview_lines(l_i).offer_name_snapshot;
                
                      l_lines(l_i).offer_object_version_number :=
                        l_final_preview_lines(l_i).offer_object_version_number;
                
                      l_lines(l_i).offer_dtl_object_version_number :=
                        l_final_preview_lines(l_i).offer_dtl_object_version_number;
                    end if;
                
                    l_i := l_lines.next(l_i);
                  end loop;
                end refresh_manual_offer_evidence;
                
                begin
                  if fnd_app_security.has_permission(
                       'BILLING_PATIENT_INVOICES_CREATE'
                     ) <> 'TRUE'
                  then
                    raise_application_error(
                      -20802,
                      'You are not authorized to create patient invoices.'
                    );
                  end if;
                
                  rebuild_locked_lines;
                  build_header;
                  build_lines;
                
                    if nvl(l_source_mode, 'MANUAL') not in ('NEW_VISIT', 'REQUEST') then
                  declare
                    l_i pls_integer;
                  begin
                    l_i := l_lines.first;
                
                    while l_i is not null loop
                      l_visible_client_ids(l_i) := null;
                      l_i := l_lines.next(l_i);
                    end loop;
                  end;
                
                    bil_invoice_api.expand_bundled_offer_ig_lines(
                        p_visible_lines      => l_lines,
                        p_visible_client_ids => l_visible_client_ids,
                        o_full_lines         => l_full_lines,
                        o_full_client_ids    => l_full_client_ids
                        );
                
                l_lines := l_full_lines;
                
                refresh_manual_offer_evidence;
                  end if;
                
                  bil_invoice_api.create_full_invoice(
                    p_header                => l_header,
                    p_lines                 => l_lines,
                    p_post_payment          => 'Y',
                    p_amount_1              => l_amount_1,
                    p_amount_2              => l_amount_2,
                    p_sub_paytype           => l_header.sub_paytype,
                    p_sub_paytype2          => l_header.sub_paytype2,
                    p_allow_partial         => 'N',
                    p_allow_overpayment     => 'N',
                    p_post_queue            => 'Y',
                    p_queue_force           => 'N',
                    p_reserv_system_enabled => 'N',
                    p_post_stock            => 'Y',
                    p_stock_repost          => 'Y',
                    p_build_print_url       => 'N',
                    p_send_sms              =>   case
                                                   when apex_application.g_request = 'CREATE_INVOICE_AND_PRINT'
                                                     then 'Y'
                                                     else 'N'
                                                 end,
                    p_sms_mobile_no         => :P48_MOBILE_NO,
                    p_request_id            => :P48_DRAFT_ID,
                    o_result                => l_result
                  );
                
                  delete from bil_inv_draft_lines
                   where app_session_id = :APP_SESSION
                     and draft_id       = :P48_DRAFT_ID;
                
                  if apex_collection.collection_exists(
                       c_import_preview_collection
                     )
                  then
                    apex_collection.delete_collection(
                      c_import_preview_collection
                    );
                  end if;
                
                  :P48_INV_NO     := l_result.invoice_result.inv_no;
                  :P48_MODE       := 'VIEW';
                  :P48_OPEN_PRINT := l_open_print;
                  :P48_PRINT_URL  := null;
                
                  apex_application.g_print_success_message :=
                    l_result.message;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 12035993344981219
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                apex_application.g_request in (
                  'CREATE_INVOICE_AND_PRINT',
                  'CREATE_INVOICE'
                )
                and fnd_app_security.has_permission(
                      'BILLING_PATIENT_INVOICES_CREATE'
                    ) = 'TRUE'
                ```
        }
    )

    process validate-request-invoice-context (
        name: Validate Request Invoice Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_paytype        bil_request_inv_selection.paytype%type;
                    l_line_count     pls_integer;
                    l_clinicid       v_services_req.clinicid%type;
                    l_docid          v_services_req.docid%type;
                    l_clinic_count   pls_integer;
                    l_doc_count      pls_integer;
                    l_missing_clinic pls_integer;
                    l_missing_doc    pls_integer;
                begin
                    /*
                     * Page access is controlled by BILLING_PATIENT_INVOICES_VIEW,
                     * but creating an invoice requires the create permission.
                     */
                    if fnd_app_security.has_permission(
                           'BILLING_PATIENT_INVOICES_CREATE'
                       ) <> 'TRUE'
                    then
                        raise_application_error(
                            -20872,
                            'You are not authorized to create patient invoices.'
                        );
                    end if;
                
                    /*
                     * Normalize and resolve the requested coverage type.
                     */
                    :P48_COVERAGE_MODE := upper(trim(:P48_COVERAGE_MODE));
                
                    case :P48_COVERAGE_MODE
                        when 'CASH' then
                            l_paytype := 1;
                
                        when 'CREDIT' then
                            l_paytype := 2;
                
                        else
                            raise_application_error(
                                -20875,
                                'Request coverage mode must be Cash or Credit.'
                            );
                    end case;
                
                    /*
                     * The request-invoice route must always identify one patient
                     * and one visit.
                     */
                    if :P48_PATIENTNO is null then
                        raise_application_error(
                            -20876,
                            'Patient number is required for a requested-service invoice.'
                        );
                    end if;
                
                    if :P48_VISIT_UNIQUE is null then
                        raise_application_error(
                            -20877,
                            'Visit is required for a requested-service invoice.'
                        );
                    end if;
                
                    /*
                     * Resolve the clinic and doctor directly from the valid selected
                     * request lines for this user, session, patient, visit and coverage.
                     */
                    select min(r.clinicid),
                           min(r.docid),
                           count(*),
                           count(distinct r.clinicid),
                           count(distinct r.docid),
                           sum(
                               case
                                   when r.clinicid is null then 1
                                   else 0
                               end
                           ),
                           sum(
                               case
                                   when r.docid is null then 1
                                   else 0
                               end
                           )
                      into l_clinicid,
                           l_docid,
                           l_line_count,
                           l_clinic_count,
                           l_doc_count,
                           l_missing_clinic,
                           l_missing_doc
                      from bil_request_inv_selection s
                      join v_services_req r
                        on r.patientno           = s.patientno
                       and r.visit_unique        = s.visit_unique
                       and r.pat_serv_req_row_id = s.pat_serv_req_row_id
                     where s.app_id         = :APP_ID
                       and s.app_session_id = :APP_SESSION
                       and s.app_user       = :APP_USER
                       and s.patientno      = :P48_PATIENTNO
                       and s.visit_unique   = :P48_VISIT_UNIQUE
                       and s.paytype        = l_paytype
                
                       /*
                        * The selected row must still belong to the requested
                        * coverage type.
                        */
                       and case upper(trim(r.pay_type))
                               when 'CASH' then 1
                               when 'CREDIT' then 2
                           end = l_paytype
                
                       /*
                        * Do not allow a request line that has already been invoiced.
                        */
                       and r.d_inv_row_id is null
                
                       /*
                        * Exclude rejected or otherwise non-invoiceable requests.
                        */
                       and nvl(r.req_a_status, 0) <> 3
                       and nvl(r.req_need_a, 0) <> 2
                
                       /*
                        * A credit request that requires approval must have an
                        * approval reference.
                        */
                       and not (
                           l_paytype = 2
                           and nvl(r.req_need_a, 0) <> 0
                           and r.approv_ref_no is null
                       );
                
                    if l_line_count = 0 then
                        raise_application_error(
                            -20878,
                            case l_paytype
                                when 1 then
                                    'No valid selected cash requested services were found.'
                                else
                                    'No valid selected approved credit requested services were found.'
                            end
                        );
                    end if;
                
                    if nvl(l_missing_clinic, 0) > 0 then
                        raise_application_error(
                            -20879,
                            'One or more selected requested services do not have a specialty.'
                        );
                    end if;
                
                    if nvl(l_missing_doc, 0) > 0 then
                        raise_application_error(
                            -20880,
                            'One or more selected requested services do not have a doctor.'
                        );
                    end if;
                
                    if l_clinic_count <> 1 then
                        raise_application_error(
                            -20881,
                            'Selected requested services must belong to one specialty.'
                        );
                    end if;
                
                    if l_doc_count <> 1 then
                        raise_application_error(
                            -20882,
                            'Selected requested services must belong to one doctor.'
                        );
                    end if;
                
                    /*
                     * Populate the invoice context used by the later page processes.
                     */
                    :P48_PAYTYPE  := l_paytype;
                    :P48_CLINICID := l_clinicid;
                    :P48_DOCID    := l_docid;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24017232145706136
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_SOURCE_MODE = 'REQUEST'
                and nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                ```
        }
    )

    branch (
        name: GO_TO_VIEW_INVOICE
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 48
                items: {
                    P48_MODE: VIEW
                    P48_INV_NO: &P48_INV_NO.
                    P48_OPEN_PRINT: &P48_OPEN_PRINT.
                }
                clearCache: 48
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE_INVOICE,CREATE_INVOICE_AND_PRINT
        }
    )

)

