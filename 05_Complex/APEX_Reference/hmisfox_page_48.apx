    pageItem P48_PACKAGE_SERVICEID (
        type: popupLov
        label {
            label: Package
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.servicedesc || ' - ' || s.serviceid as d,
                       s.serviceid as r
                  from services s
                 where :P48_LIST_ID  is not null
                   and :P48_PLAN_CODE is not null
                   and s.list_id = :P48_LIST_ID
                   and nvl(s.is_package, 0) = 1
                   and s.package_pricing_method in (
                         'FIXED_PRICE',
                         'COMPONENT_PRICE',
                         'FREE'
                       )
                
                   /*
                    * The package must contain at least one component.
                    */
                   and exists (
                         select 1
                           from package_dtl pd
                          where pd.serviceid = s.serviceid
                            and pd.list_id   = s.list_id
                       )
                
                   /*
                    * Every configured component must exist and have a valid quantity.
                    */
                   and not exists (
                         select 1
                           from package_dtl pd
                          where pd.serviceid = s.serviceid
                            and pd.list_id   = s.list_id
                            and (
                                  nvl(pd.qty, 0) <= 0
                                  or not exists (
                                       select 1
                                         from services cs
                                        where cs.serviceid =
                                              pd.sub_serviceid
                                          and cs.list_id =
                                              pd.list_id
                                     )
                                )
                       )
                
                   /*
                    * The package parent must be configured in the current patient plan.
                    *
                    * FIXED_PRICE:
                    *   Parent price must be greater than zero.
                    *
                    * COMPONENT_PRICE:
                    *   Parent price must be zero because components are billed.
                    *
                    * FREE:
                    *   Parent price and discount must be zero.
                    */
                   and exists (
                         select 1
                           from price_plan_dtl pp
                          where pp.plan_code = :P48_PLAN_CODE
                            and pp.list_id   = :P48_LIST_ID
                            and pp.serviceid = s.serviceid
                            and (
                                  (
                                    s.package_pricing_method = 'FIXED_PRICE'
                                    and nvl(pp.price, 0) > 0
                                  )
                                  or
                                  (
                                    s.package_pricing_method = 'COMPONENT_PRICE'
                                    and nvl(pp.price, 0) = 0
                                  )
                                  or
                                  (
                                    s.package_pricing_method = 'FREE'
                                    and nvl(pp.price, 0) = 0
                                    and nvl(pp.price_disc, 0) = 0
                                  )
                                )
                       )
                
                   /*
                    * For COMPONENT_PRICE packages, every component must have a
                    * usable row in the current patient price plan.
                    */
                   and (
                         s.package_pricing_method <> 'COMPONENT_PRICE'
                         or not exists (
                              select 1
                                from package_dtl pd
                               where pd.serviceid = s.serviceid
                                 and pd.list_id   = s.list_id
                                 and not exists (
                                      select 1
                                        from price_plan_dtl cpp
                                       where cpp.plan_code =
                                             :P48_PLAN_CODE
                                         and cpp.list_id =
                                             :P48_LIST_ID
                                         and cpp.serviceid =
                                             pd.sub_serviceid
                                         and cpp.price is not null
                                    )
                            )
                       )
                 order by s.servicedesc
                ```
        }
        cascadingLov {
            parentItems: [
                P48_PAYTYPE
                P48_PLAN_CODE
                P48_LIST_ID
            ]
        }
        layout {
            sequence: 10
            region: @import-package
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

