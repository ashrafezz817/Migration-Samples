    dynamicAction bundle-offer-changed (
        name: Bundle Offer Changed
        execution {
            sequence: 180
        }
        when {
            selectionType: items
            items: P48_OFFER_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var offerId =
                        $v("P48_OFFER_ID");
                    
                      var region;
                      var gridView;
                      var model;
                      var foundQty = null;
                    
                      function rawValue(record, columnName) {
                        var value;
                    
                        try {
                          value =
                            model.getValue(
                              record,
                              columnName
                            );
                        } catch (e) {
                          return "";
                        }
                    
                        if (
                          value &&
                          typeof value === "object" &&
                          Object.prototype.hasOwnProperty.call(
                            value,
                            "v"
                          )
                        ) {
                          return value.v;
                        }
                    
                        return value;
                      }
                    
                      function isDeleted(record) {
                        var recordId;
                        var metadata;
                    
                        try {
                          recordId =
                            model.getRecordId(record);
                    
                          metadata =
                            model.getRecordMetadata(recordId);
                        } catch (e) {
                          return false;
                        }
                    
                        return !!(
                          metadata &&
                          metadata.deleted
                        );
                      }
                    
                      if (!offerId) {
                        $s("P48_BUNDLE_QTY", "1");
                        return;
                      }
                    
                      region =
                        apex.region("invoice_services");
                    
                      if (!region) {
                        $s("P48_BUNDLE_QTY", "1");
                        return;
                      }
                    
                      gridView =
                        region
                          .widget()
                          .interactiveGrid(
                            "getViews",
                            "grid"
                          );
                    
                      if (
                        !gridView ||
                        !gridView.model
                      ) {
                        $s("P48_BUNDLE_QTY", "1");
                        return;
                      }
                    
                      model =
                        gridView.model;
                    
                      model.forEach(function (record) {
                        var rowOfferType;
                        var rowOfferId;
                    
                        if (
                          foundQty !== null ||
                          isDeleted(record)
                        ) {
                          return;
                        }
                    
                        rowOfferType =
                          p48NumberOrNull(
                            rawValue(
                              record,
                              "OFFER_TYPE"
                            ),
                            "Offer type"
                          );
                    
                        rowOfferId =
                          String(
                            rawValue(
                              record,
                              "OFFER_ID"
                            ) || ""
                          );
                    
                        if (
                          rowOfferType === 0 &&
                          rowOfferId === String(offerId)
                        ) {
                          foundQty =
                            rawValue(
                              record,
                              "QTY"
                            );
                        }
                      });
                    
                      $s(
                        "P48_BUNDLE_QTY",
                        foundQty || "1"
                      );
                    })();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction create-invoice-after-preview (
        name: Create Invoice After Preview
        execution {
            sequence: 190
        }
        when {
            event: click
            selectionType: button
            button: @save-invoice
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function() {
                        "use strict";
                    
                        function showError(message) {
                            apex.message.clearErrors();
                    
                            apex.message.showErrors([{
                                type: "error",
                                location: "page",
                                message: message ||
                                    "Invoice preview could not be calculated. Review the invoice and try again.",
                                unsafe: false
                            }]);
                        }
                    
                        function releaseSubmit() {
                            p48ReleaseInvoiceSubmit();
                        }
                    
                        function validateAndSubmit() {
                            /*
                             * Validate the final browser model after the authoritative
                             * preview has been applied.
                             */
                            if (!apex.page.validate()) {
                                releaseSubmit();
                                return;
                            }
                    
                            /*
                             * Client validation has already been performed above.
                             * Server-side APEX validations/processes still execute normally
                             * after the page is submitted.
                             */
                            apex.page.submit({
                                request: "CREATE_INVOICE",
                                validate: false,
                                showWait: true
                            });
                        }
                    
                        function runPreviewThenSubmit() {
                            /*
                             * Locked REQUEST / NEW_VISIT mode does not use the editable
                             * browser preview.
                             */
                            if ($v("P48_SOURCE_MODE")) {
                                validateAndSubmit();
                                return;
                            }
                    
                            if (
                                !window.p48InvoicePreview ||
                                typeof window.p48InvoicePreview.refreshAndWait !==
                                "function"
                            ) {
                                releaseSubmit();
                    
                                showError(
                                    "Invoice preview is not available. Refresh the page and try again."
                                );
                    
                                return;
                            }
                    
                            window.p48InvoicePreview
                                .refreshAndWait()
                                .done(function() {
                                    validateAndSubmit();
                                })
                                .fail(function(error) {
                                    releaseSubmit();
                    
                                    showError(
                                        error &&
                                        error.message
                                    );
                                });
                        }
                    
                        function finishEditingThenContinue() {
                            var region =
                                apex.region(
                                    "invoice_services"
                                );
                    
                            var gridView =
                                region &&
                                region.widget()
                                .interactiveGrid(
                                    "getViews",
                                    "grid"
                                );
                    
                            if (
                                gridView &&
                                gridView.view$
                            ) {
                                gridView.view$
                                    .grid(
                                        "finishEditing"
                                    )
                                    .done(
                                        runPreviewThenSubmit
                                    )
                                    .fail(function() {
                                        releaseSubmit();
                    
                                        showError(
                                            "The active invoice line could not be completed. Review the line and try again."
                                        );
                                    });
                    
                                return;
                            }
                    
                            runPreviewThenSubmit();
                        }
                    
                        /*
                         * Point 11 + Point 12:
                         * acquire the lock before finishEditing can trigger any more
                         * preview activity.
                         */
                        if (!p48BeginInvoiceSubmit()) {
                            return;
                        }
                    
                        finishEditingThenContinue();
                    }());
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction create-invoice-and-reserve-print-window (
        name: Create Invoice And Reserve Print Window
        execution {
            sequence: 170
        }
        when {
            event: click
            selectionType: button
            button: @save-and-pay
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      "use strict";
                    
                      var printWindow;
                    
                      function showError(message) {
                        apex.message.clearErrors();
                    
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: "page",
                            message:
                              message ||
                              "Invoice preview could not be calculated. Review the invoice and try again.",
                            unsafe: false
                          }
                        ]);
                      }
                    
                      function closeReservedPrintWindow() {
                        sessionStorage.removeItem(
                          "p48_print_pending"
                        );
                    
                        try {
                          if (
                            printWindow &&
                            !printWindow.closed
                          ) {
                            printWindow.close();
                          }
                        } catch (ignore) {
                          /*
                           * Ignore browser window access issues.
                           */
                        }
                      }
                    
                      window.p48ReservedPrintWindow =
                      null;
                    
                      function releaseSubmit() {
                        closeReservedPrintWindow();
                        p48ReleaseInvoiceSubmit();
                      }
                    
                      function reservePrintWindow() {
                        printWindow = window.open(
                          "about:blank",
                          "p48_invoice_print"
                        );
                    
                      window.p48ReservedPrintWindow =
                        printWindow;  
                    
                        if (!printWindow) {
                          apex.message.alert(
                            "The browser blocked the print window. " +
                            "Allow pop-ups for this site and try again."
                          );
                    
                          return false;
                        }
                    
                        try {
                          printWindow.document.open();
                    
                          printWindow.document.write(
                            '<!doctype html>' +
                            '<html>' +
                            '<head>' +
                            '<meta charset="utf-8">' +
                            '<title>Preparing Invoice</title>' +
                            '</head>' +
                            '<body style="' +
                              'font-family:Arial,sans-serif;' +
                              'padding:24px;' +
                            '">' +
                            '<p>Preparing invoice PDF.</p>' +
                            '</body>' +
                            '</html>'
                          );
                    
                          printWindow.document.close();
                        } catch (ignore) {
                          /*
                           * Reserved window still exists.
                           */
                        }
                    
                        sessionStorage.setItem(
                          "p48_print_pending",
                          "Y"
                        );
                    
                        return true;
                      }
                    
                      function validateAndSubmit() {
                        if (!apex.page.validate()) {
                          releaseSubmit();
                          return;
                        }
                    
                        apex.page.submit({
                          request: "CREATE_INVOICE_AND_PRINT",
                          validate: false,
                          showWait: true
                        });
                      }
                    
                      function runPreviewThenSubmit() {
                        if ($v("P48_SOURCE_MODE")) {
                          validateAndSubmit();
                          return;
                        }
                    
                        if (
                          !window.p48InvoicePreview ||
                          typeof window.p48InvoicePreview.refreshAndWait !==
                            "function"
                        ) {
                          releaseSubmit();
                    
                          showError(
                            "Invoice preview is not available. Refresh the page and try again."
                          );
                    
                          return;
                        }
                    
                        window.p48InvoicePreview
                          .refreshAndWait()
                        .done(function() {
                            validateAndSubmit();
                        })
                          .fail(function (error) {
                            releaseSubmit();
                    
                            showError(
                              error &&
                              error.message
                            );
                          });
                      }
                    
                      function finishEditingThenPreview() {
                        var region =
                          apex.region(
                            "invoice_services"
                          );
                    
                        var gridView =
                          region &&
                          region.widget()
                            .interactiveGrid(
                              "getViews",
                              "grid"
                            );
                    
                        if (
                          gridView &&
                          gridView.view$
                        ) {
                          gridView.view$
                            .grid(
                              "finishEditing"
                            )
                            .done(
                              runPreviewThenSubmit
                            )
                            .fail(function () {
                              releaseSubmit();
                    
                              showError(
                                "The active invoice line could not be completed. Review the line and try again."
                              );
                            });
                    
                          return;
                        }
                    
                        runPreviewThenSubmit();
                      }
                    
                      /*
                       * Acquire the common Create lock BEFORE opening the popup.
                       * A second click therefore cannot open a second print window.
                       */
                      if (!p48BeginInvoiceSubmit()) {
                        return;
                      }
                    
                      if (!reservePrintWindow()) {
                        p48ReleaseInvoiceSubmit();
                        return;
                      }
                    
                      finishEditingThenPreview();
                    }());
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction manual-coverage-type-changed (
        name: Manual Payer Type Changed
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P48_PAYTYPE
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                ```
        }

        action native-javascript-code_1 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var priorPaytype =
                        String($v("P48_MANUAL_PAYTYPE") || "");
                    
                      var selectedPaytype =
                        String($v("P48_PAYTYPE") || "");
                    
                      var patientClassification =
                        String($v("P48_IS_CREDIT_PATIENT") || "");
                    
                      var region =
                        apex.region("invoice_services");
                    
                      var view =
                        region &&
                        region.widget().interactiveGrid(
                          "getViews",
                          "grid"
                        );
                    
                      var model =
                        view && view.model;
                    
                      var hasRows =
                        false;
                    
                      /*
                       * Browser-side protection for Cash patients.
                       * Server-side processes and the invoice engine remain authoritative.
                       */
                      if (patientClassification === "N" &&
                          selectedPaytype !== "1")
                      {
                        apex.item("P48_PAYTYPE").setValue(
                          "1",
                          null,
                          true
                        );
                    
                        apex.item("P48_MANUAL_PAYTYPE").setValue(
                          "1",
                          null,
                          true
                        );
                    
                        apex.message.clearErrors();
                    
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: "page",
                            message:
                              "This Cash patient cannot use Insurance / Direct Contract.",
                            unsafe: false
                          }
                        ]);
                    
                        return;
                      }
                    
                      if (model) {
                        model.forEach(function (record, index, id) {
                          var meta =
                            id === null || id === undefined
                              ? null
                              : model.getRecordMetadata(id);
                    
                          if (!(meta && meta.deleted)) {
                            hasRows =
                              true;
                          }
                        });
                      }
                    
                      /*
                       * Keep the existing rule:
                       * payer type cannot change after active invoice lines exist.
                       */
                      if (hasRows) {
                        if (priorPaytype) {
                          apex.item("P48_PAYTYPE").setValue(
                            priorPaytype,
                            null,
                            true
                          );
                        }
                    
                        apex.message.clearErrors();
                    
                        apex.message.showErrors([
                          {
                            type: "error",
                            location: "page",
                            message:
                              "Change Payer Type before adding invoice lines.",
                            unsafe: false
                          }
                        ]);
                    
                        return;
                      }
                    
                      apex.item("P48_MANUAL_PAYTYPE").setValue(
                        selectedPaytype,
                        null,
                        true
                      );
                    
                      apex.submit({
                        request: "CHANGE_MANUAL_PAYTYPE",
                        showWait: true
                      });
                    }());
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction manual-print-invoice (
        name: Manual Print Invoice
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action build-print-url-manual (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        l_request bil_reports_print.t_print_request;
                        l_result  bil_reports_print.t_print_result;
                    begin
                        :P48_PRINT_URL := null;
                        if :P48_INV_NO is null then
                            raise_application_error(-20891, 'Invoice is required before printing.');
                        end if;
                    
                        l_request.inv_no        := :P48_INV_NO;
                        l_request.report_type   := bil_reports_print.c_report_normal;
                        l_request.print_mode    := bil_reports_print.c_mode_preview;
                        l_request.desformat     := 'PDF';
                        l_request.user_id       := :G_USER_ID;
                    
                        bil_invoice_api.build_print_url(
                            p_request => l_request,
                            o_result  => l_result
                        );
                    
                        :P48_PRINT_URL := l_result.print_url;
                        :P48_OUTPUT_MESSAGE := 'Invoice print is ready. Invoice No: ' || :P48_INV_NO;
                    end;
                    ```
                itemsToSubmit: P48_INV_NO
                itemsToReturn: [
                    P48_PRINT_URL
                    P48_OUTPUT_MESSAGE
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
                stopExecutionOnError: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item("P48_PRINT_URL").setValue(
                        "",
                        null,
                        true
                    );
                    
                    window.p48ManualPrintWindow =
                        window.open(
                            "about:blank",
                            "p48_invoice_print"
                        );
                    
                    if (!window.p48ManualPrintWindow) {
                        apex.message.alert(
                            "The browser blocked the print window. Allow pop-ups for this site and try again."
                        );
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action open-manual-print-url (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                        var printUrl =
                            $v("P48_PRINT_URL");
                    
                        var printWindow =
                            window.p48ManualPrintWindow;
                    
                        if (!printUrl) {
                            try {
                                if (
                                    printWindow &&
                                    !printWindow.closed
                                ) {
                                    printWindow.close();
                                }
                            } catch (ignore) {
                                /*
                                 * Ignore browser window access issues.
                                 */
                            }
                    
                            window.p48ManualPrintWindow =
                                null;
                    
                            return;
                        }
                    
                        if (
                            !printWindow ||
                            printWindow.closed
                        ) {
                            apex.message.clearErrors();
                    
                            apex.message.showErrors([{
                                type: "error",
                                location: "page",
                                message:
                                    "The print window is no longer available. Try printing again.",
                                unsafe: false
                            }]);
                    
                            window.p48ManualPrintWindow =
                                null;
                    
                            return;
                        }
                    
                        try {
                            printWindow.location.replace(
                                printUrl
                            );
                        } catch (e) {
                            try {
                                printWindow.close();
                            } catch (ignore) {
                                /*
                                 * Ignore browser window access issues.
                                 */
                            }
                    
                            window.p48ManualPrintWindow =
                                null;
                    
                            apex.message.clearErrors();
                    
                            apex.message.showErrors([{
                                type: "error",
                                location: "page",
                                message:
                                    "The invoice print window could not be opened.",
                                unsafe: false
                            }]);
                    
                            return;
                        }
                    
                        /*
                         * Do not close/null the window after success.
                         * The same named window is reused on the next Print click.
                         */
                    }());
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction manual-send-invoice-sms (
        name: Manual Send Invoice SMS
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @send-sms
        }

        action send-invoice-sms-manual (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      l_result bil_message.t_message_result;
                    begin
                      if :P48_INV_NO is null then
                        :P48_SMS_STATUS := 'Failed';
                        :P48_OUTPUT_MESSAGE :=
                          'Invoice is required before sending SMS.';
                    
                        return;
                      end if;
                    
                      bil_invoice_api.send_invoice_message(
                        p_inv_no    => :P48_INV_NO,
                        p_mobile_no => :P48_MOBILE_NO,
                        p_user_id   => :G_USER_ID,
                        o_result    => l_result
                      );
                    
                      if l_result.send_status = 'SENT' then
                          :P48_SMS_STATUS :=
                              'Sent';
                    
                          :P48_OUTPUT_MESSAGE :=
                              'Invoice SMS sent successfully. Invoice No: ' ||
                              :P48_INV_NO;
                      else
                          raise_application_error(
                              -20895,
                              nvl(
                                  l_result.message,
                                  'Invoice SMS was not confirmed as sent.'
                              )
                          );
                      end if;
                    
                    exception
                      when others then
                        apex_debug.error(
                          p_message =>
                            'Invoice SMS failed for invoice %s: %s',
                          p0 => to_char(:P48_INV_NO),
                          p1 => sqlerrm
                        );
                    
                        :P48_SMS_STATUS := 'Failed';
                        :P48_OUTPUT_MESSAGE :=
                          'The invoice SMS could not be sent. ' ||
                          'Try again or contact support.';
                    end;
                    ```
                itemsToSubmit: [
                    P48_INV_NO
                    P48_MOBILE_NO
                ]
                itemsToReturn: [
                    P48_SMS_STATUS
                    P48_OUTPUT_MESSAGE
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-manual-sms-result (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var status = $v("P48_SMS_STATUS");
                      var message = $v("P48_OUTPUT_MESSAGE");
                    
                      if (status === "Sent") {
                        apex.message.showPageSuccess(message);
                        return;
                      }
                    
                      apex.message.showErrors([{
                        type: "error",
                        location: "page",
                        message:
                          message ||
                          "The invoice SMS could not be sent. " +
                          "Try again or contact support.",
                        unsafe: false
                      }]);
                    }());
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction open-print-on-view-load (
        name: Open Print On View Load
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action build-print-url-for-auto-open (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        l_request bil_reports_print.t_print_request;
                        l_result  bil_reports_print.t_print_result;
                    begin
                        if :P48_MODE <> 'VIEW'
                           or nvl(:P48_OPEN_PRINT, 'N') <> 'Y'
                           or :P48_INV_NO is null then
                            return;
                        end if;
                    
                        l_request.inv_no        := :P48_INV_NO;
                        l_request.report_type   := bil_reports_print.c_report_normal;
                        l_request.print_mode    := bil_reports_print.c_mode_preview;
                        l_request.desformat     := 'PDF';
                        l_request.user_id       := :G_USER_ID;
                    
                        bil_invoice_api.build_print_url(
                            p_request => l_request,
                            o_result  => l_result
                        );
                    
                        :P48_PRINT_URL := l_result.print_url;
                    end;
                    ```
                itemsToSubmit: [
                    P48_MODE
                    P48_INV_NO
                    P48_OPEN_PRINT
                ]
                itemsToReturn: P48_PRINT_URL
                showProcessing: true
            }
            execution {
                sequence: 20
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var isPending =
                        sessionStorage.getItem(
                          "p48_print_pending"
                        ) === "Y";
                    
                      var printWindow;
                    
                      /*
                       * The page returned without reaching VIEW mode,
                       * normally because validation or processing failed.
                       */
                      if (
                        isPending &&
                        $v("P48_MODE") !== "VIEW"
                      ) {
                        printWindow = window.open(
                          "",
                          "p48_invoice_print"
                        );
                    
                        if (printWindow && !printWindow.closed) {
                          printWindow.close();
                        }
                    
                        sessionStorage.removeItem(
                          "p48_print_pending"
                        );
                      }
                    }());
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action open-print-url-on-view-load (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var isPending =
                        sessionStorage.getItem(
                          "p48_print_pending"
                        ) === "Y";
                    
                      var printUrl = $v("P48_PRINT_URL");
                      var printWindow;
                    
                      if (
                        !isPending ||
                        $v("P48_OPEN_PRINT") !== "Y"
                      ) {
                        return;
                      }
                    
                      sessionStorage.removeItem(
                        "p48_print_pending"
                      );
                    
                      printWindow = window.open(
                        "",
                        "p48_invoice_print"
                      );
                    
                      if (!printWindow || printWindow.closed) {
                        apex.message.showPageSuccess(
                          "Invoice created successfully. " +
                          "The print window was blocked; use the Print button."
                        );
                        return;
                      }
                    
                      if (!printUrl) {
                        printWindow.close();
                    
                        apex.message.showErrors([{
                          type: "error",
                          location: "page",
                          message:
                            "The invoice was created, but the print URL " +
                            "could not be built. Use the Print button.",
                          unsafe: false
                        }]);
                    
                        return;
                      }
                    
                      try {
                        printWindow.opener = null;
                      } catch (ignore) {
                        // No action required.
                      }
                    
                      printWindow.location.replace(printUrl);
                    }());
                    ```
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction payment-inputs-changed (
