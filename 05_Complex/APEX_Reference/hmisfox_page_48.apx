    region invoice_services (
        name: Invoice Services
        title: Invoice Lines
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.line_id,
                       d.app_session_id,
                       d.draft_id,
                       d.seq_no,
                       d.source_type,
                       d.source_id,
                       d.serviceid,
                       d.servicedesc,
                       d.qty,
                       d.price,
                       d.price_override,
                       d.use_price_override,
                       d.discount_type,
                       d.disc,
                       d.my_disc,
                       d.my_price,
                       d.my_net,
                       d.the_pay,
                       d.the_comp,
                       d.vat_rate,
                       d.vat_val_pat,
                       d.vat_val_co,
                       d.teeth_no,
                       d.tooth_surface,
                       d.teeth_no2,
                       d.pat_serv_req_row_id,
                       d.approv_date,
                       d.approv_validity,
                       d.approv_ref_no,
                       d.claim_no,
                       d.req_need_a,
                       d.req_a_status,
                       d.info_center_id,
                       d.add_to_que,
                       d.item_code,
                       d.has_stock,
                       d.has_queue,
                       d.sfda_code,
                       d.package_service_id,
                       d.package_instance_id,
                       d.package_line_role,
                       d.package_component_order,
                       d.package_parent_line_id,
                       d.package_definition_token,
                       d.offer_id,
                       d.offer_dtl_id,
                       d.offer_type,
                       d.offer_instance_id,
                       d.offer_line_role,
                       d.offer_parent_line_id,
                       d.offer_price_applied,
                       d.offer_dis_applied,
                       d.offer_name_snapshot,
                       d.offer_object_version_number,
                       d.offer_dtl_object_version_number,
                
                       cast(null as varchar2(20)) as package_pricing_method,
                       cast(null as varchar2(1))  as allow_manual_discount,
                       cast(null as varchar2(1))  as allow_price_override,
                
                
                       cast(null as number)       as plan_discount_pct,
                       cast(null as number)       as plan_discount_amount,
                       cast(null as varchar2(20)) as discount_source,
                       cast(null as number)       as effective_discount_pct,
                       cast(null as number)       as total_discount_amount
                
                  from bil_inv_draft_lines d
                 where d.app_session_id = :APP_SESSION
                   and d.draft_id       = :P48_DRAFT_ID
                   and not (
                   nvl(d.offer_type, -1) = 0
                   and nvl(d.offer_line_role, '~') = 'PARENT'
                   )
                ```
        }
        layout {
            sequence: 50
            parentRegion: @container
            slot: regionBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: invoice_services
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                ```
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        messages {
            whenNoDataFound: No services added yet. Click Add Service to start the invoice.
        }
        toolbar {
            addButtonLabel: Add Service
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function (options) {
                  return window.p48InvoiceServicesInit(
                    options
                  );
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 11940576610958029
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }
        )

