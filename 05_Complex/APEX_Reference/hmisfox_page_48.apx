                nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and :P48_SOURCE_MODE is null
                and fnd_app_security.has_permission(
                  'BILLING_PATIENT_INVOICES_CREATE'
                ) = 'TRUE'
                ```
            executeCondition: once
        }
    )

    process load-patient-context (
        name: Load Patient Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_ctx                  bil_types.t_patient_context;
                  l_curr_code            price_list_master.curr_code%type;
                  l_list_info_center_id  price_list_master.the_info_center%type;
                  l_expected_mode        varchar2(10);
                begin
                  /*
                   * NEW_VISIT must preserve the payer choice passed from Page 56.
                   */
                  if upper(trim(:P48_SOURCE_MODE)) = 'NEW_VISIT' then
                    if :P48_PAYTYPE is null
                       or :P48_PAYTYPE not in (1, 2)
                    then
                      raise_application_error(
                        -20805,
                        'Select Cash or Insurance / Direct Contract for the new visit.'
                      );
                    end if;
                
                    if :P48_INFO_CENTER_ID is null then
                      raise_application_error(
                        -20804,
                        'The new visit info center is required.'
                      );
                    end if;
                
                    l_expected_mode :=
                      case :P48_PAYTYPE
                        when 1 then 'CASH'
                        when 2 then 'CREDIT'
                      end;
                
                    :P48_COVERAGE_MODE :=
                      l_expected_mode;
                
                    bil_patient_context.get_context(
                      p_patientno      => :P48_PATIENTNO,
                      p_invoice_date   => sysdate,
                      p_paytype        => :P48_PAYTYPE,
                      p_info_center_id => :P48_INFO_CENTER_ID,
                      o_context        => l_ctx
                    );
                  else
                    /*
                     * Preserve the existing automatic context behavior for manual and
                     * requested-service invoices.
                     */
                    bil_patient_context.get_context(
                      p_patientno    => :P48_PATIENTNO,
                      p_invoice_date => sysdate,
                      o_context      => l_ctx
                    );
                
                    :P48_PAYTYPE :=
                      case
                        when l_ctx.is_cash = 'Y' then 1
                        else 2
                      end;
                  end if;
                
                  :P48_PATIENT_NAME :=
                    l_ctx.patientname;
                
                  :P48_LIST_ID :=
                    l_ctx.list_id;
                
                  select trim(p.phone_h)
                    into :P48_MOBILE_NO
                    from patient p
                   where p.patientno = :P48_PATIENTNO;
                
                  :P48_COVERAGE_TYPE :=
                    case
                      when l_ctx.is_cash = 'Y' then
                        'Cash'
                
                      when l_ctx.coverage_type = 'DIRECT_CONTRACT' then
                        'Direct Contract'
                
                      else
                        'Insurance'
                    end;
                
                  if upper(trim(:P48_SOURCE_MODE)) = 'NEW_VISIT' then
                    :P48_MANUAL_PAYTYPE :=
                      :P48_PAYTYPE;
                
                  elsif :P48_SOURCE_MODE is null
                        and :P48_MANUAL_PAYTYPE is null
                  then
                    :P48_MANUAL_PAYTYPE :=
                      :P48_PAYTYPE;
                  end if;
                
                  :P48_COMP_NAME :=
                    l_ctx.comp_name;
                
                  :P48_CLASS_NAME :=
                    l_ctx.class_name;
                
                  :P48_MAX_DEDUCTIBLE :=
                    case
                      when nvl(l_ctx.is_cash, 'N') = 'Y' then
                        null
                
                      when l_ctx.max_deductable is null then
                        null
                
                      else
                        to_char(
                          l_ctx.max_deductable,
                          'FM999G999G999G990D00'
                        )
                    end;
                
                  begin
                    select curr_code,
                           the_info_center
                      into l_curr_code,
                           l_list_info_center_id
                      from price_list_master
                     where list_id = :P48_LIST_ID;
                  exception
                    when no_data_found then
                      raise_application_error(
                        -20803,
                        'No price list was found for the selected payer context.'
                      );
                  end;
                
                  :P48_PLAN_CODE :=
                    l_ctx.plan_code;
                
                  :P48_CURR_CODE :=
                    l_curr_code;
                
                  /*
                   * For NEW_VISIT, retain the exact info center passed from Page 56.
                   * For other modes, preserve the existing price-list-derived behavior.
                   *
                   * NVL is important because NULL <> 'NEW_VISIT' is not TRUE in PL/SQL.
                   */
                  if nvl(
                       upper(trim(:P48_SOURCE_MODE)),
                       'MANUAL'
                     ) <> 'NEW_VISIT'
                  then
                    :P48_INFO_CENTER_ID :=
                      l_list_info_center_id;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11940369259958027
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_PATIENTNO is not null
                and nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                ```
        }
    )

    process load-saved-invoice-context (
        name: Load Saved Invoice Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_amount_due number;
                  l_total_paid number;
                begin
                  bil_invoice_access.assert_access(
                    p_inv_no => :P48_INV_NO,
                    p_action => 'VIEW'
                  );
                
                  select t.patientno,
                         t.patientname,
                         trim(p.phone_h) mobile_no,
                         case
                           when nvl(t.paytype, 1) = 1 then
                             'Cash'
                           when nvl(c.is_direct, 0) = 1
                             or nvl(c.comp_type, 0) = 1
                           then
                             'Direct Contract'
                           else
                             'Insurance'
                         end coverage_type,
                         c.comp_name,
                         dc.class_name,
                         t.curr_code,
                         t.invdate,
                         t.clinicid,
                         t.docid,
                         t.paytype,
                         t.info_center_id,
                         t.plan_code,
                         t.list_id,
                         t.finaldisc,
                         t.amount_1,
                         t.amount_2,
                         t.sub_paytype,
                         t.sub_paytype2,
                         nvl(t.pat_pay, 0),
                         nvl(t.comp_pay, 0),
                         nvl(t.vat_total_pat, 0),
                         nvl(t.vat_total_co, 0)
                    into :P48_PATIENTNO,
                         :P48_PATIENT_NAME,
                         :P48_MOBILE_NO,
                         :P48_COVERAGE_TYPE,
                         :P48_COMP_NAME,
                         :P48_CLASS_NAME,
                         :P48_CURR_CODE,
                         :P48_INV_DATE,
                         :P48_CLINICID,
                         :P48_DOCID,
                         :P48_PAYTYPE,
                         :P48_INFO_CENTER_ID,
                         :P48_PLAN_CODE,
                         :P48_LIST_ID,
                         :P48_FINALDISC,
                         :P48_AMOUNT_1,
                         :P48_AMOUNT_2,
                         :P48_SUB_PAYTYPE,
                         :P48_SUB_PAYTYPE2,
                         :P48_PAT_PAY,
                         :P48_COMP_PAY,
                         :P48_VAT_TOTAL_PAT,
                         :P48_VAT_TOTAL_CO
                    from t_inv t
                    left join patient p
                      on p.patientno = t.patientno
                    left join companys c
                      on c.comp_code = t.comp_code
                    left join disc_classes dc
                      on dc.comp_code  = t.sub_comp_code
                     and dc.class_code = t.class_code
                   where t.inv_no = :P48_INV_NO;
                
                  select nvl(sum(invoice_line.gross_amount), 0),
                         nvl(
                           sum(
                             greatest(
                               invoice_line.gross_amount
                                 - invoice_line.net_amount,
                               0
                             )
                           ),
                           0
                         ),
                         nvl(sum(invoice_line.net_amount), 0)
                    into :P48_TOTAL_GROSS,
                         :P48_TOTAL_DISCOUNT,
                         :P48_TOTAL_NET
                    from (
                      select nvl(
                               d.my_price,
                               nvl(d.price, 0) * nvl(d.qty, 1)
                             ) gross_amount,
                             nvl(
                               d.my_net,
                               nvl(
                                 d.my_price,
                                 nvl(d.price, 0) * nvl(d.qty, 1)
                               ) - nvl(d.my_disc, 0)
                             ) net_amount
                        from d_inv d
                       where d.inv_no = :P48_INV_NO
                         and nvl(d.is_deleted, 0) = 0
                    ) invoice_line;
                
                  :P48_MAX_DEDUCTIBLE := null;
                  
                  :P48_TOTAL_DISCOUNT :=
                    nvl(:P48_TOTAL_DISCOUNT, 0);
                
                  :P48_VAT_TOTAL_PAT :=
                    nvl(:P48_VAT_TOTAL_PAT, 0);
                
                  :P48_VAT_TOTAL_CO :=
                    nvl(:P48_VAT_TOTAL_CO, 0);
                
                  l_amount_due :=
                    greatest(
                        nvl(:P48_PAT_PAY, 0)
                      - nvl(:P48_FINALDISC, 0)
                      + nvl(:P48_VAT_TOTAL_PAT, 0),
                      0
                    );
                
                  :P48_AMOUNT_DUE := l_amount_due;  
                
                  l_total_paid :=
                      nvl(:P48_AMOUNT_1, 0)
                    + nvl(:P48_AMOUNT_2, 0);
                
                  :P48_REMAINING_AMOUNT :=
                    greatest(
                      l_amount_due - l_total_paid,
                      0
                    );
                
                  :P48_PAYMENT_STATUS :=
                    case
                      when l_amount_due = 0 then
                        'No Amount Due'
                      when l_total_paid > l_amount_due then
                        'Overpaid'
                      when l_total_paid = l_amount_due then
                        'Paid'
                      when l_total_paid > 0 then
                        'Partial'
                      else
                        'Unpaid'
                    end;
                
                exception
                  when no_data_found then
                    raise_application_error(
                      -20870,
                      'Invoice was not found for view mode. Invoice No: '
                        || :P48_INV_NO
                    );
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14944859642746801
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_MODE = 'VIEW'
                and :P48_INV_NO is not null
                ```
        }
    )

    process refresh-locked-invoice-preview (
        name: Refresh Locked Invoice Preview
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_totals bil_invoice_api.t_preview_totals;
                  l_result bil_import.t_import_result;
                
                begin
                  bil_invoice_api.build_import_preview_collection(
                    p_source_mode       => :P48_SOURCE_MODE,
                    p_patientno         => :P48_PATIENTNO,
                    p_paytype           => :P48_PAYTYPE,
                    p_clinicid          => :P48_CLINICID,
                    p_visit_unique      => :P48_VISIT_UNIQUE,
                    p_app_id            => :APP_ID,
                    p_app_session_id    => :APP_SESSION,
                    p_app_user          => :APP_USER,
                    p_inv_date          => sysdate,
                    p_seed_serviceid    => :P48_SEED_SERVICEID,
                    p_final_disc      => nvl(apex_session_state.get_number('P48_FINALDISC'),0),
                    p_amount_1        => nvl(apex_session_state.get_number('P48_AMOUNT_1'),0),
                    p_amount_2        => nvl(apex_session_state.get_number('P48_AMOUNT_2'),0),
                    p_amount_1_auto     => nvl(:P48_AMOUNT_1_AUTO, 'Y'),
                    p_collection_name   => bil_invoice_api.c_import_preview_collection,
                    p_docid           => :P48_DOCID,
                    p_new_visit_type  => :P48_NEW_VISIT_TYPE,
                    p_info_center_id  => :P48_INFO_CENTER_ID,
                    o_totals            => l_totals,
                    o_import_result     => l_result
                  );
                
                  :P48_TOTAL_GROSS :=
                    l_totals.total_gross;
                
                  :P48_TOTAL_DISCOUNT :=
                    l_totals.total_discount;
                
                  :P48_TOTAL_NET :=
                    l_totals.total_net;
                
                  :P48_PAT_PAY :=
                    l_totals.pat_pay;
                
                  :P48_COMP_PAY :=
                    l_totals.comp_pay;
                
                  :P48_VAT_TOTAL_PAT :=
                    l_totals.vat_total_pat;
                
                  :P48_VAT_TOTAL_CO :=
                    l_totals.vat_total_co;
                
                  :P48_AMOUNT_DUE :=
                    l_totals.cash_collected;
                
                  :P48_AMOUNT_1 :=
                    l_totals.amount_1;
                
                  :P48_AMOUNT_2 :=
                    l_totals.amount_2;
                
                  :P48_REMAINING_AMOUNT :=
                    l_totals.remaining_amount;
                
                  :P48_PAYMENT_STATUS :=
                    l_totals.payment_status;
                
                  apex_debug.message(
                    'BIL_IMPORT_PREVIEW_LINES count after build = %s, gross = %s, net = %s',
                    l_totals.line_count,
                    l_totals.total_gross,
                    l_totals.total_net
                  );
                end;
                ```
        }
        execution {
            sequence: 70
