    process classify-create-mode-patient-payer (
        name: Classify Create-Mode Patient Payer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_is_credit varchar2(1);
                begin
                  l_is_credit :=
                    patient_util.is_credit_patient(
                      p_patientno => :P48_PATIENTNO
                    );
                
                  :P48_IS_CREDIT_PATIENT :=
                    l_is_credit;
                
                  if l_is_credit = 'N' then
                    /*
                     * Page 56 must never send Credit for a Cash patient.
                     * Reject manipulation rather than silently accepting it.
                     */
                    if :P48_SOURCE_MODE = 'NEW_VISIT'
                       and :P48_PAYTYPE = 2
                    then
                      raise_application_error(
                        -20807,
                        'This Cash patient cannot use Insurance / Direct Contract.'
                      );
                    end if;
                
                    :P48_PAYTYPE :=
                      1;
                
                    :P48_COVERAGE_MODE :=
                      'CASH';
                
                    :P48_MANUAL_PAYTYPE :=
                      1;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 37600299692920613
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_PATIENTNO is not null
                and nvl(:P48_MODE, 'CREATE') <> 'VIEW'
                and nvl(:P48_SOURCE_MODE, 'MANUAL') <> 'REQUEST'
                ```
        }
    )

    process get-package-lines-for-ig (
        name: GET_PACKAGE_LINES_FOR_IG
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_service_desc    varchar2(4000);
                  l_service_display varchar2(4000);
                  l_lines           bil_import.t_import_line_tab;
                  l_result          bil_import.t_import_result;
                  l_idx             pls_integer;
                begin
                  if :P48_SOURCE_MODE is not null then
                    raise_application_error(
                      -20880,
                      'Package import is available only in manual invoice mode.'
                    );
                  end if;
                
                  if upper(nvl(:P48_MODE, 'CREATE')) = 'VIEW' then
                    raise_application_error(
                      -20881,
                      'Cannot import package lines in view mode.'
                    );
                  end if;
                
                  if :P48_PACKAGE_SERVICEID is null then
                    raise_application_error(
                      -20887,
                      'Package service is required.'
                    );
                  end if;
                
                  if :P48_LIST_ID is null then
                    raise_application_error(
                      -20888,
                      'Invoice price list is required.'
                    );
                  end if;
                
                  bil_invoice_api.get_package_lines(
                    p_package_serviceid => :P48_PACKAGE_SERVICEID,
                    p_list_id           => :P48_LIST_ID,
                    p_parent_source_id  => to_char(:P48_PACKAGE_SERVICEID),
                    o_lines             => l_lines,
                    o_result            => l_result
                  );
                
                  apex_json.open_object;
                
                  apex_json.write(
                    'success',
                    true
                  );
                
                  apex_json.write(
                    'message',
                    l_result.message
                  );
                
                  apex_json.open_array('lines');
                
                  l_idx := l_lines.first;
                
                  while l_idx is not null loop
                    /*
                     * Exact quantity is required by the package contract.
                     * Do not default it to one here.
                     */
                    if l_lines(l_idx).qty is null
                       or l_lines(l_idx).qty <= 0
                       or l_lines(l_idx).qty <> trunc(l_lines(l_idx).qty)
                    then
                      raise_application_error(
                        -20890,
                        'Package import returned an invalid quantity for service '
                        || l_lines(l_idx).serviceid
                        || '.'
                      );
                    end if;
                
                    /*
                     * Get the description directly from SERVICES.
                     *
                     * Do not depend on PRICE_PLAN_DTL merely to display the
                     * component description. FIXED_PRICE package components
                     * may correctly have no financial plan row.
                     */
                    begin
                      select trim(s.servicedesc),
                             trim(s.serviceid)
                            || case
                                when trim(s.servicedesc) is not null
                                then ' - ' || trim(s.servicedesc)
                                end
                        into l_service_desc,
                            l_service_display
                        from services s
                    where s.serviceid =
                            l_lines(l_idx).serviceid
                        and s.list_id =
                            :P48_LIST_ID;
                    exception
                    when no_data_found then
                        l_service_desc := null;
                
                        l_service_display :=
                        trim(l_lines(l_idx).serviceid);
                    end;
                
                    apex_json.open_object;
                
                    /* Import source */
                    apex_json.write(
                      'sourceType',
                      l_lines(l_idx).source_type
                    );
                
                    apex_json.write(
                      'sourceId',
                      l_lines(l_idx).source_id
                    );
                
                    /* Service */
                    apex_json.write(
                      'serviceId',
                      l_lines(l_idx).serviceid
                    );
                
                    apex_json.write(
                      'serviceDisplay',
                      l_service_display
                    );
                
                    apex_json.write(
                      'serviceDesc',
                      l_service_desc
                    );
                
                    /*
                     * Exact PACKAGE_DTL quantity.
                     * No NVL and no default-to-one behavior.
                     */
                    apex_json.write(
                      'qty',
                      l_lines(l_idx).qty
                    );
                
                    /*
                     * Manual discount inputs only.
                     *
                     * These must never contain plan discount or combined
                     * effective discount output.
                     */
                    apex_json.write(
                      'discountType',
                      l_lines(l_idx).discount_type
                    );
                
                    apex_json.write(
                      'disc',
                      l_lines(l_idx).disc
                    );
                
                    apex_json.write(
                      'myDisc',
                      l_lines(l_idx).my_disc
                    );
                
                    /*
                     * Package pricing is never represented as a price override.
                     * The backend should already return NULL / N.
                     */
                    apex_json.write(
                      'priceOverride',
                      l_lines(l_idx).price_override
                    );
                
                    apex_json.write(
                      'usePriceOverride',
                      l_lines(l_idx).has_price_override
                    );
                
                    /* Authoritative package identity */
                    apex_json.write(
                      'packageServiceId',
                      l_lines(l_idx).package_service_id
                    );
                
                    apex_json.write(
                      'packageInstanceId',
                      l_lines(l_idx).package_instance_id
                    );
                
                    apex_json.write(
                      'packageLineRole',
                      l_lines(l_idx).package_line_role
                    );
                
                    apex_json.write(
                      'packageComponentOrder',
                      l_lines(l_idx).package_component_order
                    );
                
                    apex_json.write(
                      'packageParentLineId',
                      l_lines(l_idx).package_parent_line_id
                    );
                
                    apex_json.write(
                      'packagePricingMethod',
                      l_lines(l_idx).package_pricing_method
                    );
                
                    apex_json.write(
                      'packageDefinitionToken',
                      l_lines(l_idx).package_definition_token
                    );
                
                    /* Backend-calculated eligibility */
                    apex_json.write(
                      'allowManualDiscount',
                      l_lines(l_idx).allow_manual_discount
                    );
                
                    apex_json.write(
                      'allowPriceOverride',
                      l_lines(l_idx).allow_price_override
                    );
                
                    apex_json.close_object;
                
                    l_idx := l_lines.next(l_idx);
                  end loop;
                
                  apex_json.close_array;
                  apex_json.close_object;
                
                exception
                  when others then
                    apex_debug.error(
                      'GET_PACKAGE_LINES_FOR_IG failed: %s',
                      sqlerrm
                    );
                
                    apex_json.open_object;
                    apex_json.write('success', false);
                
                    if sqlcode between -20999 and -20000 then
                      apex_json.write(
                        'message',
                        regexp_replace(
                          sqlerrm,
                          '^ORA-[0-9]{5}:[[:space:]]*',
                          ''
                        )
                      );
                    else
                      apex_json.write(
                        'message',
                        'Package services could not be loaded.'
                      );
                    end if;
                
                    apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 40
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 30889260933401703
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fnd_app_security.has_permission('BILLING_PATIENT_INVOICES_CREATE') = 'TRUE'
        }
    )

    process initialize-page (
        name: Initialize Page
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P48_MODE := upper(trim(nvl(:P48_MODE, 'CREATE')));
                    :P48_SOURCE_MODE := upper(trim(:P48_SOURCE_MODE));
                
                    if :P48_MODE = 'CREATE'
                    and fnd_app_security.has_permission(
                         'BILLING_PATIENT_INVOICES_CREATE'
                       ) <> 'TRUE'
                    then
                    raise_application_error(
                        -20802,
                        'You are not authorized to create patient invoices.'
                    );
                    end if;
                
                    if :P48_MODE not in ('CREATE', 'VIEW') then
                        raise_application_error(-20800, 'Invalid invoice page mode: ' || :P48_MODE);
                    end if;
                
                    if :P48_SOURCE_MODE is not null
                       and :P48_SOURCE_MODE not in ('REQUEST', 'NEW_VISIT') then
                        raise_application_error(-20801, 'Invalid invoice source mode: ' || :P48_SOURCE_MODE);
                    end if;
                
                    if :P48_DRAFT_ID is null then
                        :P48_DRAFT_ID := rawtohex(sys_guid());
                    end if;
                
                    :P48_DISPLAY_MODE :=
                        case
                            when :P48_MODE = 'VIEW' then 'Invoice View'
                            when :P48_SOURCE_MODE = 'REQUEST' then 'Service Request'
                            when :P48_SOURCE_MODE = 'NEW_VISIT' then 'New Visit'
                            else 'Create Invoice'
                        end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11938846867958012
        }
    )

    process invoice-services-save-interactive-grid-data (
        name: Save Draft- Save Interactive Grid Data
        type: executeCode
        editableRegion: @invoice_services
        source {
            plsqlCode:
                ```plsql
                declare
                  l_line_id                        bil_inv_draft_lines.line_id%type;
                  l_qty                            bil_inv_draft_lines.qty%type;
                  l_seq_no                         bil_inv_draft_lines.seq_no%type;
                  l_price_override                 bil_inv_draft_lines.price_override%type;
                  l_disc                           bil_inv_draft_lines.disc%type;
                  l_my_disc                        bil_inv_draft_lines.my_disc%type;
                  l_pat_serv_req_row_id            bil_inv_draft_lines.pat_serv_req_row_id%type;
                  l_approv_date                    bil_inv_draft_lines.approv_date%type;
                  l_approv_validity                bil_inv_draft_lines.approv_validity%type;
                  l_req_need_a                     bil_inv_draft_lines.req_need_a%type;
                  l_req_a_status                   bil_inv_draft_lines.req_a_status%type;
                  l_package_component_order        bil_inv_draft_lines.package_component_order%type;
                  l_package_parent_line_id         bil_inv_draft_lines.package_parent_line_id%type;
                  l_offer_id                       bil_inv_draft_lines.offer_id%type;
                  l_offer_dtl_id                   bil_inv_draft_lines.offer_dtl_id%type;
                  l_offer_type                     bil_inv_draft_lines.offer_type%type;
                  l_offer_parent_line_id           bil_inv_draft_lines.offer_parent_line_id%type;
                  l_offer_price_applied            bil_inv_draft_lines.offer_price_applied%type;
                  l_offer_dis_applied              bil_inv_draft_lines.offer_dis_applied%type;
                  l_offer_object_version_number    bil_inv_draft_lines.offer_object_version_number%type;
                  l_offer_dtl_object_version_number bil_inv_draft_lines.offer_dtl_object_version_number%type;
                
                function to_num (
                  p_value in varchar2,
                  p_label in varchar2
                ) return number
                is
                  l_value varchar2(4000);
                begin
                  l_value :=
                    trim(p_value);
                
                  if l_value is null then
                    return null;
                  end if;
                
                  /*
                   * Do not strip or rewrite characters.
                   * Let the current APEX/Oracle session globalization settings
                   * perform the numeric conversion.
                   */
                  return to_number(
                           l_value
                         );
                
                exception
                  when invalid_number
                     or value_error
                  then
                    raise_application_error(
                      -20970,
                      p_label ||
                      ' has an invalid numeric value.'
                    );
                end to_num;
                
                  function to_date_value (
                    p_value in varchar2,
                    p_label in varchar2
                  ) return date
                  is
                    l_value varchar2(4000) := trim(p_value);
                    l_date  date;
                  begin
                    if l_value is null then
                      return null;
                    end if;
                
                    begin
                      l_date := to_date(
                                  l_value,
                                  'YYYY-MM-DD"T"HH24:MI:SS'
                                );
                      return l_date;
                    exception
                      when others then
                        null;
                    end;
                
                    begin
                      l_date := cast(
                                  to_timestamp(
                                    l_value,
                                    'YYYY-MM-DD"T"HH24:MI:SS.FF'
                                  )
                                  as date
                                );
                      return l_date;
                    exception
                      when others then
                        null;
                    end;
                
                    begin
                      l_date := to_date(
                                  l_value,
                                  'YYYY-MM-DD'
                                );
                      return l_date;
                    exception
                      when others then
                        null;
                    end;
                
                    begin
                      l_date := to_date(
                                  l_value,
                                  'DD-MON-YYYY HH:MIPM',
                                  'NLS_DATE_LANGUAGE=English'
                                );
                      return l_date;
                    exception
                      when others then
                        null;
                    end;
                
                    begin
                      l_date := to_date(
                                  l_value,
                                  'DD-MON-YYYY',
                                  'NLS_DATE_LANGUAGE=English'
                                );
                      return l_date;
                    exception
                      when others then
                        null;
                    end;
                
                    raise_application_error(
                      -20971,
                      p_label || ' has an invalid date value.'
                    );
                  end to_date_value;
                
                  procedure assert_page_context
                  is
                  begin
                    if nvl(
                         fnd_app_security.has_permission(
                           'BILLING_PATIENT_INVOICES_CREATE'
                         ),
                         'FALSE'
                       ) <> 'TRUE'
                    then
                      raise_application_error(
                        -20802,
                        'You are not authorized to create patient invoices.'
                      );
                    end if;
                
                    if upper(nvl(:P48_MODE, 'CREATE')) <> 'CREATE'
                       or :P48_SOURCE_MODE is not null
                    then
                      raise_application_error(
                        -20972,
                        'Invoice draft lines can be changed only in manual create mode.'
                      );
                    end if;
                
                    if :P48_DRAFT_ID is null then
                      raise_application_error(
                        -20973,
                        'Invoice draft context is missing. Refresh the page.'
                      );
                    end if;
                  end assert_page_context;
                
                  procedure validate_write_values
                  is
                    l_discount_type      varchar2(1);
                    l_use_price_override varchar2(1);
                    l_is_bundle_parent   boolean := (
                      to_num(:OFFER_TYPE, 'Offer type') = 0
                      and upper(trim(:OFFER_LINE_ROLE)) = 'PARENT'
                    );
                  begin
                    if trim(:SERVICEID) is null
                       and not l_is_bundle_parent
                    then
                      raise_application_error(
                        -20974,
                        'Service is required except for bundled-offer parent rows.'
                      );
                    end if;
                
                    l_qty := to_num(
                               :QTY,
                               'Quantity'
                             );
                
                    if l_qty is null
                       or l_qty <= 0
                       or l_qty <> trunc(l_qty)
                    then
                      raise_application_error(
                        -20975,
                        'Quantity must be a positive whole number.'
                      );
                    end if;
                
                    l_discount_type :=
                      upper(
                        nvl(
                          trim(:DISCOUNT_TYPE),
                          'N'
                        )
                      );
                
                    if l_discount_type not in ('N', 'R', 'V') then
                      raise_application_error(
                        -20976,
                        'Invalid manual discount method.'
                      );
                    end if;
                
                    l_use_price_override :=
                      upper(
                        nvl(
                          trim(:USE_PRICE_OVERRIDE),
                          'N'
                        )
                      );
                
                    if l_use_price_override not in ('N', 'Y') then
                      raise_application_error(
                        -20977,
                        'Invalid price override flag.'
                      );
                    end if;
                
                    /*
                     * Package metadata must fail closed at draft persistence time. The invoice
                     * engine still performs the authoritative package structure validation.
                     */
                    if trim(:PACKAGE_SERVICE_ID) is not null then
                      if trim(:PACKAGE_INSTANCE_ID) is null
                         or upper(trim(:PACKAGE_LINE_ROLE)) not in ('PARENT', 'COMPONENT')
                         or trim(:PACKAGE_DEFINITION_TOKEN) is null
                      then
                        raise_application_error(
                          -20978,
                          'Package line metadata is incomplete. Remove and reimport the package.'
                        );
                      end if;
                    elsif trim(:PACKAGE_INSTANCE_ID) is not null
                       or trim(:PACKAGE_LINE_ROLE) is not null
                       or trim(:PACKAGE_DEFINITION_TOKEN) is not null
                    then
                      raise_application_error(
                        -20979,
                        'Package metadata was submitted without a package service.'
                      );
                    end if;
                
                    /*
                     * Convert all browser values in PL/SQL before entering INSERT/UPDATE SQL.
                     * Local PL/SQL functions such as TO_NUM and TO_DATE_VALUE cannot be called
                     * from the SQL statement itself in this APEX process context.
                     */
                    l_seq_no :=
                      to_num(:SEQ_NO, 'Sequence number');
                
                    l_price_override :=
                      to_num(:PRICE_OVERRIDE, 'Price override');
                
                    l_disc :=
                      nvl(
                        to_num(:DISC, 'Manual discount percentage'),
                        0
                      );
                
                    l_my_disc :=
                      to_num(:MY_DISC, 'Manual discount amount');
                
                    l_pat_serv_req_row_id :=
                      to_num(:PAT_SERV_REQ_ROW_ID, 'Requested service row ID');
                
                    l_approv_date :=
                      to_date_value(:APPROV_DATE, 'Approval date');
                
                    l_approv_validity :=
                      to_num(:APPROV_VALIDITY, 'Approval validity');
                
                    l_req_need_a :=
                      to_num(:REQ_NEED_A, 'Approval-required flag');
                
                    l_req_a_status :=
                      to_num(:REQ_A_STATUS, 'Approval status');
                
                    l_package_component_order :=
                      to_num(:PACKAGE_COMPONENT_ORDER, 'Package component order');
                
                    l_package_parent_line_id :=
                      to_num(:PACKAGE_PARENT_LINE_ID, 'Package parent line ID');
                
                    l_offer_id :=
                      to_num(:OFFER_ID, 'Offer ID');
                
                    l_offer_dtl_id :=
                      to_num(:OFFER_DTL_ID, 'Offer detail ID');
                
                    l_offer_type :=
                      to_num(:OFFER_TYPE, 'Offer type');
                
                    l_offer_parent_line_id :=
                      to_num(:OFFER_PARENT_LINE_ID, 'Offer parent line ID');
                
                    l_offer_price_applied :=
                      to_num(:OFFER_PRICE_APPLIED, 'Applied offer price');
                
                    l_offer_dis_applied :=
                      to_num(:OFFER_DIS_APPLIED, 'Applied offer discount');
                
                    l_offer_object_version_number :=
                      to_num(:OFFER_OBJECT_VERSION_NUMBER, 'Offer version');
                
                    l_offer_dtl_object_version_number :=
                      to_num(:OFFER_DTL_OBJECT_VERSION_NUMBER, 'Offer detail version');
                  end validate_write_values;
                
                  procedure lock_owned_line
                  is
                  begin
                    l_line_id := to_num(
                                   :LINE_ID,
                                   'Invoice line ID'
                                 );
                
                    if l_line_id is null then
                      raise_application_error(
                        -20980,
                        'Invoice line ID is missing.'
                      );
                    end if;
                
                    select d.line_id
                      into l_line_id
                      from bil_inv_draft_lines d
                     where d.line_id        = l_line_id
                       and d.app_session_id = to_char(:APP_SESSION)
                       and d.draft_id       = :P48_DRAFT_ID
                       for update;
                  exception
                    when no_data_found then
                      raise_application_error(
                        -20981,
                        'This invoice line no longer belongs to the current draft. Refresh the page.'
                      );
                    when too_many_rows then
                      raise_application_error(
                        -20982,
                        'Duplicate invoice draft line identity was detected.'
                      );
                  end lock_owned_line;
                
                begin
                  assert_page_context;
                
                  case :APEX$ROW_STATUS
                    when 'C' then
                      validate_write_values;
                
                      insert into bil_inv_draft_lines (
                        app_session_id,
                        draft_id,
                        seq_no,
                        source_type,
                        source_id,
                        serviceid,
                        servicedesc,
                        qty,
                        price_override,
                        use_price_override,
                        discount_type,
                        disc,
                        my_disc,
                        teeth_no,
                        tooth_surface,
                        teeth_no2,
                        pat_serv_req_row_id,
                        approv_date,
                        approv_validity,
                        approv_ref_no,
                        claim_no,
                        req_need_a,
                        req_a_status,
                        info_center_id,
                        package_service_id,
                        package_instance_id,
                        package_line_role,
                        package_component_order,
                        package_parent_line_id,
                        package_definition_token,
                        offer_id,
                        offer_dtl_id,
                        offer_type,
                        offer_instance_id,
                        offer_line_role,
                        offer_parent_line_id,
                        offer_price_applied,
                        offer_dis_applied,
                        offer_name_snapshot,
                        offer_object_version_number,
                        offer_dtl_object_version_number
                      ) values (
                        to_char(:APP_SESSION),
                        :P48_DRAFT_ID,
                        l_seq_no,
                        trim(:SOURCE_TYPE),
                        trim(:SOURCE_ID),
                        trim(:SERVICEID),
                        trim(:SERVICEDESC),
                        l_qty,
                        l_price_override,
                        upper(nvl(trim(:USE_PRICE_OVERRIDE), 'N')),
                        upper(nvl(trim(:DISCOUNT_TYPE), 'N')),
                        l_disc,
                        l_my_disc,
                        trim(:TEETH_NO),
                        trim(:TOOTH_SURFACE),
                        trim(:TEETH_NO2),
                        l_pat_serv_req_row_id,
                        l_approv_date,
                        l_approv_validity,
                        trim(:APPROV_REF_NO),
                        trim(:CLAIM_NO),
                        l_req_need_a,
                        l_req_a_status,
                        :P48_INFO_CENTER_ID,
                        trim(:PACKAGE_SERVICE_ID),
                        trim(:PACKAGE_INSTANCE_ID),
                        upper(trim(:PACKAGE_LINE_ROLE)),
                        l_package_component_order,
                        l_package_parent_line_id,
                        trim(:PACKAGE_DEFINITION_TOKEN),
                        l_offer_id,
                        l_offer_dtl_id,
                        l_offer_type,
                        trim(:OFFER_INSTANCE_ID),
                        upper(trim(:OFFER_LINE_ROLE)),
                        l_offer_parent_line_id,
                        l_offer_price_applied,
                        l_offer_dis_applied,
                        trim(:OFFER_NAME_SNAPSHOT),
                        l_offer_object_version_number,
                        l_offer_dtl_object_version_number
                      )
                      returning line_id
                           into l_line_id;
                
                      :LINE_ID := l_line_id;
                
                    when 'U' then
                      validate_write_values;
                      lock_owned_line;
                
                      update bil_inv_draft_lines d
                         set d.seq_no                          = l_seq_no,
                             d.source_type                     = trim(:SOURCE_TYPE),
                             d.source_id                       = trim(:SOURCE_ID),
                             d.serviceid                       = trim(:SERVICEID),
                             d.servicedesc                     = trim(:SERVICEDESC),
                             d.qty                             = l_qty,
                             d.price_override                  = l_price_override,
                             d.use_price_override              = upper(nvl(trim(:USE_PRICE_OVERRIDE), 'N')),
                             d.discount_type                   = upper(nvl(trim(:DISCOUNT_TYPE), 'N')),
                             d.disc                            = l_disc,
                             d.my_disc                         = l_my_disc,
                             d.teeth_no                        = trim(:TEETH_NO),
                             d.tooth_surface                   = trim(:TOOTH_SURFACE),
                             d.teeth_no2                       = trim(:TEETH_NO2),
                             d.pat_serv_req_row_id              = l_pat_serv_req_row_id,
                             d.approv_date                      = l_approv_date,
                             d.approv_validity                  = l_approv_validity,
                             d.approv_ref_no                    = trim(:APPROV_REF_NO),
                             d.claim_no                         = trim(:CLAIM_NO),
                             d.req_need_a                       = l_req_need_a,
                             d.req_a_status                     = l_req_a_status,
                             d.info_center_id                   = :P48_INFO_CENTER_ID,
                             d.package_service_id               = trim(:PACKAGE_SERVICE_ID),
                             d.package_instance_id              = trim(:PACKAGE_INSTANCE_ID),
                             d.package_line_role                = upper(trim(:PACKAGE_LINE_ROLE)),
                             d.package_component_order          = l_package_component_order,
                             d.package_parent_line_id            = l_package_parent_line_id,
                             d.package_definition_token          = trim(:PACKAGE_DEFINITION_TOKEN),
                             d.offer_id                          = l_offer_id,
                             d.offer_dtl_id                      = l_offer_dtl_id,
                             d.offer_type                        = l_offer_type,
                             d.offer_instance_id                 = trim(:OFFER_INSTANCE_ID),
                             d.offer_line_role                   = upper(trim(:OFFER_LINE_ROLE)),
                             d.offer_parent_line_id              = l_offer_parent_line_id,
                             d.offer_price_applied               = l_offer_price_applied,
                             d.offer_dis_applied                 = l_offer_dis_applied,
                             d.offer_name_snapshot               = trim(:OFFER_NAME_SNAPSHOT),
                             d.offer_object_version_number       = l_offer_object_version_number,
                             d.offer_dtl_object_version_number   = l_offer_dtl_object_version_number
                       where d.line_id        = l_line_id
                         and d.app_session_id = to_char(:APP_SESSION)
                         and d.draft_id       = :P48_DRAFT_ID;
                
                      if sql%rowcount <> 1 then
                        raise_application_error(
                          -20983,
                          'Invoice line update was rejected because the draft ownership changed.'
                        );
                      end if;
                
                    when 'D' then
                      lock_owned_line;
                
                      delete from bil_inv_draft_lines d
                       where d.line_id        = l_line_id
                         and d.app_session_id = to_char(:APP_SESSION)
                         and d.draft_id       = :P48_DRAFT_ID;
                
                      if sql%rowcount <> 1 then
                        raise_application_error(
                          -20984,
                          'Invoice line delete was rejected because the draft ownership changed.'
                        );
                      end if;
                
                    else
                      raise_application_error(
                        -20985,
                        'Unsupported invoice-line operation.'
                      );
                  end case;
                exception
                  when others then
                    apex_debug.error(
                      'Page 48 draft DML failed. status=%s line_id=%s draft_id=%s error=%s',
                      :APEX$ROW_STATUS,
                      :LINE_ID,
                      :P48_DRAFT_ID,
                      sqlerrm
                    );
                    raise;
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 11958326978336021
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
