    validation amount-discount-cannot-use-percent (
        name: Amount Discount Cannot Use Percent
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @invoice_services
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if nvl(:OFFER_TYPE, -1) = 0 then
                  return true;
                end if;
                
                return not (
                  nvl(:DISCOUNT_TYPE, 'R') = 'V'
                  and nvl(:DISC, 0) <> 0
                );
                ```
        }
        error {
            errorMessage: Discount amount method expects Discount Amount; clear discount percent.
            associatedColumn: DISC
        }
    )

    validation discount-amount-non-negative (
        name: Discount Amount Non-Negative
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @invoice_services
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if nvl(:OFFER_TYPE, -1) = 0 then
                  return true;
                end if;
                
                return nvl(:MY_DISC, 0) >= 0;
                ```
        }
        error {
            errorMessage: Discount amount cannot be negative.
            associatedColumn: MY_DISC
        }
    )

    validation discount-percentage-range (
        name: Discount Percentage Range
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @invoice_services
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if nvl(:OFFER_TYPE, -1) = 0 then
                  return true;
                end if;
                
                return nvl(:DISC, 0) between 0 and 100;
                ```
        }
        error {
            errorMessage: Discount percentage must be between 0 and 100.
            associatedColumn: DISC
        }
    )

    validation doctor-belongs-to-specialty (
        name: Doctor Belongs To Specialty
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  l_exists number;
                begin
                  if :P48_CLINICID is null
                     or :P48_DOCID is null
                  then
                    return null;
                  end if;
                
                  select count(*)
                    into l_exists
                    from doctors
                   where docid    = :P48_DOCID
                     and clinicid = :P48_CLINICID
                     and nvl(doc_active, 1) <> 0;
                
                  if l_exists = 0 then
                    return 'Selected doctor does not belong to the selected specialty.';
                  end if;
                
                  return null;
                end;
                ```
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE_INVOICE,CREATE_INVOICE_AND_PRINT
        }
    )

    validation no-discount-requires-zero-values (
        name: No Discount Requires Zero Values
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @invoice_services
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if nvl(:OFFER_TYPE, -1) = 0 then
                  return true;
                end if;
                
                return not (
                  :DISCOUNT_TYPE = 'N'
                  and (nvl(:DISC, 0) <> 0 or nvl(:MY_DISC, 0) <> 0)
                );
                ```
        }
        error {
            errorMessage: No discount selected; clear discount percent and discount amount.
            displayLocation: inlineInNotification
            associatedColumn: DISCOUNT_TYPE
        }
    )

