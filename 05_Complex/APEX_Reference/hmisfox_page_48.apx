    region invoice_services_view (
        name: Invoice Services View
        title: Invoice Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.serviceid || ' - ' || d.servicedesc as service,
                       d.qty                                   as quantity,
                       d.price                                 as unit_price,
                       d.my_price                              as gross_amount,
                       nvl(d.disc, 0)                          as effective_discount_pct,
                       nvl(d.my_disc, 0)                       as total_discount_amount,
                       d.my_net                                as net_amount,
                       d.the_pay                               as patient_share,
                       d.vat_val_pat                           as patient_vat,
                       d.the_comp                              as provider_share,
                       d.vat_val_co                            as provider_vat
                  from d_inv d
                  join t_inv t
                    on t.inv_no = d.inv_no
                 where d.inv_no = :P48_INV_NO
                   and bil_invoice_access.has_access(t.inv_no, 'VIEW') = 'Y'
                   and nvl(d.is_deleted, 0) = 0
                 order by d.d_inv_row_id
                ```
        }
        layout {
            sequence: 80
            parentRegion: @container
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            htmlDomId: invoice_services_view
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P48_MODE = 'VIEW'
                and :P48_INV_NO is not null
                ```
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
            ]
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: No services found for this invoice.
        }
        componentAdvanced {
            stripHtml: true
        }

        column EFFECTIVE_DISCOUNT_PCT (
