    pageItem P48_OFFER_ID (
        type: popupLov
        label {
            label: Bundled Offer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.offer_name as d,
                       o.oferid     as r
                  from offers o
                 where :P48_PAYTYPE = '1'
                   and o.offer_type = 0
                   and nvl(o.is_deleted, 'N') = 'N'
                   and sysdate >= o.start_date
                   and sysdate <  o.enddate + 1
                   and (
                         :P48_INFO_CENTER_ID is null
                         or trim(o.offer_info_center) = trim(:P48_INFO_CENTER_ID)
                       )
                   and exists (
                         select 1
                           from offers_dtl d
                          where d.oferid = o.oferid
                            and d.list_id = o.list_id
                            and nvl(d.is_deleted, 'N') = 'N'
                       )
                 order by upper(o.offer_name), o.oferid
                ```
        }
        cascadingLov {
            parentItems: [
                P48_PAYTYPE
                P48_INFO_CENTER_ID
            ]
        }
        layout {
            sequence: 20
            region: @import-offer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

