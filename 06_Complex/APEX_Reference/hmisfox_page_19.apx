    region add-edit-patient (
        name: Add / Edit Patient
        title: Patient Info
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select PATIENTNO,
                       PATIENTNAME,
                       FILE_DATE,
                       SIX,
                       ISSTOP,
                       NATID,
                       COMP_CODE,
                       REM,
                       INS_NUMBER,
                       PHONE_W,
                       PHONE_H,
                       IQAMA_NO,
                       ADDRESS,
                       BDATE,
                       P_NAME_AR,
                       FATHER_NAME_AR,
                       GRAND_F_NAME_AR,
                       FAMILY_NAME_AR,
                       P_NAME_EN,
                       FATHER_NAME_EN,
                       GRAND_F_NAME_EN,
                       FAMILY_NAME_EN,
                       PATIENTNAME_AR,
                       CLASS_CODE,
                       SUB_COMP_CODE,
                       USER_NO,
                       MAR_STATUS,
                       NOK_NAME,
                       NOK_MOBILE,
                       RELATIVE_ID,
                       THE_EMAIL,
                       RELAG_ID,
                       CARD_START,
                       CARD_END,
                       UPD_BY,
                       LAST_UPD_DATE,
                       PAT_POLICY_NO,
                       XGROUP,
                       CARDREVISIONNO,
                       CARDINDICATOR,
                       MAINMEMBER,
                       RELATIONCODE,
                       MEMBER_ID,
                       CARD_ID,
                       ARAMCO_MR_NO,
                       INFO_CENTER_ID,
                       PASSPORT_NO,
                       OCCUPATION_TYPE_ID,
                       POSTAL_CODE,
                       FILE_EXPIRE_DATE,
                       PASS_BORDER_NO,
                       VISIT_TYPE,
                       OTP_PASS,
                       IS_NEW_BORN,
                       EMERGENCY_CONTACT_NAME,
                       EMERGENCY_RELATION_ID,
                       EMERGENCY_MOBILE,
                       PARENT_PATIENT_NO,
                       IS_EXTERNAL_REFERRAL,
                       OBJECT_VERSION_NUMBER,
                       COVERAGE_TYPE
                  from PATIENT
                 where PATIENTNO <> '1'
                 and PATIENTNO = :P19_PATIENTNO
                ```
            pageItemsToSubmit: P19_PATIENTNO
        }
        layout {
            sequence: 20
            parentRegion: @new-3
            slot: subRegions
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

