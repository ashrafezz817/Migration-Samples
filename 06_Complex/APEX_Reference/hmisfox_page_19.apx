    region patient-header (
        name: Patient Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ph-card">
                
                  <div class="ph-main">
                
                    <!-- =====================================================
                         PATIENT IDENTITY
                         ===================================================== -->
                    <div class="ph-left">
                
                      <span
                        class="ph-corner-badge app-badge app-badge--secondary app-badge--light app-badge--sm"
                        id="ph_status"
                      >-</span>
                
                      <div class="ph-names">
                        <h1 class="ph-name-en" id="ph_name_en">-</h1>
                        <div class="ph-name-ar" id="ph_name_ar">-</div>
                      </div>
                
                      <div class="ph-mrn">
                        <span class="ph-label">MRN</span>
                        <span class="ph-mrn-value" id="ph_mrn">-</span>
                      </div>
                
                      <div class="ph-meta">
                
                        <div class="ph-meta-item">
                          <span class="ph-label">ID / Iqama</span>
                          <span class="ph-value" id="ph_iqama">-</span>
                        </div>
                
                        <div class="ph-meta-item ph-meta-item--age">
                          <span class="ph-label">Age</span>
                          <span class="ph-value" id="ph_age">-</span>
                        </div>
                
                        <div class="ph-meta-item">
                          <span class="ph-label">Mobile</span>
                          <span class="ph-value" id="ph_mobile">-</span>
                        </div>
                
                      </div>
                
                    </div>
                
                
                    <!-- =====================================================
                         INSURANCE
                         ===================================================== -->
                <div class="ph-ins-card" id="ph_ins_card">
                
                  <div class="ph-ins-bg"></div>
                
                  <span
                    class="ph-ins-validity app-badge app-badge--secondary app-badge--light app-badge--xs"
                    id="ph_ins_validity_badge"
                  >-</span>
                
                  <div class="ph-ins-header">
                    <div class="ph-ins-kicker">Insurance Card</div>
                    <div class="ph-ins-company" id="ph_ins_company">-</div>
                  </div>
                
                  <div class="ph-ins-number-wrap">
                    <span class="ph-ins-label">Subscriber ID</span>
                    <span class="ph-ins-number" id="ph_ins_number">-</span>
                  </div>
                
                  <div class="ph-ins-policy">
                    <span class="ph-ins-label">Policy</span>
                    <span class="ph-ins-policy-value" id="ph_policy">-</span>
                  </div>
                
                  <div class="ph-ins-details">
                
                    <div class="ph-ins-detail">
                      <span class="ph-ins-label">Class</span>
                      <span class="ph-ins-value" id="ph_class_code">-</span>
                    </div>
                
                    <div class="ph-ins-detail">
                      <span class="ph-ins-label">Relationship to Subscriber</span>
                      <span class="ph-ins-value" id="ph_relation_code">-</span>
                    </div>
                
                    <div class="ph-ins-detail">
                      <span class="ph-ins-label">Valid From</span>
                      <span class="ph-ins-value" id="ph_card_start">-</span>
                    </div>
                
                    <div class="ph-ins-detail">
                      <span class="ph-ins-label">Valid To</span>
                      <span class="ph-ins-value" id="ph_card_end">-</span>
                    </div>
                
                  </div>
                
                </div>
                
                  </div>
                
                </div>
                ```
        }
        layout {
            sequence: 30
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: patient_hdr
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P19_MODE in ('VIEW','EDIT') and :P19_PATIENTNO is not null
        }
    )

