    validation validate-id-iqama-number-format (
        name: Validate ID / Iqama Number Format
        execution {
            sequence: 70
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_doc_no varchar2(50);
                begin
                    if :P19_IQAMA_NO is null then
                        return null;
                    end if;
                
                    l_doc_no := trim(:P19_IQAMA_NO);
                
                    if not regexp_like(l_doc_no, '^[0-9]{10}$') then
                        return 'National ID / Iqama number must be 10 digits.';
                    end if;
                
                    if substr(l_doc_no, 1, 1) not in ('1', '2') then
                        return 'National ID must start with 1 and Iqama number must start with 2.';
                    end if;
                
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P19_IQAMA_NO
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_EDIT,SAVE_CREATE
        }
    )

