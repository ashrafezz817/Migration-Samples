              font-weight: 800;
            
              letter-spacing: .05em;
            
              color: #FFFFFF;
            }
            
            /* =========================================================
               POLICY
               ========================================================= */
            
            #patient_hdr .ph-ins-policy {
              margin-top: 12px;
              min-width: 0;
            }
            
            #patient_hdr .ph-ins-policy-value {
              display: block;
            
              font-size: 12px;
              line-height: 1.25;
              font-weight: 700;
            
              color: #FFFFFF;
            
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }
            
            
            /* =========================================================
               INSURANCE TERTIARY DETAILS
               ========================================================= */
            
            #patient_hdr .ph-ins-details {
              display: grid;
            
              grid-template-columns:
                64px
                minmax(125px, 1.4fr)
                90px
                90px;
            
              gap: 11px 14px;
            
              margin-top: 14px;
            }
            
            
            #patient_hdr .ph-ins-detail {
              min-width: 0;
            }
            
            
            #patient_hdr .ph-ins-value {
              display: block;
            
              font-size: 12px;
              line-height: 1.25;
              font-weight: 700;
            
              color: #FFFFFF;
            
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }
            
            
            /* =========================================================
               RESPONSIVE
               ========================================================= */
            
            @media (max-width: 1200px) {
            
              #patient_hdr .ph-main {
                grid-template-columns: 1fr;
                gap: 16px;
              }
            
              #patient_hdr .ph-left,
              #patient_hdr .ph-ins-card {
                grid-column: 1;
            
                height: auto;
                min-height: 220px;
              }
            
              #patient_hdr .ph-ins-card {
                justify-self: start;
              }
            }
            
            
            @media (max-width: 700px) {
            
              #patient_hdr .ph-meta {
                grid-template-columns: 1fr 1fr;
                gap: 16px 24px;
              }
            
              #patient_hdr .ph-meta-item--age {
                grid-column: span 2;
              }
            
              #patient_hdr .ph-value {
                white-space: normal;
              }
            
              #patient_hdr .ph-ins-card {
                width: 100%;
              }
            
              #patient_hdr .ph-ins-details {
                grid-template-columns: 1fr 1fr;
              }
            }
            /* ================= P19_IS_NEW_BORN  ================ */
            #P19_IS_NEW_BORN_CONTAINER .t-Form-fieldContainer {
              display: flex !important;
              align-items: center !important;
              justify-content: flex-start !important;
              flex-wrap: nowrap !important;
              gap: 12px !important;
            }
            
            #P19_IS_NEW_BORN_CONTAINER .t-Form-labelContainer {
              width: auto !important;
              min-width: max-content !important;
              padding: 0 !important;
              margin: 1.5px !important;
              flex: 0 0 auto !important;
            }
            
            #P19_IS_NEW_BORN_CONTAINER .t-Form-inputContainer {
              width: auto !important;
              padding: 0 !important;
              margin: 0 !important;
              flex: 0 0 auto !important;
            }
            
            #P19_IS_NEW_BORN_CONTAINER .t-Form-label {
              margin: 0 !important;
              white-space: nowrap !important;
              display: inline-block !important;
            }
            
            #P19_IS_NEW_BORN_CONTAINER .apex-item-group,
            #P19_IS_NEW_BORN_CONTAINER .apex-item-option {
              margin: 0 !important;
            }
            
            /* ================= Newborn mode locked field indicators ================ */
            
            #pri_ident_card.is-newborn-mode .is-newborn-locked .apex-item-disabled,
            #pri_ident_card.is-newborn-mode .is-newborn-locked input:disabled,
            #pri_ident_card.is-newborn-mode .is-newborn-locked select:disabled,
            #pri_ident_card.is-newborn-mode .is-newborn-locked textarea:disabled {
              opacity: .65 !important;
            }
            
            #pri_ident_card.is-newborn-mode .is-newborn-locked .t-Form-label {
              opacity: .65;
            }
            
            #pri_ident_card.is-newborn-mode .is-newborn-locked .t-Form-label:after {
              content: "  • Newborn mode";
              font-size: 0.75rem;
              font-weight: 500;
              opacity: 0.75;
            }
            
            /* ================= Parent MRN inactive state ================
               Purpose:
               - Dims Parent MRN label when newborn mode is off.
               - Indicates that the field is only relevant for newborn registration.
               - This is visual only; enable/disable behavior is controlled by
                 Newborn UI Sync JavaScript.
               ============================================================ */
            
            #P19_PARENT_PATIENT_NO_CONTAINER.parent-mrn-inactive .t-Form-label {
              opacity: .65;
            }
            
            #P19_PARENT_PATIENT_NO_CONTAINER.parent-mrn-inactive .t-Form-label:after {
              content: "  • Newborn only";
              font-size: 0.75rem;
              font-weight: 500;
              opacity: 0.75;
            }
            
            #P19_PARENT_PATIENT_NO_CONTAINER.parent-mrn-locked .t-Form-label {
              opacity: .65;
            }
            
            /* ================= file note highlight  ================ */
            /* File-note marker: keep native tab shape, no border */
            .apex-rds li.has-file-note {
              position: relative;
            }
            
            .apex-rds li.has-file-note > a,
            .apex-rds li.has-file-note > button {
              position: relative;
              border-radius: inherit !important;
            }
            
            /* Not active: no border, just orange text */
            .apex-rds li.has-file-note:not(.is-active) > a,
            .apex-rds li.has-file-note:not(.is-active) > button {
              background: transparent !important;
              color: #c2410c !important;
              box-shadow: none !important;
              font-weight: 600;
            }
            
            /* Small orange dot */
            .apex-rds li.has-file-note > a::after,
            .apex-rds li.has-file-note > button::after {
              content: "";
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-left: 8px;
              border-radius: 50%;
              background: #ea580c;
              vertical-align: middle;
            }
            
            /* Active tab: keep native active look */
            .apex-rds li.has-file-note.is-active > a,
            .apex-rds li.has-file-note.is-active > button {
              box-shadow: none !important;
            }
            
            /* ================= MRN field auto/manual mode styling ================ */
            
            #P19_PATIENTNO_CONTAINER.mrn-auto-mode .t-Form-label:after {
              content: "  • Auto-generated";
              font-size: 0.75rem;
              font-weight: 500;
              opacity: 0.75;
            }
            
            #P19_PATIENTNO_CONTAINER.mrn-locked-mode .t-Form-label:after {
              content: "  • Locked";
              font-size: 0.75rem;
              font-weight: 500;
              opacity: 0.75;
            }
            
            /* ================= Referral mode inactive field indicators ================
               Purpose:
               - Dims File Expiry Date label when External Referral is off.
               - No extra text is added.
               - This is visual only; enable/disable behavior is controlled by
                 Referral UI Sync JavaScript and server-side package logic.
               ======================================================================== */
            
            #P19_FILE_EXPIRE_DATE_CONTAINER.referral-expiry-inactive .t-Form-label {
              opacity: .65;
            }
            
            .pd-trans-picks--rtl {
              direction: rtl;
              text-align: right;
            }
            
            #send_otp.app-badge--success:disabled {
                opacity: 1 !important;
                filter: none !important;
                cursor: default;
            }
            
            #send_otp:not(.p19-mobile-verification-ready) {
                visibility: hidden;
            }
            ```
    }
