    dynamicAction new-12 (
        name: New_4
        execution {
            sequence: 70
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: button
            button: @elligability-and-retival
        }

        action native-alert (
            action: alert
            settings {
                title: Message
                message: توع الهوية اجبارى
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P19_VISIT_TYPE
            }
        )

        action native-alert-2 (
            action: alert
            settings {
                title: Message
                message: رقم الهوية-الاقامة-الجواز اجبارى
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P19_IQAMA_NO
            }
        )

        action native-alert-3 (
            action: alert
            settings {
                title: Message
                message: تاريخ الميلاد اجبارى
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P19_BDATE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE 
                    	V_BDATE VARCHAR2(20);
                    	V_TPA VARCHAR2(20);
                    	V_RESLUT CHAR(1);
                    	V_TMP NUMBER;
                    
                        BEGIN 
                    	if :P19_VISIT_TYPE is null then
                    	     
                    	    return;
                    	end if;
                    	if :P19_IQAMA_NO is null then
                    	   
                    	    return;
                    	end if;
                    	if :P19_bdate is null then
                    	     
                    	    return;
                    	end if;
                    
                        BEGIN 
                    		SELECT SUBSTR(TO_CHAR(:P19_BDATE,'DD/MM/YYYY'),7,4) || '-' ||
                    		SUBSTR(TO_CHAR(:P19_BDATE,'DD/MM/YYYY'),4,2) || '-' ||
                    		SUBSTR(TO_CHAR(:P19_BDATE,'DD/MM/YYYY'),1,2)
                    		INTO V_BDATE FROM DUAL;
                    		EXCEPTION
                    		WHEN OTHERS THEN
                    		NULL;
                    	
                    	END;
                      BEGIN
                    	   IF NOT :P19_XGROUP IS NULL THEN
                    			SELECT NPHIES_PAYER_ID
                    		  INTO V_TPA
                    			FROM COMPANYS WHERE COMP_CODE=:P19_XGROUP;
                    		END IF;
                    		EXCEPTION
                    		WHEN OTHERS THEN
                    		NULL;
                    	
                    	END;	
                       
                    
                        MAIN_CALL_ELIGBILIT_CASE_2(
                        :P19_VISIT_TYPE, 
                        :P19_IQAMA_NO,
                        V_BDATE,
                        V_TPA,
                        v_RESLUT);
                           IF v_RESLUT <> 1  THEN 
                       return ; 
                       end if ; 
                    
                      EXCEPTION WHEN OTHERS THEN 
                      RAISE_APPLICATION_ERROR (-20001 ,'Erorr= ' || sqlerrm );
                     END ; 
                    ```
                itemsToSubmit: [
                    P19_BDATE
                    P19_VISIT_TYPE
                    P19_IQAMA_NO
                ]
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.navigation.redirect(
                        "f?p=100:70:&APP_SESSION.::NO::P70_DOCUMENT_ID:" + $v("P19_IQAMA_NO")
                    );
                    
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction new-13 (
        name: New_12
        execution {
            sequence: 190
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: button
            button: @new-visit
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    v_date  date;
                    v_today_Date date;
                    begin
                    if not :p19_INS_NUMBER is null then 
                    select to_date(to_char(sysdate,'DD/MM/YYYY'),'DD/MM/YYYY') into v_today_Date from dual;
                    if :p19_CARD_END < v_today_Date   then
                    
                    :p19_comp_code := 0;
                    :p19_SUB_COMP_CODE := null;
                    :p19_class_code := null;
                    :p19_INS_NUMBER := null;
                    :p19_PAT_POLICY_NO := null;
                    :p19_CARD_START := null;
                    :p19_CARD_END := null;
                    :p19_CARDINDICATOR := null;
                    :p19_CARDREVISIONNO := null;
                    :p19_RELATIONCODE := null;
                    :p19_MAINMEMBER := null;
                    
                    end if;
                    elsif :p19_comp_code <> '0' and  :p19_INS_NUMBER is null then 
                    
                    select contend,to_date(to_char(sysdate,'DD/MM/YYYY'),'DD/MM/YYYY') into v_date,v_today_Date from companys
                    where comp_code=:p19_comp_code ;
                    if v_date < v_today_Date   then
                    :p19_comp_code := 0;
                    :p19_SUB_COMP_CODE := null;
                    :p19_class_code := null;
                    :p19_INS_NUMBER := null;
                    :p19_PAT_POLICY_NO := null;
                    :p19_CARD_START := null;
                    :p19_CARD_END := null;
                    :p19_CARDINDICATOR := null;
                    :p19_CARDREVISIONNO := null;
                    :p19_RELATIONCODE := null;
                    :p19_MAINMEMBER := null;
                    end if;	  	
                    end if;
                    end ;
                    declare
                    v_tmp number;
                    
                    v_DHS_ACTIVE char(1);
                    v_MSV char(1);
                    one_second NUMBER(5) := 1000;
                    one_minute NUMBER(5) := 60000;
                     
                    
                    v_last_chk_date date;
                    v_today_date date;
                    V_LAST_DOC number;
                    
                    begin
                    if  not :p19_sub_comp_code is null then
                    
                    
                    :P19_CLAIM_NO := '1';
                    :P19_NEW_DOC := :P19_DOCID;
                    :P19_DIRECT_CALL := 'N';
                    
                     
                    IF :P19_LOCAL_DOC_TYPE =867 then
                    :P19_IS_HOME_CARE := 'Y';
                    end if;
                    :P19_NEW_PAT_INV := :P19_PATIENTNO;
                    else
                    :P19_CLAIM_NO := '1';
                    :P19_NEW_DOC := :P19_DOCID;
                    :P19_DIRECT_CALL := 'N';
                    			  IF :P19_LOCAL_DOC_TYPE =867 then
                    		  	:P19_IS_HOME_CARE := 'Y';
                    		  end if;
                    		:P19_NEW_PAT_INV := :P19_PATIENTNO;
                    							 	    	
                    end if;
                    					 	    	
                    end ; 
                    ```
                itemsToSubmit: [
                    P19_INS_NUMBER
                    P19_COMP_CODE
                    P19_LOCAL_DOC_TYPE
                    P19_CLAIM_NO
                    P19_NEW_DOC
                    P19_DIRECT_CALL
                    P19_IS_HOME_CARE
                    P19_NEW_PAT_INV
                    P19_SUB_COMP_CODE
                ]
                itemsToReturn: [
                    P19_COMP_CODE
                    P19_SUB_COMP_CODE
                    P19_CLASS_CODE
                    P19_INS_NUMBER
                    P19_PAT_POLICY_NO
                    P19_CARD_START
                    P19_CARD_END
                    P19_RELATIONCODE
                    P19_MAINMEMBER
                    P19_DIRECT_CALL
                    P19_NEW_DOC
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action plugin-mho-redirect (
            action: plugin/redirect
            settings {
                target: {
                    page: 80
                    items: {
                        P80_PATIENTNO: &P19_PATIENTNO.
                    }
                }
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action plugin-mho-redirect-2 (
            action: plugin/redirect
            settings {
                target: {
                    page: 75
                    items: {
                        P75_CLAIM_NO: &P19_CLAIM_NO.
                        P75_DOCID: &P19_NEW_DOC.
                        P75_DIRECT_CALL: &P19_DIRECT_CALL.
                        P75_IS_HOME_CARE: &P19_IS_HOME_CARE.
                        P75_INV_NO: &P19_NEW_PAT_INV.
                        P75_PATIENTNO: &P19_PATIENTNO.
                    }
                }
            }
            execution {
                sequence: 20
