    )

    process set-based-on-coverage (
        name: Set based on coverage
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P19_COVERAGE_TYPE = 'DIRECT_CONTRACT' then
                    :P19_DIRECT_COMP_CODE := :P19_COMP_CODE;
                  end if;
                end;
                
                begin
                  if :P19_COVERAGE_TYPE = 'DIRECT_CONTRACT' then
                    :P19_DIRECT_COMP_CODE := :P19_COMP_CODE;
                  end if;
                
                  if :P19_COVERAGE_TYPE = 'INSURANCE'
                     and :P19_SUB_COMP_CODE is not null then
                
                    begin
                        select p.comp_name,
                               g.comp_name,
                              c.comp_name
                          into :P19_INS_PROVIDER_DSP,
                               :P19_RELATED_PROVIDER_DSP,
                               :P19_POLICY_NAME_DSP
                            from companys c
                          join companys p
                            on p.comp_code = c.parent_comp
                           and p.comp_type = 2
                          left join companys g
                            on g.comp_code = c.xgroup
                           and g.parent_comp = c.parent_comp
                           and g.comp_type = 5
                         where c.comp_code = :P19_SUB_COMP_CODE
                           and c.comp_type = 3;
                
                        exception
                        when no_data_found then
                            :P19_INS_PROVIDER_DSP     := null;
                            :P19_RELATED_PROVIDER_DSP := null;
                            :P19_POLICY_NAME_DSP      := null;
                            end;
                  end if;
                end;
                
                begin
                  if :P19_COVERAGE_TYPE = 'INSURANCE'
                     and :P19_SUB_COMP_CODE is not null
                     and :P19_CLASS_CODE is not null then
                
                    begin
                      select d.class_name
                        into :P19_CLASS_NAME_DSP
                        from disc_classes d
                       where d.comp_code  = :P19_SUB_COMP_CODE
                         and d.class_code = :P19_CLASS_CODE;
                
                    exception
                      when no_data_found then
                        :P19_CLASS_NAME_DSP := null;
                    end;
                
                  else
                    :P19_CLASS_NAME_DSP := null;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 47819490828124729
        }
    )

