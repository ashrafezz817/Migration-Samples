    dynamicAction coverage-type-sync (
        name: Coverage Type Sync
        execution {
            sequence: 300
        }
        when {
            selectionType: items
            items: P19_COVERAGE_TYPE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var cov = $v("P19_COVERAGE_TYPE");
                    
                      var directItems = [
                        "P19_DIRECT_COMP_CODE"
                      ];
                    
                      var insuranceItems = [
                        "P19_SUB_COMP_CODE",
                        "P19_INS_PROVIDER_DSP",
                        "P19_RELATED_PROVIDER_DSP",
                        "P19_POLICY_NAME_DSP",
                        "P19_PAT_POLICY_NO",
                        "P19_CLASS_CODE",
                        "P19_CLASS_NAME_DSP",
                        "P19_INS_NUMBER",
                        "P19_CARD_START",
                        "P19_CARD_END",
                        "P19_CARDINDICATOR",
                        "P19_CARDREVISIONNO",
                        "P19_RELATIONCODE",
                        "P19_MAINMEMBER",
                        "P19_MEMBER_ID"
                      ];
                    
                      function item(name) {
                        try {
                          return apex.item(name);
                        } catch (e) {
                          return null;
                        }
                      }
                    
                      function showItems(names, show) {
                        names.forEach(function (name) {
                          var it = item(name);
                          if (!it) {
                            return;
                          }
                    
                          if (show) {
                            it.show();
                          } else {
                            it.hide();
                          }
                        });
                      }
                    
                      function clearItems(names) {
                        names.forEach(function (name) {
                          var it = item(name);
                          if (it) {
                            it.setValue("", null, true);
                          }
                        });
                      }
                    
                      if (cov === "CASH") {
                        showItems(directItems, false);
                        showItems(insuranceItems, false);
                    
                        clearItems(directItems);
                        clearItems(insuranceItems);
                    
                        apex.item("P19_COMP_CODE").setValue("", null, true);
                        apex.item("P19_XGROUP").setValue("", null, true);
                      }
                    
                      else if (cov === "DIRECT_CONTRACT") {
                        showItems(directItems, true);
                        showItems(insuranceItems, false);
                    
                        clearItems(insuranceItems);
                    
                        apex.item("P19_COMP_CODE").setValue($v("P19_DIRECT_COMP_CODE"), null, true);
                        apex.item("P19_XGROUP").setValue("", null, true);
                      }
                    
                      else if (cov === "INSURANCE") {
                        showItems(directItems, false);
                        showItems(insuranceItems, true);
                    
                        clearItems(directItems);
                      }
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

