    process derive-page-mode (
        name: Derive Page Mode
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P19_MODE :=
                    case
                      when :REQUEST in ('CREATE', 'SAVE_CREATE') then 'CREATE'
                      when :REQUEST in ('EDIT',   'SAVE_EDIT')   then 'EDIT'
                      when :REQUEST = 'VIEW'                     then 'VIEW'
                      when :P19_PATIENTNO is not null            then 'VIEW'
                      else 'CREATE'
                    end;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39587085723837427
        }
    )

    process enforce-mode-permission (
        name: Enforce Mode Permission
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P19_MODE = 'VIEW' then
                    if fnd_app_security.has_permission('PATIENT_DEMOG_VIEW') <> 'TRUE' then
                      raise_application_error(-20050, 'You are not authorized to view this page.');
                    end if;
                
                  elsif :P19_MODE = 'CREATE' then
                    if fnd_app_security.has_permission('PATIENT_CREATE') <> 'TRUE' then
                      raise_application_error(-20051, 'You are not authorized to create patients.');
                    end if;
                
                  elsif :P19_MODE = 'EDIT' then
                    if fnd_app_security.has_permission('PATIENT_UPDATE') <> 'TRUE' then
                      raise_application_error(-20052, 'You are not authorized to edit patients.');
                    end if;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 39587190840837428
        }
    )

    process get-mrn-generation-mode (
        name: GET MRN Generation Mode
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P19_MRN_GENERATION_MODE := fnd_app_settings_pkg.get_mrn_generation_mode;
                
                  if :P19_MODE = 'CREATE'
                     and :P19_MRN_GENERATION_MODE = 'AUTO' then
                    :P19_PATIENTNO := null;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 42724715630633032
        }
    )

    process get-name-transliteration-suggestions (
        name: GET_NAME_TRANSLITERATION_SUGGESTIONS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_cursor       sys_refcursor;
                    l_suggestion   varchar2(4000);
                    l_display_order number;
                begin
                    patient_util.get_name_transliteration_suggestions(
                        p_name        => apex_application.g_x01,
                        p_direction   => apex_application.g_x02,
                        p_suggestions => l_cursor
                    );
                
                    apex_json.open_array;
                
                    loop
                        fetch l_cursor
                        into l_suggestion,
                             l_display_order;
                
                        exit when l_cursor%notfound;
                
                        apex_json.open_object;
                        apex_json.write('value', l_suggestion);
                        apex_json.write('order', l_display_order);
                        apex_json.close_object;
                    end loop;
                
                    close l_cursor;
                
                    apex_json.close_array;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 60968803270755207
        }
    )

    process initialize-form-add-edit-patient (
        name: Initialize form Add / Edit Patient
        type: formInitialization
        formRegion: @add-edit-patient
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 37820224288368212
        }
    )

    process save-patient (
        name: Save Patient
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_patient  patient_mgmt_pkg.t_patient_rec;
                  l_result   patient_mgmt_pkg.t_save_result;
                begin
                  l_patient.patientno            := :P19_PATIENTNO;
                  l_patient.visit_type           := :P19_VISIT_TYPE;
                  l_patient.iqama_no             := :P19_IQAMA_NO;
                  l_patient.file_expire_date     := :P19_FILE_EXPIRE_DATE;
                  l_patient.bdate                := :P19_BDATE;
                  l_patient.is_external_referral := :P19_IS_EXTERNAL_REFERRAL;
                
                  l_patient.p_name_ar            := :P19_P_NAME_AR;
                  l_patient.father_name_ar       := :P19_FATHER_NAME_AR;
                  l_patient.grand_f_name_ar      := :P19_GRAND_F_NAME_AR;
                  l_patient.family_name_ar       := :P19_FAMILY_NAME_AR;
                
                  l_patient.p_name_en            := :P19_P_NAME_EN;
                  l_patient.father_name_en       := :P19_FATHER_NAME_EN;
                  l_patient.grand_f_name_en      := :P19_GRAND_F_NAME_EN;
                  l_patient.family_name_en       := :P19_FAMILY_NAME_EN;
                
                  l_patient.natid                := :P19_NATID;
                  l_patient.passport_no          := :P19_PASSPORT_NO;
                  l_patient.pass_border_no       := :P19_PASS_BORDER_NO;
                  l_patient.six                  := :P19_SIX;
                  l_patient.mar_status           := :P19_MAR_STATUS;
                  l_patient.relag_id             := :P19_RELAG_ID;
                
                  l_patient.phone_h              := :P19_PHONE_H;
                  l_patient.phone_w              := :P19_PHONE_W;
                  l_patient.postal_code          := :P19_POSTAL_CODE;
                  l_patient.address              := :P19_ADDRESS;
                  l_patient.the_email            := :P19_THE_EMAIL;
                
                  l_patient.emergency_contact_name := :P19_EMERGENCY_CONTACT_NAME;
                  l_patient.emergency_relation_id  := :P19_EMERGENCY_RELATION_ID;
                  l_patient.emergency_mobile       := :P19_EMERGENCY_MOBILE;
                
                  l_patient.nok_name               := :P19_NOK_NAME;
                  l_patient.nok_mobile             := :P19_NOK_MOBILE;
                  l_patient.relative_id            := :P19_RELATIVE_ID;
                  
                  l_patient.occupation_type_id   := :P19_OCCUPATION_TYPE_ID;
                  l_patient.rem                  := :P19_REM;
                  l_patient.info_center_id       := :P19_INFO_CENTER_ID;
                
                  l_patient.coverage_type        := :P19_COVERAGE_TYPE;
                
                  if :P19_COVERAGE_TYPE = 'DIRECT_CONTRACT' then
                      l_patient.comp_code := :P19_DIRECT_COMP_CODE;
                  else
                      l_patient.comp_code := :P19_COMP_CODE;
                  end if;
                  l_patient.sub_comp_code        := :P19_SUB_COMP_CODE;
                  l_patient.class_code           := :P19_CLASS_CODE;
                  l_patient.xgroup               := :P19_XGROUP;
                  l_patient.card_id              := :P19_CARD_ID;
                  l_patient.pat_policy_no        := :P19_PAT_POLICY_NO;
                  l_patient.card_start           := :P19_CARD_START;
                  l_patient.card_end             := :P19_CARD_END;
                  l_patient.ins_number           := :P19_INS_NUMBER;
                  l_patient.mainmember           := :P19_MAINMEMBER;
                  l_patient.relationcode         := :P19_RELATIONCODE;
                  l_patient.aramco_mr_no         := :P19_ARAMCO_MR_NO;
                  l_patient.member_id            := :P19_MEMBER_ID;
                
                  l_patient.is_new_born          := :P19_IS_NEW_BORN;
                  l_patient.parent_patient_no    := :P19_PARENT_PATIENT_NO;
                
                  if :P19_MODE = 'CREATE' then
                    patient_mgmt_pkg.create_patient(
                      p_patient => l_patient,
                      p_result  => l_result
                    );
                
                  elsif :P19_MODE = 'EDIT' then
                    patient_mgmt_pkg.update_patient(
                      p_patient                         => l_patient,
                      p_expected_object_version_number  => :P19_OBJECT_VERSION_NUMBER,
                      p_result                          => l_result
                    );
                
                  else
                    raise_application_error(-20071, 'Invalid page mode for save: ' || :P19_MODE);
                  end if;
                
                  :P19_PATIENTNO              := l_result.patientno;
                  :P19_PATIENTNAME            := l_result.patientname;
                  :P19_PATIENTNAME_AR         := l_result.patientname_ar;
                  :P19_OBJECT_VERSION_NUMBER  := l_result.object_version_number;
                  :P19_LAST_UPD_DATE          := l_result.last_upd_date;
                  :P19_UPD_BY                 := l_result.upd_by;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 39588001120837437
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_CREATE,SAVE_EDIT
