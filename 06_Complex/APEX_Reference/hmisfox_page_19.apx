            /* ================= Hero region title  ================ */
            .pd-sec-h {
              background: transparent;
              border: 0;
              box-shadow: none;
              margin: 0 0 12px 0;
            }
            
            .pd-sec-h .t-HeroRegion-wrap,
            .pd-sec-h .t-HeroRegion-col--content {
              padding: 0 !important;
              min-height: auto !important;
            }
            
            .pd-sec-h .t-HeroRegion-title {
              margin: 0;
              padding-left: 14px;
              position: relative;
              font-size: 1.2rem !important;
              line-height: 1.2 !important;
              font-weight: 500;
            }
            
            .pd-sec-h .t-HeroRegion-title::before {
              content: "";
              position: absolute;
            
              left: 0;
              top: 50%;
              transform: translateY(-50%);
            
              width: 4px;
              height: 22px;
            
              border-radius: 999px;
              background: #0E6F68;
            }
            
            .pd-sec-h .t-HeroRegion-body,
            .pd-sec-h .t-HeroRegion-icon,
            .pd-sec-h .t-Region-buttons {
              display: none !important;
            }
            
            /* ================= content block title  ================ */
            
            /* Content Block sub-section titles */
            .pd-subsection .t-ContentBlock-header {
              padding-bottom: 4px !important;
              margin-bottom: 4px !important;
            }
            
            .pd-subsection .t-ContentBlock-title {
              font-size: 0.8rem !important;
              line-height: 1.2 !important;
              font-weight: 500 !important;
            }
            
            /* Reduce space between title and items */
            .pd-subsection .t-ContentBlock-body {
              padding-top: 0 !important;
            }
            
            /* ================= Patient Header region: (#patient_hdr)  ================ */
            
            #patient_hdr {
              margin-block-end: 0.75rem;
            }
            
            
            /* =========================================================
               OUTER LAYOUT
               ========================================================= */
            
            #patient_hdr .ph-card {
              padding: 0;
            
              background: transparent;
              border: 0;
              box-shadow: none;
            
              overflow: visible;
            }
            
            
            #patient_hdr .ph-main {
              --ph-header-card-height: 232px;
            
              display: grid;
            
              grid-template-columns:
                minmax(620px, 720px)
                minmax(32px, 1fr)
                480px;
            
              align-items: start;
            
              gap: 0;
            }
            
            
            /* =========================================================
               SHARED CARD HEIGHT
               ========================================================= */
            
            #patient_hdr .ph-left,
            #patient_hdr .ph-ins-card {
              box-sizing: border-box;
              height: var(--ph-header-card-height);
            }
            
            
            /* =========================================================
               PATIENT IDENTITY CARD
               ========================================================= */
            
            #patient_hdr .ph-left {
              position: relative;
              grid-column: 1;
            
              display: flex;
              flex-direction: column;
            
              min-width: 0;
            
              padding: 20px 22px 18px;
            
              background: #FFFFFF;
            
              border: 0;
              border-radius: 16px;
            
              box-shadow:
                0 2px 8px rgba(15, 23, 42, 0.07),
                0 1px 2px rgba(15, 23, 42, 0.04);
            }
            
            
            /* Patient status */
            
            #patient_hdr .ph-corner-badge {
              position: absolute;
            
              top: 16px;
              right: 16px;
            
              z-index: 2;
            }
            
            
            /* =========================================================
               NAME - PRIMARY HIERARCHY
               ========================================================= */
            
            #patient_hdr .ph-names {
              min-width: 0;
              padding-right: 76px;
            }
            
            
            #patient_hdr .ph-name-en {
              margin: 0;
            
              font-size: 1.8rem;
              line-height: 1.15;
              font-weight: 600;
            
              color: #17212B;
            }
            
            
            #patient_hdr .ph-name-ar {
              width: fit-content;
              max-width: 100%;
            
              margin-top: 5px;
            
              font-size: 1rem;
              line-height: 1.35;
              font-weight: 400;
            
              color: #64748B;
            
              direction: rtl;
            }
            
            
            /* =========================================================
               MRN - SECONDARY HIERARCHY
               ========================================================= */
            
            #patient_hdr .ph-mrn {
              margin-top: 17px;
            }
            
            
            #patient_hdr .ph-label {
              display: block;
            
              margin-bottom: 3px;
            
              font-size: 10px;
              line-height: 1.2;
              font-weight: 700;
            
              letter-spacing: .12em;
              text-transform: uppercase;
            
              color: #64748B;
            }
            
            
            #patient_hdr .ph-mrn-value {
              display: block;
            
              font-size: 1.4rem;
              line-height: 1.1;
              font-weight: 600;
            
              letter-spacing: .01em;
            
              color: #17212B;
            }
            
            
            /* =========================================================
               TERTIARY PATIENT DETAILS
               ========================================================= */
            
            #patient_hdr .ph-meta {
              display: grid;
            
              grid-template-columns:
                130px
                215px
                170px;
            
              align-items: start;
            
              gap: 22px;
            
              margin-top: 18px;
            }
            
            
            #patient_hdr .ph-meta-item {
              min-width: 0;
            }
            
            
            #patient_hdr .ph-value {
              display: block;
            
              font-size: 13px;
              line-height: 1.3;
              font-weight: 600;
            
              color: #17212B;
            
              white-space: nowrap;
              overflow: hidden;
              text-overflow: ellipsis;
            }
            
            
            /* =========================================================
               INSURANCE CARD
               ========================================================= */
            
            #patient_hdr .ph-ins-card {
              position: relative;
            
              grid-column: 3;
            
              width: 480px;
              max-width: 100%;
            
              /* Do not use aspect-ratio anymore. */
              aspect-ratio: auto;
            
              padding: 20px 18px 18px;
            
              border: 0;
              border-radius: 16px;
            
              color: #FFFFFF;
            
              overflow: hidden;
            
              background:
                linear-gradient(
                  135deg,
                  #0E6F68 0%,
                  #0E6F68 52%,
                  #3B82A0 100%
                );
            
              box-shadow:
                  0 2px 8px rgba(15, 23, 42, 0.07),
                  0 1px 2px rgba(15, 23, 42, 0.04);
            }
            
            
            #patient_hdr .ph-ins-card::after {
              display: none;
            }
            
            
            /* Decorative background */
            
            #patient_hdr .ph-ins-bg {
              position: absolute;
              inset: 0;
            
              background:
                radial-gradient(
                  circle at 18% 18%,
                  rgba(79, 185, 159, 0.30) 0,
                  rgba(79, 185, 159, 0.08) 26%,
                  transparent 40%
                ),
                radial-gradient(
                  circle at 90% 85%,
                  rgba(255, 255, 255, 0.12) 0,
                  transparent 32%
                );
            
              pointer-events: none;
            }
            
            
            /* Insurance validity badge */
            
            #patient_hdr .ph-ins-validity {
              position: absolute;
            
              top: 14px;
              right: 14px;
            
              z-index: 3;
            }
            
            
            /* =========================================================
               INSURANCE PRIMARY IDENTITY
               ========================================================= */
            
            #patient_hdr .ph-ins-header,
            #patient_hdr .ph-ins-number-wrap,
            #patient_hdr .ph-ins-policy,
            #patient_hdr .ph-ins-details {
              position: relative;
