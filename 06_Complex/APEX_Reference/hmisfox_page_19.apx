    dynamicAction verify-otp (
        name: Verify OTP
        execution {
            sequence: 330
        }
        when {
            event: click
            selectionType: button
            button: @verify-otp
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        l_verified varchar2(1);
                        l_message  varchar2(4000);
                    begin
                        patient_otp.verify_mobile_otp(
                            p_patientno => :P19_PATIENTNO,
                            p_otp_code  => :P19_OTP_TXT,
                            o_verified  => l_verified,
                            o_message   => l_message
                        );
                    
                        :P19_OTP_MESSAGE := l_message;
                    
                        if l_verified = 'Y' then
                    
                            :P19_OTP_RESULT := 'SUCCESS';
                            :P19_OTP_PASS   := 1;
                    
                            /*
                             * Successful verification legitimately updates PATIENT.OTP_PASS.
                             * TRG_PATIENT_WHO therefore advances OBJECT_VERSION_NUMBER.
                             *
                             * Synchronize the APEX page with that new database version so a
                             * later Apply Changes does not produce a false optimistic-lock
                             * conflict.
                             */
                            select object_version_number
                              into :P19_OBJECT_VERSION_NUMBER
                              from patient
                             where patientno = :P19_PATIENTNO;
                    
                        else
                    
                            :P19_OTP_RESULT := 'FAIL';
                    
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P19_PATIENTNO
                    P19_OTP_TXT
                ]
                itemsToReturn: [
                    P19_OTP_RESULT
                    P19_OTP_MESSAGE
                    P19_OTP_PASS
                    P19_OBJECT_VERSION_NUMBER
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if ($v("P19_OTP_RESULT") === "SUCCESS") {
                    
                        p19MarkCurrentMobileVerified();
                    
                        apex.message.showPageSuccess(
                            $v("P19_OTP_MESSAGE") ||
                            "Mobile verified successfully."
                        );
                    
                        apex.theme.closeRegion("otp_dialog");
                    
                        apex.item("P19_OTP_TXT").setValue("");
                    
                    } else {
                    
                        p19SyncMobileVerificationButton();
                    
                        apex.message.clearErrors();
                    
                        apex.message.showErrors([{
                            type: "error",
                            location: ["page", "inline"],
                            pageItem: "P19_OTP_TXT",
                            message:
                                $v("P19_OTP_MESSAGE") ||
                                "Wrong code.",
                            unsafe: false
                        }]);
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction view-mode (
        name: View Mode
        execution {
            sequence: 270
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery(function () {
                      if ($v("P19_MODE") === "VIEW") {
                        hmisUi.lockApexItemsByClass();
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction visit-type-ui-sync (
        name: Visit Type UI Sync
        execution {
            sequence: 280
        }
        when {
            selectionType: items
            items: P19_VISIT_TYPE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var isVisitor = $v("P19_VISIT_TYPE") === "2";
                      var iqamaItem = apex.item("P19_IQAMA_NO");
                    
                      if (isVisitor) {
                        iqamaItem.setValue("");
                        iqamaItem.disable();
                        $("#P19_IQAMA_NO_CONTAINER").addClass("is-dimmed-by-visit-type");
                      } else {
                        iqamaItem.enable();
                        $("#P19_IQAMA_NO_CONTAINER").removeClass("is-dimmed-by-visit-type");
                      }
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

