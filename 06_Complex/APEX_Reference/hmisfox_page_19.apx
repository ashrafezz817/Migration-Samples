    dynamicAction arabic-family-name-changed (
        name: Arabic Family Name Changed
        execution {
            sequence: 380
        }
        when {
            selectionType: items
            items: P19_FAMILY_NAME_AR
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    p19LoadTransliterationPicks(
                        "P19_FAMILY_NAME_AR",
                        "P19_FAMILY_NAME_EN",
                        "AR_TO_EN"
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction arabic-father-name-changed (
        name: Arabic Father Name Changed
        execution {
            sequence: 360
        }
        when {
            selectionType: items
            items: P19_FATHER_NAME_AR
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
