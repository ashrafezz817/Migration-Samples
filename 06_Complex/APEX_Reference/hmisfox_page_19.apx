    pageItem P19_PAT_STATUS (
        type: hidden
        layout {
            sequence: 30
            region: @add-edit-patient
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v varchar2(15);
                BEGIN
                   select decode(:P19_ISSTOP,2,'On Hold',1,'Active') into v
                  from dual;
                  return v;
                
                END;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                v varchar2(15);
                BEGIN
                   select decode(:P19_ISSTOP,2,'On Hold',1,'Active') into v
                  from dual;
                  return v;
                
                END;
                ```
        }
    )

