    validation validate-saudi-id-iqama-nationality (
        name: Validate Saudi ID / Iqama Nationality
        execution {
            sequence: 60
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_doc_no       varchar2(50);
                    l_first_digit  varchar2(1);
                    l_natid        number;
                
                    c_saudi_natid constant number := 1;
                begin
                
                    if :P19_IQAMA_NO is null or :P19_NATID is null then
                        return null;
                    end if;
                
                    l_doc_no := trim(:P19_IQAMA_NO);
                
                    if l_doc_no is null then
                        return null;
                    end if;
                
                    l_first_digit := substr(l_doc_no, 1, 1);
                    l_natid       := to_number(:P19_NATID);
                
                    -- Saudi national ID starts with 1.
                    if l_first_digit = '1' and l_natid <> c_saudi_natid then
                        return 'Saudi National ID starts with 1. Please select Saudi nationality.';
                    end if;
                
                    -- Iqama starts with 2.
                    if l_first_digit = '2' and l_natid = c_saudi_natid then
                        return 'Iqama number starts with 2. Saudi nationality cannot be selected for an Iqama holder.';
                    end if;
                
                    return null;
                exception
                    when value_error then
                        return 'Invalid nationality value.';
                end;
                ```
        }
        error {
            associatedItem: @P19_NATID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_EDIT,SAVE_CREATE
        }
    )

