    validation passport-number-format (
        name: Passport number format
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_passport_no varchar2(50);
                begin
                    if :P19_PASSPORT_NO is null then
                        return null;
                    end if;
                
                    l_passport_no := upper(trim(:P19_PASSPORT_NO));
                
                    if length(l_passport_no) < 6 or length(l_passport_no) > 20 then
                        return 'Passport number must be between 6 and 20 characters.';
                    end if;
                
                    if not regexp_like(l_passport_no, '^[A-Z0-9]+$') then
                        return 'Passport number can contain English letters and numbers only.';
                    end if;
                
                    return null;
                end;
                ```
        }
        error {
            associatedItem: @P19_PASSPORT_NO
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_EDIT,SAVE_CREATE
        }
    )

