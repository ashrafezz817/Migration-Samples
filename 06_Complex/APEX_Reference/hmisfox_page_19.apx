        label {
            label: Direct Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.comp_code || ' - ' || c.comp_name as d,
                       c.comp_code as r
                  from companys c
                 where c.comp_type = 1
                   and nvl(c.is_system, 'N') = 'N'
                   and c.isactiive = 1
                 order by c.comp_name;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @new
            slot: regionBody
            alignment: left
