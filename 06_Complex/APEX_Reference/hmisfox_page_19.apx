              text-overflow: ellipsis;
            }
            
            
            /* =========================================================
               INSURANCE NUMBER - SECONDARY
               ========================================================= */
            
            #patient_hdr .ph-ins-number-wrap {
              margin-top: 13px;
            }
            
            
            #patient_hdr .ph-ins-label {
              display: block;
            
              margin-bottom: 3px;
            
