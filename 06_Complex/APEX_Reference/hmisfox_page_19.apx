    dynamicAction newborn-copy-parent-defaults (
        name: Newborn Copy Parent Defaults
        execution {
            sequence: 230
        }
        when {
            selectionType: items
            items: P19_PARENT_PATIENT_NO
        }
        clientSideCondition {
            type: item=value
            item: P19_IS_NEW_BORN
            value: 1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      IF :P19_IS_NEW_BORN = '1'
                         AND :P19_PARENT_PATIENT_NO IS NOT NULL THEN
                    
                        SELECT p.visit_type,
                               p.phone_h
                          INTO :P19_VISIT_TYPE,
                               :P19_PHONE_H
                          FROM patient p
                         WHERE p.patientno = :P19_PARENT_PATIENT_NO;
                    
                      END IF;
                    
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                        NULL;
                    
                      WHEN TOO_MANY_ROWS THEN
                        raise_application_error(
                          -20011,
                          'Parent patient is not unique: ' || :P19_PARENT_PATIENT_NO
                        );
                    END;
                    ```
                itemsToSubmit: [
                    P19_IS_NEW_BORN
                    P19_PARENT_PATIENT_NO
                ]
                itemsToReturn: [
                    P19_VISIT_TYPE
                    P19_PHONE_H
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

