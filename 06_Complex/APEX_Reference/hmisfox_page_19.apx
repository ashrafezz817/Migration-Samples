            ```javascript-browser
            p19InitMobileVerificationButton();
            /* ================= Hero region title / patient header sync ================ */
            (function () {
              function txt(v) {
                return (v && String(v).trim()) ? String(v).trim() : "-";
              }
            
              function lovText(itemName) {
                try {
                  var item = apex.item(itemName);
                  var val  = $v(itemName);
            
                  if (item && typeof item.displayValueFor === "function") {
                    var d = item.displayValueFor(val);
                    return txt(d || val);
                  }
            
                  return txt(val);
                } catch (e) {
                  return txt($v(itemName));
                }
              }
            
            function codeNameText(code, name) {
              var cleanCode =
                String(code || "").trim();
            
              var cleanName =
                String(name || "").trim();
            
              if (cleanCode && cleanName) {
                return cleanCode + " - " + cleanName;
              }
            
              return cleanCode || cleanName || "-";
            }
            
              var nameEn = $v("P19_PATIENTNAME");
              var nameAr = $v("P19_PATIENTNAME_AR");
              var status = txt($v("P19_PAT_STATUS")).toLowerCase();
            
              $("#ph_name_en").text(txt(nameEn));
              $("#ph_name_ar").text(txt(nameAr));
              $("#ph_mrn").text(txt($v("P19_PATIENTNO")));
              $("#ph_iqama").text(txt($v("P19_IQAMA_NO")));
              $("#ph_age").text(txt($v("P19_BIRTH")));
              $("#ph_mobile").text(txt($v("P19_PHONE_H") || $v("P19_PHONE_W")));
            
            var badgeVariantClasses =
              "app-badge--primary " +
              "app-badge--secondary " +
              "app-badge--success " +
              "app-badge--warning " +
              "app-badge--info " +
              "app-badge--destructive";
            
            function setBadgeVariant($badge, text, variant) {
              $badge
                .removeClass(badgeVariantClasses)
                .addClass("app-badge--" + variant)
                .text(text);
            }
            
            var $status = $("#ph_status");
            
            if (status === "active") {
              setBadgeVariant($status, "Active", "success");
            } else if (status === "on hold") {
              setBadgeVariant($status, "On Hold", "warning");
            } else {
              setBadgeVariant(
                $status,
                txt($v("P19_PAT_STATUS")),
                "secondary"
              );
            }
            
            var mainProvider =
              String(
                $v("P19_INS_PROVIDER_DSP") || ""
              ).trim();
            
            var relatedProvider =
              String(
                $v("P19_RELATED_PROVIDER_DSP") || ""
              ).trim();
            
            var providerName =
              relatedProvider ||
              mainProvider;
            
            var providerCode =
              relatedProvider
                ? $v("P19_XGROUP")
                : $v("P19_COMP_CODE");
            
            $("#ph_ins_company").text(
              codeNameText(
                providerCode,
                providerName
              )
            );
            
            $("#ph_ins_number").text(
              txt($v("P19_INS_NUMBER"))
            );
            
            $("#ph_policy").text(
              codeNameText(
                $v("P19_PAT_POLICY_NO"),
                $v("P19_POLICY_NAME_DSP")
              )
            );
              $("#ph_class_code").text(codeNameText($v("P19_CLASS_CODE"),$v("P19_CLASS_NAME_DSP")));
              $("#ph_relation_code").text(lovText("P19_RELATIONCODE"));
              $("#ph_card_start").text(txt($v("P19_CARD_START")));
              $("#ph_card_end").text(txt($v("P19_CARD_END")));
            
            var endRaw = txt($v("P19_CARD_END"));
            var $validity = $("#ph_ins_validity_badge");
            
            if (endRaw === "-") {
              setBadgeVariant(
                $validity,
                "Unknown",
                "secondary"
              );
            } else {
              var endDate =
                parseDmyDate(endRaw);
            
              var today =
                new Date();
            
              today.setHours(0, 0, 0, 0);
            
              if (!endDate) {
                setBadgeVariant(
                  $validity,
                  "Unknown",
                  "secondary"
                );
              } else if (endDate >= today) {
                setBadgeVariant(
                  $validity,
                  "Valid",
                  "success"
                );
              } else {
                setBadgeVariant(
                  $validity,
                  "Expired",
                  "destructive"
                );
              }
            }
            
              var hasInsurance = $v("P19_COVERAGE_TYPE") === "INSURANCE";
            
              $("#ph_ins_card").toggle(hasInsurance);
            })();
            
            
            /* ================= Personal name keyboard tab order ================ */
            (function () {
              var tabOrder = [
                "P19_P_NAME_EN",
                "P19_FATHER_NAME_EN",
                "P19_GRAND_F_NAME_EN",
                "P19_FAMILY_NAME_EN",
                "P19_P_NAME_AR",
                "P19_FATHER_NAME_AR",
                "P19_GRAND_F_NAME_AR",
                "P19_FAMILY_NAME_AR",
                "P19_SIX"
              ];
            
              function focusItem(itemName) {
                var item = apex.item(itemName);
            
                if (item) {
                  item.setFocus();
                }
              }
            
              tabOrder.forEach(function (itemName, index) {
                $("#" + itemName).off("keydown.nameTabOrder").on("keydown.nameTabOrder", function (e) {
                  if (e.key !== "Tab") {
                    return;
                  }
            
                  var nextIndex = e.shiftKey ? index - 1 : index + 1;
            
                  if (nextIndex < 0 || nextIndex >= tabOrder.length) {
                    return;
                  }
            
                  e.preventDefault();
                  focusItem(tabOrder[nextIndex]);
                });
              });
            })();
            
            
            function parseDmyDate(value) {
              var match =
                /^(\d{2})-(\d{2})-(\d{4})$/.exec(
                  String(value || "").trim()
                );
            
              var date;
            
              if (!match) {
                return null;
              }
            
              date = new Date(
                Number(match[3]),
                Number(match[2]) - 1,
                Number(match[1])
              );
            
              if (
                date.getFullYear() !== Number(match[3]) ||
                date.getMonth() !== Number(match[2]) - 1 ||
                date.getDate() !== Number(match[1])
              ) {
                return null;
              }
            
              return date;
            }
            ```
