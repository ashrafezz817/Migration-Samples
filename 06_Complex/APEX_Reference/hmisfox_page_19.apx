    pageItem P19_CLASS_CODE (
        type: popupLov
        label {
            label: Class
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.class_code || ' - ' || d.class_name as d,
                       d.class_code as r
                  from disc_classes d
                 where d.comp_code = :P19_SUB_COMP_CODE
                   and nvl(d.isactiive, 1) = 1
                 order by d.class_code;
                ```
        }
        cascadingLov {
            parentItems: P19_SUB_COMP_CODE
        }
        layout {
            sequence: 100
            region: @new
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @add-edit-patient
            column: CLASS_CODE
            dataType: varchar2
        }
    )

