            ```javascript-browser
            /* =========================================================
               Patient name transliteration Quick Picks
               ========================================================= */
            
            var p19TransliterationRequests = {};
            
            function p19LoadTransliterationPicks(
                sourceItem,
                targetItem,
                direction
            ) {
                var sourceApexItem = apex.item(sourceItem);
                var targetApexItem = apex.item(targetItem);
            
                var sourceValue = String(
                    sourceApexItem.getValue() || ""
                ).trim();
            
                var $box = apex.jQuery(
                    "#" + targetItem + "_TRANS_PICKS"
                );
            
                var isArabicTarget =
                    direction === "EN_TO_AR";
            
                $box
                    .attr("dir", isArabicTarget ? "rtl" : "ltr")
                    .attr("lang", isArabicTarget ? "ar" : "en")
                    .toggleClass(
                        "pd-trans-picks--rtl",
                        isArabicTarget
                    );
            
                /*
                 * Always remove suggestions from the previous lookup.
                 */
                $box.empty();
            
                /*
                 * No suggestions in VIEW mode or when the source is empty.
                 */
                if (
                    $v("P19_MODE") === "VIEW" ||
                    !sourceValue
                ) {
                    return;
                }
            
                /*
                 * Cancel any previous request for this target item.
                 */
                if (
                    p19TransliterationRequests[targetItem] &&
                    typeof p19TransliterationRequests[targetItem].abort === "function"
                ) {
                    p19TransliterationRequests[targetItem].abort();
                }
            
                /*
                 * Keep the exact source value that initiated this request.
                 * This prevents a slower old response from being rendered
                 * after the user has already changed the source field.
                 */
                var requestedSourceValue = sourceValue;
            
                var request = apex.server.process(
                    "GET_NAME_TRANSLITERATION_SUGGESTIONS",
                    {
                        x01: sourceValue,
                        x02: direction
                    },
                    {
                        dataType: "json"
                    }
                );
            
                p19TransliterationRequests[targetItem] = request;
            
                request.done(function (data) {
                    /*
                     * Ignore obsolete responses.
                     */
                    var currentSourceValue = String(
                        apex.item(sourceItem).getValue() || ""
                    ).trim();
            
                    if (currentSourceValue !== requestedSourceValue) {
                        return;
                    }
            
                    $box.empty();
            
                    if (!Array.isArray(data) || data.length === 0) {
                        return;
                    }
            
                    /*
                     * Page 19 shows at most the five highest-ranked
                     * suggestions returned by PATIENT_UTIL.
                     */
                    data.slice(0, 5).forEach(function (row, index) {
                        var value = String(
                            row.value || ""
                        ).trim();
            
                        if (!value) {
                            return;
                        }
            
                        /*
                         * Match normal APEX Quick Pick presentation:
                         *
                         * Ali, Aly, ...
                         */
                        if (index > 0) {
                            $box.append(
                                document.createTextNode(", ")
                            );
                        }
            
                        var $link = apex.jQuery("<a>", {
                            href: "#",
                            "class": "quick-pick",
                            text: value,
                            title: value
                        });
            
                        $link.on("click", function (event) {
                            event.preventDefault();
            
                            /*
                             * Explicit user selection only.
                             *
                             * Suppress the target item's Change event so
                             * selecting a suggestion does not immediately
                             * trigger the reverse-direction lookup.
                             */
                            targetApexItem.setValue(
                                value,
                                null,
                                true
                            );
            
                            targetApexItem.setFocus();
                        });
            
                        $box.append($link);
                    });
                });
            
                request.fail(function (
                    jqXHR,
                    textStatus,
                    errorThrown
                ) {
                    /*
                     * Aborting an obsolete lookup is normal.
                     */
                    if (textStatus === "abort") {
                        return;
                    }
            
                    apex.debug.error(
                        "Patient name transliteration lookup failed.",
                        {
                            sourceItem: sourceItem,
                            targetItem: targetItem,
                            direction: direction,
                            status: textStatus,
                            error: errorThrown
                        }
                    );
                });
            
                request.always(function () {
                    /*
                     * Only clear the stored request if it is still
                     * the request represented by this callback.
                     */
                    if (
                        p19TransliterationRequests[targetItem] === request
                    ) {
                        p19TransliterationRequests[targetItem] = null;
                    }
                });
            }
            
            /* =========================================================
               Mobile verification badge-button
               ========================================================= */
            
            var p19SavedMobileValue = null;
            var p19VerifiedMobileValue = null;
            
            function p19NormalizeMobileValue(value) {
                return String(value || "")
                    .trim()
                    .replace(/[^0-9+]/g, "");
            }
            
            function p19SyncMobileVerificationButton() {
                var $button = apex.jQuery("#send_otp");
            
                if (!$button.length) {
                    return;
                }
            
                var currentMobile =
                    p19NormalizeMobileValue($v("P19_PHONE_H"));
            
                var savedMobile =
                    p19SavedMobileValue || "";
            
                var patientNo =
                    String($v("P19_PATIENTNO") || "").trim();
            
                var mode =
                    String($v("P19_MODE") || "").trim();
            
                var hasMobile =
                    currentMobile !== "";
            
                var mobileChanged =
                    currentMobile !== savedMobile;
            
                var isVerified =
                    hasMobile &&
                    !mobileChanged &&
                    p19VerifiedMobileValue === currentMobile;
            
                var canVerify =
                    (mode === "VIEW" || mode === "EDIT") &&
                    patientNo !== "" &&
                    hasMobile &&
                    !mobileChanged &&
                    !isVerified;
            
                $button.removeClass(
                    "app-badge--primary " +
                    "app-badge--secondary " +
                    "app-badge--success " +
                    "app-badge--warning " +
                    "app-badge--info " +
                    "app-badge--destructive"
                );
            
                var $label = $button.find(".t-Button-label");
                var $icon  = $button.find(".t-Icon");
            
                if (!hasMobile) {
            
                    $button.addClass("app-badge--warning");
            
                    $label.text("Verify Mobile");
            
                    $icon
                        .removeClass("fa-check-circle")
                        .addClass("fa-exclamation-circle");
            
                    $button
                        .prop("disabled", true)
                        .attr(
                            "title",
                            "Enter and save a personal mobile before verification."
                        );
            
                } else if (mobileChanged) {
            
                    $button.addClass("app-badge--warning");
            
                    $label.text("Save Changes to Verify");
            
                    $icon
                        .removeClass("fa-check-circle")
                        .addClass("fa-exclamation-circle");
            
                    $button
                        .prop("disabled", true)
                        .attr(
                            "title",
                            "Save the changed personal mobile before verification."
                        );
            
                } else if (isVerified) {
            
                    $button.addClass("app-badge--success");
            
                    $label.text("Mobile Verified");
            
                    $icon
                        .removeClass("fa-exclamation-circle")
                        .addClass("fa-check-circle");
            
                    $button
                        .prop("disabled", true)
                        .attr(
                            "title",
                            "Mobile verified"
                        );
            
                } else {
            
                    $button.addClass("app-badge--warning");
            
                    $label.text("Verify Mobile");
            
                    $icon
                        .removeClass("fa-check-circle")
                        .addClass("fa-exclamation-circle");
            
                    $button
                        .prop("disabled", !canVerify)
                        .attr(
                            "title",
                            canVerify
                                ? "Verify mobile"
                                : "Mobile verification is not currently available."
                        );
                }
            
                $button.addClass("p19-mobile-verification-ready");
            }
            
            function p19InitMobileVerificationButton() {
                var currentMobile =
                    p19NormalizeMobileValue($v("P19_PHONE_H"));
            
                /*
                 * The value present when the page is rendered is the persisted
                 * PATIENT.PHONE_H value.
                 */
                p19SavedMobileValue =
                    currentMobile || null;
            
                /*
                 * Verification applies specifically to that persisted mobile.
                 */
                if (
                    String($v("P19_OTP_PASS") || "0") === "1" &&
                    currentMobile !== ""
                ) {
                    p19VerifiedMobileValue = currentMobile;
                } else {
                    p19VerifiedMobileValue = null;
                }
            
                p19SyncMobileVerificationButton();
            }
            
            function p19HandleMobileChange() {
                p19SyncMobileVerificationButton();
            }
            
            function p19MarkCurrentMobileVerified() {
                var currentMobile =
                    p19NormalizeMobileValue($v("P19_PHONE_H"));
            
                /*
                 * A successful OTP should only ever apply to the persisted
                 * mobile. The backend independently enforces this as well.
                 */
                if (
                    currentMobile !== "" &&
                    currentMobile === p19SavedMobileValue
                ) {
                    p19VerifiedMobileValue = currentMobile;
                }
            
                p19SyncMobileVerificationButton();
            }
            ```
