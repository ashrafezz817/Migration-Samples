    dynamicAction newborn-ui-sync (
        name: Newborn UI Sync
        execution {
            sequence: 220
        }
        when {
            selectionType: items
            items: P19_IS_NEW_BORN
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var isNewborn = $v("P19_IS_NEW_BORN") === "1";
                      var pageMode  = $v("P19_MODE");
                      var mrnMode   = $v("P19_MRN_GENERATION_MODE");
                    
                      var isView        = pageMode === "VIEW";
                      var isEdit        = pageMode === "EDIT";
                      var isCreate      = pageMode === "CREATE";
                      var isAutoCreate  = isCreate && mrnMode === "AUTO";
                      var isManualCreate = isCreate && mrnMode === "MANUAL";
                    
                      var lockItems = [
                        "P19_IQAMA_NO",
                        "P19_PASSPORT_NO",
                        "P19_PASS_BORDER_NO"
                      ];
                    
                      var parentItem = apex.item("P19_PARENT_PATIENT_NO");
                      var mrnItem    = apex.item("P19_PATIENTNO");
                      var visitItem  = apex.item("P19_VISIT_TYPE");
                    
                      var $card = $("#pri_ident_card");
                    
                      function setItemLocked(itemName, locked) {
                        var item = apex.item(itemName);
                        var $container = $("#" + itemName + "_CONTAINER");
                    
                        $container.toggleClass("is-newborn-locked", locked);
                    
                        if (item) {
                          if (locked) {
                            item.disable();
                          } else {
                            item.enable();
                          }
                        }
                    
                        $("#" + itemName)
                          .attr("aria-disabled", locked ? "true" : "false")
                          .attr("tabindex", locked ? "-1" : "0");
                      }
                    
                      $card.toggleClass("is-newborn-mode", isNewborn);
                    
                      /*
                        Newborn mode locks direct identification fields.
                        These labels will also be dimmed because we add is-newborn-locked
                        to each item container.
                      */
                      lockItems.forEach(function (itemName) {
                        setItemLocked(itemName, isNewborn || isView);
                      });
                    
                      /*
                        MRN rule:
                        - CREATE + MANUAL: editable
                        - CREATE + AUTO: disabled, generated after save
                        - EDIT / VIEW: disabled
                      */
                      if (mrnItem) {
                        if (isManualCreate) {
                          mrnItem.enable();
                          $("#P19_PATIENTNO_CONTAINER")
                            .removeClass("mrn-auto-mode mrn-locked-mode")
                            .addClass("mrn-manual-mode");
                        } else {
                          mrnItem.disable();
                    
                          $("#P19_PATIENTNO_CONTAINER")
                            .removeClass("mrn-manual-mode")
                            .toggleClass("mrn-auto-mode", isAutoCreate)
                            .toggleClass("mrn-locked-mode", isView || isEdit);
                        }
                      }
                    
                    /*
                      Parent MRN:
                      - Enabled only in newborn mode and not view mode.
                      - Cleared when newborn mode is turned off.
                      - Label is dimmed when newborn mode is off because the field is not applicable.
                    */
                    $("#P19_PARENT_PATIENT_NO_CONTAINER")
                      .toggleClass("parent-mrn-inactive", !isNewborn)
                      .toggleClass("parent-mrn-locked", isNewborn && isView);
                    
                    if (parentItem) {
                      if (isNewborn && !isView) {
                        parentItem.enable();
                      } else {
                        if (!isNewborn) {
                          parentItem.setValue("", null, true);
                        }
                    
                        parentItem.disable();
                      }
                    
                      $("#P19_PARENT_PATIENT_NO")
                        .attr("aria-disabled", (!isNewborn || isView) ? "true" : "false")
                        .attr("tabindex", (!isNewborn || isView) ? "-1" : "0");
                    }
                    
                      /*
                        Visit Type:
                        In newborn mode it is controlled/copied from the parent.
                        Keep it visually locked like the other newborn-controlled fields.
                      */
                      $("#P19_VISIT_TYPE_CONTAINER")
                        .toggleClass("is-newborn-locked", isNewborn);
                    
                      if (visitItem) {
                        if (isView || isNewborn) {
                          visitItem.disable();
                        } else {
                          visitItem.enable();
                        }
                    
                        $("#P19_VISIT_TYPE")
                          .attr("aria-disabled", (isView || isNewborn) ? "true" : "false")
                          .attr("tabindex", (isView || isNewborn) ? "-1" : "0");
                      }
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

