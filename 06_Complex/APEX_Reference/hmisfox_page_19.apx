    dynamicAction mrn-ui-sync (
        name: MRN UI Sync
        execution {
            sequence: 290
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function () {
                      var pageMode = $v("P19_MODE");
                      var mrnMode  = $v("P19_MRN_GENERATION_MODE");
                    
                      var isCreate = pageMode === "CREATE";
                      var isAutoCreate = isCreate && mrnMode === "AUTO";
                      var isManualCreate = isCreate && mrnMode === "MANUAL";
                    
                      var mrnItem = apex.item("P19_PATIENTNO");
                      var $container = $("#P19_PATIENTNO_CONTAINER");
                    
                      $container.removeClass("mrn-auto-mode mrn-manual-mode mrn-locked-mode");
                    
                      if (isAutoCreate) {
                        $s("P19_PATIENTNO", "");
                        mrnItem.disable();
                        $container.addClass("mrn-auto-mode");
                    
                      } else if (isManualCreate) {
                        mrnItem.enable();
                        $container.addClass("mrn-manual-mode");
                    
                      } else {
                        // EDIT / VIEW
                        mrnItem.disable();
                        $container.addClass("mrn-locked-mode");
                      }
                    })();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

