    pageItem P19_BIRTH (
        type: hidden
        layout {
            sequence: 60
            region: @02-personal-information-card
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  RETURN patient_util.get_exact_age(
                           TO_DATE(:P19_BDATE, 'DD-MM-YYYY')
                         );
                END;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                BEGIN
                  RETURN patient_util.get_exact_age(
                           TO_DATE(:P19_BDATE, 'DD-MM-YYYY')
                         );
                END;
                ```
        }
    )

