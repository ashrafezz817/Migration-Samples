page 17 (
    name: Patients
    alias: PATIENTS
    title: Patients
    pageGroup: @patient-management
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        fileUrls: #APP_FILES#empty-state#MIN#.css
        inline:
            ```css
            /* ================= to prevent the flicker on page load ================ */
            #search-load-state {
              display: none;
            }
            #patient_report {
              display: none;
            }
            /* ================= Patient report action column ================ */
            .patient-action {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              min-width: 2rem;
              min-height: 2rem;
              border-radius: .5rem;
              text-decoration: none;
            }
            
            .patient-action--insurance-disabled {
              color: #dc2626;
              opacity: .55;
              cursor: not-allowed;
            }
            
            .patient-action--insurance-disabled:hover {
              opacity: .75;
            }
            
            /* ================= Search loading animation ================ */
            .patient-search-loading__icon {
              position: relative;
              width: 56px;
              height: 56px;
              margin: 0 auto 20px;
              border-radius: 999px;
              display: flex;
              align-items: center;
              justify-content: center;
              background: #FFFFFF;
              color: #0E6F68;
              font-size: 19px;
            }
            
            .patient-search-loading__icon::before {
              content: '';
              position: absolute;
              inset: 0;
              border-radius: 999px;
              background: conic-gradient(from 0deg, transparent 0%, #0E6F68 12%, transparent 28%);
              -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #17212B calc(100% - 2px));
              mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #17212B calc(100% - 2px));
              animation: patient-search-spin 1.6s linear infinite;
            }
            
            @keyframes patient-search-spin {
              to { transform: rotate(360deg); }
            }
            ```
    }
    security {
        authorizationScheme: @has-permission
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region advanced-filters (
        name: Advanced Filters
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @find-patient
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
                margin-top-sm
            ]
        }
        advanced {
            htmlDomId: adv_filters
        }
    )

    region breadcrumb (
        name: breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 40
            slot: regionBody
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region find-patient (
        name: Find Patient
        type: staticContent
        layout {
            sequence: 50
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                margin-top-none
            ]
        }
    )

    region page-load-empty-state (
        name: Page Load Empty State
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="empty-state empty-state--card empty-state--image-search">
                  <h3 class="empty-state__title">
                    Search for a patient
                  </h3>
                
                  <p class="empty-state__text">
                    Use the search bar or advanced filters above to find a patient.
                  </p>
                </div>
                ```
        }
        layout {
            sequence: 60
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: page-load-empty-state
        }
    )

    region patient-report (
        name: Patient Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with p as (
                    select
                        nullif(trim(:P17_SEARCH_TEXT), '')          as search_text,
                        nullif(trim(:P17_MR_NO), '')                as mr_no,
                        nullif(trim(:P17_ID_NO), '')                as id_no,
                        nullif(trim(:P17_PHONE), '')                as phone,
                        nullif(trim(:P17_INSURANCE_MEMBER_ID), '')  as insurance_member_id,
                        nullif(trim(:P17_PATIENTNAME), '')          as patientname_en,
                        nullif(trim(:P17_PATIENTNAME_AR), '')       as patientname_ar
                    from dual
                )
                select
                    v.patientno,
                    v.patient_name_en as patientname,
                    v.file_date,
                    v.gender_code as gender,
                    v.id_no,
                    v.phone_personal,
                    v.phone_work,
                    v.coverage_type,
                    case nvl(v.coverage_type, 'CASH')
                      when 'INSURANCE' then
                        '<span class="t-Badge t-Badge--info">Insurance</span>'
                      when 'DIRECT_CONTRACT' then
                        '<span class="t-Badge t-Badge--warning">Direct Contract</span>'
                      else
                        '<span class="t-Badge">Cash</span>'
                    end as coverage_type_badge,
                    v.bdate,
                    v.ins_number,
                    v.patient_name_ar,
                    v.comp_code,
                    v.last_visit,
                    case
                    when fnd_app_security.has_permission('INSURANCE_ELIG_VIEW') <> 'TRUE' then
                        null
                
                    when nvl(v.coverage_type, 'CASH') = 'INSURANCE'
                    and v.id_no is not null then
                        '<a href="' ||
                        apex_escape.html_attribute(
                        apex_page.get_url(
                            p_page        => 30,
                            p_request     => 'AUTO_GET_INSURANCE',
                            p_clear_cache => '30',
                            p_items       => 'P30_ID_NO,P30_AUTO_GET_INSURANCE',
                            p_values      => v.id_no || ',Y'
                        )
                        ) ||
                        '" class="patient-action patient-action--insurance"
                        title="Retrieve Insurance"
                        aria-label="Retrieve insurance for patient ' ||
                        apex_escape.html_attribute(v.patientno) ||
                        '">' ||
                          '<span class="fa fa-id-card" aria-hidden="true"></span>' ||
                        '</a>'
                
                      else
                        '<span class="patient-action patient-action--insurance-disabled"
                               title="Insurance retrieval is not available for this patient"
                               aria-label="Insurance retrieval is not available for this patient"
                               aria-disabled="true">' ||
                          '<span class="fa fa-id-card" aria-hidden="true"></span>' ||
                       '</span>'
                    end as retrieve_insurance_link
                from v_patient_search v
                cross join p
                where
                    (
                           p.search_text          is not null
                        or p.mr_no                is not null
                        or p.id_no                is not null
                        or p.phone                is not null
                        or p.insurance_member_id  is not null
                        or p.patientname_en       is not null
                        or p.patientname_ar       is not null
                    )
                and (
                       p.search_text is null
                    or v.patientno    = p.search_text
                    or v.id_no        = p.search_text
                    or v.ins_number   = p.search_text
                    or (
                         regexp_like(p.search_text, '^[0-9]+$')
                         and (
                                v.phone_personal like '%' || p.search_text || '%'
                             or v.phone_work     like '%' || p.search_text || '%'
                         )
                       )
                    or (
                         not regexp_like(p.search_text, '^[0-9]+$')
                         and length(p.search_text) >= 3
                         and (
                                contains(v.patient_name_en, p.search_text, 1) > 0
                             or contains(v.patient_name_ar, p.search_text, 2) > 0
                         )
                       )
                )
                and (
                       p.mr_no is null
                    or v.patientno = p.mr_no
                )
                and (
                       p.id_no is null
                    or v.id_no = p.id_no
                )
                and (
                       p.phone is null
                    or (
                         length(p.phone) >= 3
                         and (
                                v.phone_personal like '%' || p.phone || '%'
                             or v.phone_work     like '%' || p.phone || '%'
                         )
                       )
                )
                and (
                       p.insurance_member_id is null
                    or v.ins_number = p.insurance_member_id
                )
                and (
                       p.patientname_en is null
                    or (
                         length(p.patientname_en) >= 3
                         and contains(v.patient_name_en, p.patientname_en, 3) > 0
                       )
                )
                and (
                       p.patientname_ar is null
                    or (
                         length(p.patientname_ar) >= 3
                         and contains(v.patient_name_ar, p.patientname_ar, 4) > 0
                       )
                )
                order by v.patient_name_en;
                ```
            pageItemsToSubmit: [
                P17_SEARCH_TEXT
                P17_MR_NO
                P17_ID_NO
                P17_PHONE
                P17_INSURANCE_MEMBER_ID
                P17_PATIENTNAME
                P17_PATIENTNAME_AR
            ]
        }
        layout {
            sequence: 80
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--hiddenOverflow
                margin-bottom-none
            ]
        }
        advanced {
            htmlDomId: patient_report
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound:
                ```
                <div class="empty-state empty-state--region empty-state--image-dune">
                  <h3 class="empty-state__title">No patients found</h3>
                  <p class="empty-state__text">
                    No patients matched your search criteria.
                  </p>
                </div>
                ```
        }

