    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 10
            region: @find-patient
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 19
                clearCache: 19
                request: CREATE
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fnd_app_security.has_permission('PATIENT_CREATE') = 'TRUE'
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 50
            region: @find-patient
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--padTop
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: btn_search
        }
    )

    dynamicAction clear-search (
        name: Clear Search
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @clear
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P17_SEARCH_TEXT
                    P17_MR_NO
                    P17_ID_NO
                    P17_PHONE
                    P17_INSURANCE_MEMBER_ID
                    P17_PATIENTNAME
                    P17_PATIENTNAME_AR
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
