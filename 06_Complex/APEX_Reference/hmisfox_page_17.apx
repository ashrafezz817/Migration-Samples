    dynamicAction enter-search (
        name: Enter Search
        execution {
            sequence: 30
        }
        when {
            event: keypress
            selectionType: items
            items: [
                P17_SEARCH_TEXT
                P17_MR_NO
                P17_ID_NO
                P17_INSURANCE_MEMBER_ID
                P17_PATIENTNAME
                P17_PATIENTNAME_AR
                P17_PHONE
            ]
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.key === "Enter"
        }

        action native-refresh (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    this.browserEvent.preventDefault();
                    
                    var btn = document.getElementById("btn_search");
                    
                    if (btn) {
                      btn.click();
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression:
                    ```javascript-browser
                    $v("P17_SEARCH_TEXT") ||
                    $v("P17_MR_NO") ||
                    $v("P17_ID_NO") ||
                    $v("P17_PHONE") ||
                    $v("P17_INSURANCE_MEMBER_ID") ||
                    $v("P17_PATIENTNAME") ||
                    $v("P17_PATIENTNAME_AR")
