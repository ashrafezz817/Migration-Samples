    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-close (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button start-shift (
        buttonName: START_SHIFT
        label: Start Shift
        layout {
            sequence: 10
            region: @buttons
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            showProcessing: true
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P49_SHIFT_SYSTEM_UNIQUE
        }
    )

    validation session-info-center-is-required (
        name: Session info center is required
        execution {
            sequence: 20
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :G_INFO_CENTER_ID is not null;
        }
        error {
            errorMessage: Info center is missing from your session. Please sign out and sign in again, or contact the application administrator.
        }
        serverSideCondition {
            whenButtonPressed: @start-shift
        }
    )

    validation starting-cash-cannot-be-negative (
        name: Starting Cash cannot be negative
        execution {
            sequence: 30
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody: return :P49_STARTING_CASH >= 0;
        }
        error {
            errorMessage: Starting Cash cannot be negative.
            associatedItem: @P49_STARTING_CASH
        }
    )

    validation starting-cash-is-required (
        name: Starting Cash is required
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P49_STARTING_CASH
        }
        error {
            errorMessage: Starting Cash is required
            associatedItem: @P49_STARTING_CASH
        }
        serverSideCondition {
            whenButtonPressed: @start-shift
        }
    )

    process check-existing-open-shift (
        name: Check Existing Open Shift
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_opened_at timestamp;
                  l_minutes   number;
                begin
                  :P49_SHIFT_SYSTEM_UNIQUE := null;
                  :P49_OPENED_AT := null;
                
                  select cs.shift_system_unique,
                         cs.opened_at
                    into :P49_SHIFT_SYSTEM_UNIQUE,
                         l_opened_at
                    from cashier_shift cs
                   where cs.user_no = :G_USER_ID
                     and cs.shift_status = 2
                   fetch first 1 row only;
                
                  :P49_OPENED_AT := to_char(l_opened_at, 'YYYY-MM-DD"T"HH24:MI:SS');
                  :P49_OPENED_AT_DISPLAY := to_char(l_opened_at, 'DD Mon YYYY, HH12:MI AM');
                  :P49_SERVER_NOW := to_char(cast(systimestamp as timestamp), 'YYYY-MM-DD"T"HH24:MI:SS');
                
                exception
                  when no_data_found then
                    null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12038575863981245
        }
    )

    process close (
        name: Close
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12038477669981244
        }
        serverSideCondition {
            whenButtonPressed: @start-shift
        }
    )

    process start-cashier-shift (
        name: Start Cashier Shift
        type: invokeApi
        invoke {
            package: BIL_CASHIER_SHIFT
            procedureOrFunction: START_SHIFT
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cashier shift started successfully.
        }
        error {
            errorMessage: Unable to start cashier shift. Please review the entered cash amount and try again.
        }
        advanced {
            executionMappingIdentifier: 12037967117981239
        }
        serverSideCondition {
            whenButtonPressed: @start-shift
        }

        parameter o_shift_system_unique (
            parameter {
                direction: out
                dataType: number
            }
            value {
                item: P49_SHIFT_SYSTEM_UNIQUE
            }
            advanced {
                displaySequence: 20
            }
        )

        parameter p_cash_at_begin (
            parameter {
                dataType: number
            }
            value {
                type: item
                item: P49_STARTING_CASH
            }
            advanced {
                displaySequence: 10
            }
        )

        parameter p_info_center_id (
            parameter {
                hasDefault: true
            }
            value {
                type: item
                item: G_INFO_CENTER_ID
            }
            advanced {
                displaySequence: 40
            }
        )

        parameter p_user_no (
            parameter {
                dataType: number
                hasDefault: true
            }
            value {
                type: item
                item: G_USER_ID
            }
            advanced {
                displaySequence: 30
            }
        )

    )

)

