            label: Starting Cash
            alignment: left
        }
        settings {
            minValue: 0
        }
        layout {
            sequence: 20
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
        serverSideCondition {
            type: itemIsNull
            item: P49_SHIFT_SYSTEM_UNIQUE
        }
        help {
            helpText: Enter the cash physically available in the drawer before starting the shift.
        }
