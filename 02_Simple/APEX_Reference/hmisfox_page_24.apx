    region nationalities-report (
        name: Nationalities Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                       case
                         when nvl(is_system, 'N') = 'N'
                          and fnd_app_security.has_permission('NAT_MANAGE') = 'TRUE'
                         then
                           '<a href="' ||
                           apex_escape.html_attribute(
                             apex_page.get_url(
                               p_page               => 25,
                               p_clear_cache        => '25',
                               p_items              => 'P25_NATID',
                               p_values             => to_char(natid),
                               p_triggering_element => 'this'
                             )
                           ) ||
                           '" class="app-report-edit-link" title="Edit ' ||
                           apex_escape.html_attribute(natdesc) ||
                           '" aria-label="Edit ' ||
                           apex_escape.html_attribute(natdesc) ||
                           '">' ||
                             '<span class="fa fa-edit" aria-hidden="true"></span>' ||
                             '<span class="u-VisuallyHidden">Edit</span>' ||
                           '</a>'
                       end as edit_link,
                
                       natid,
                       natdesc,
                       natdesc_ar,
                       natdesc_short,
                       sort_order,
                       is_system,
                
                       pay_vat,
                       case pay_vat
                         when 'Y' then 'Yes'
                         when 'N' then 'No'
                         else 'Not Set'
                       end as pay_vat_display,
                
                       lang,
                       case lang
                         when 'A' then 'Arabic'
                         when 'E' then 'English'
                         else 'Not Set'
                       end as lang_display,
                
                       status,
                
                       case
                         when nvl(is_system, 'N') = 'N'
                          and fnd_app_security.has_permission('NAT_MANAGE') = 'TRUE'
                         then
                           '<button type="button"
                                    class="app-status-toggle js-toggle-nationality-status"
                                    data-natid="' ||
                                      apex_escape.html_attribute(to_char(natid)) ||
                                    '"
                                    data-current="' ||
                                      apex_escape.html_attribute(status) ||
                                    '"
                                    aria-label="Change status for ' ||
                                      apex_escape.html_attribute(natdesc) ||
                                      '. Current status: ' ||
                                      case status
                                        when 'ACTIVE' then 'Active'
                                        when 'INACTIVE' then 'Inactive'
                                        else 'Invalid'
                                      end ||
                                    '"
                                    title="Change status">' ||
                
                               '<span class="fa ' ||
                                 case status
                                   when 'ACTIVE' then
                                     'fa-toggle-on status-toggle--on'
                                   when 'INACTIVE' then
                                     'fa-toggle-off status-toggle--off'
                                   else
                                     'fa-exclamation-triangle status-toggle--invalid'
                                 end ||
                               '" aria-hidden="true"></span>' ||
                
                               '<span class="u-VisuallyHidden">' ||
                                 case status
                                   when 'ACTIVE' then 'Active'
                                   when 'INACTIVE' then 'Inactive'
                                   else 'Invalid'
                                 end ||
                               '</span>' ||
                
                           '</button>'
                
                         else
                           '<button type="button"
                                    class="app-status-toggle"
                                    disabled
                                    aria-disabled="true"
                                    aria-label="' ||
                                      case
                                        when nvl(is_system, 'N') = 'Y'
                                        then
                                          apex_escape.html_attribute(natdesc) ||
                                          '. System nationality. Status: '
                                        else
                                          apex_escape.html_attribute(natdesc) ||
                                          '. Status: '
                                      end ||
                                      case status
                                        when 'ACTIVE' then 'Active'
                                        when 'INACTIVE' then 'Inactive'
                                        else 'Invalid'
                                      end ||
                                    '"
                                    title="' ||
                                      case
                                        when nvl(is_system, 'N') = 'Y'
                                        then 'System nationality'
                                        else 'Status'
                                      end ||
                                    '">' ||
                
                               '<span class="fa ' ||
                                 case status
                                   when 'ACTIVE' then
                                     'fa-toggle-on status-toggle--on'
                                   when 'INACTIVE' then
                                     'fa-toggle-off status-toggle--off'
                                   else
                                     'fa-exclamation-triangle status-toggle--invalid'
                                 end ||
                               '" aria-hidden="true"></span>' ||
                
                               '<span class="u-VisuallyHidden">' ||
                                 case status
                                   when 'ACTIVE' then 'Active'
                                   when 'INACTIVE' then 'Inactive'
                                   else 'Invalid'
                                 end ||
                               '</span>' ||
                
                           '</button>'
                       end as status_control,
                
                       created_by,
                       creation_date,
                       last_updated_by,
                       last_update_date
                
                  from nationality
                
                 order by sort_order asc,
                          upper(natdesc),
                          natid
                ```
        }
