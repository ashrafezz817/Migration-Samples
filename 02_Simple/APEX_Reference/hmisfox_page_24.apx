    dynamicAction toggle-nationality-status (
        name: Toggle Nationality Status
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: #nationalities_ir
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: button.js-toggle-nationality-status
        }

        action native-confirm (
            action: confirm
            settings {
                message: Are you sure you want to change this nationality status?
                style: information
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var el = apex.jQuery(this.triggeringElement).closest(".js-toggle-nationality-status")[0];
                    var natid = el ? el.getAttribute("data-natid") : null;
                    var currentStatus = el ? el.getAttribute("data-current") : null;
                    
                    if (!natid) {
                      apex.message.alert("Invalid nationality row.");
                      return;
                    }
                    
                    el.disabled = true;
                    
                    apex.server.process(
                      "TOGGLE_NATIONALITY_STATUS",
                      {
                        x01: natid,
                        x02: currentStatus
                      },
                      {
                        dataType: "json",
                        loadingIndicator: apex.jQuery(el),
                    
                        success: function (pData) {
                          if (pData && pData.success) {
                            apex.region("nationalities_ir").refresh();
                            apex.message.showPageSuccess("Nationality status updated.");
                          } else {
                            el.disabled = false;
                            apex.message.alert(
                              (pData && pData.message) || "Nationality status was not updated."
                            );
                          }
                        },
                    
                        error: function (jqXHR, textStatus, errorThrown) {
                          el.disabled = false;
                    
                          console.error(
                            "TOGGLE_NATIONALITY_STATUS failed:",
                            textStatus,
                            errorThrown,
                            jqXHR && jqXHR.responseText
                          );
                    
                          apex.message.alert("Nationality status was not updated.");
                        }
                      }
                    );
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process toggle-nationality-status (
        name: TOGGLE_NATIONALITY_STATUS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_natid          nationality.natid%type;
                    l_current_status nationality.status%type;
                    l_new_status     nationality.status%type;
                    l_is_system      nationality.is_system%type;
                begin
                    if fnd_app_security.has_permission('NAT_MANAGE') <> 'TRUE' then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'You do not have permission to change nationalities.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    l_natid := to_number(apex_application.g_x01);
                
                    if apex_application.g_x02 is null
                       or apex_application.g_x02 not in ('ACTIVE', 'INACTIVE')
                    then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'Invalid nationality status.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    select status,
                           is_system
                      into l_current_status,
                           l_is_system
                      from nationality
                     where natid = l_natid;
                
                    if nvl(l_is_system, 'N') = 'Y' then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'System nationalities cannot be changed.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    if l_current_status not in ('ACTIVE', 'INACTIVE') then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'Nationality has an invalid status.');
                        apex_json.close_object;
                        return;
                    end if;
                
                    if l_current_status <> apex_application.g_x02 then
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write(
                            'message',
                            'The nationality status has changed. Refresh the page and try again.'
                        );
                        apex_json.close_object;
                        return;
                    end if;
                
                    update nationality
                       set status =
                           case l_current_status
                               when 'ACTIVE'   then 'INACTIVE'
                               when 'INACTIVE' then 'ACTIVE'
                           end,
                           last_updated_by  = nvl(v('APP_USER'), user),
                           last_update_date = sysdate
                     where natid = l_natid
                       and nvl(is_system, 'N') = 'N'
                       and status = l_current_status;
                
                    if sql%rowcount = 0 then
                        rollback;
                
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write(
                            'message',
                            'The nationality could not be updated. Refresh the page and try again.'
                        );
                        apex_json.close_object;
                        return;
                    end if;
                
                    select status
                      into l_new_status
                      from nationality
                     where natid = l_natid;
                
                    commit;
                
                    apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.write('newStatus', l_new_status);
                    apex_json.close_object;
                
                exception
                    when no_data_found then
                        rollback;
                
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'Nationality was not found.');
                        apex_json.close_object;
                
                    when value_error then
                        rollback;
                
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write('message', 'Invalid nationality row.');
                        apex_json.close_object;
                
                    when others then
                        rollback;
                
                        apex_debug.error(
                            'TOGGLE_NATIONALITY_STATUS failed. NATID=%s, ERROR=%s',
                            apex_application.g_x01,
                            sqlerrm
                        );
                
                        apex_json.open_object;
                        apex_json.write('success', false);
                        apex_json.write(
                            'message',
                            'Unable to change nationality status.'
                        );
                        apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 40341030621107604
        }
    )

)

