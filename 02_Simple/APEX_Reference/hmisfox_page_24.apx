    css {
        inline:
            ```css
            /* ================= Status Toggle: Nationalities IR ================ */
            
            #nationalities_ir .nat-status-toggle {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              min-width: 2rem;
              min-height: 2rem;
              border: 0;
              border-radius: 0.5rem;
              background: transparent;
              text-decoration: none;
              cursor: pointer;
            }
            
            #nationalities_ir .nat-status-toggle .fa {
              font-size: 1.25rem;
            }
            
            #nationalities_ir .status-toggle--on {
              color: #16a34a;
            }
            
            #nationalities_ir .status-toggle--off {
              color: #94a3b8;
            }
            
            #nationalities_ir .status-toggle--invalid {
              color: #dc2626;
            }
            
            #nationalities_ir .nat-status-toggle:hover {
              background: rgba(148, 163, 184, 0.15);
            }
            
            #nationalities_ir .nat-status-toggle:focus {
              outline: 2px solid var(--ut-focus-outline-color, #2563eb);
              outline-offset: 2px;
            }
            
            
            /* ================= edit link: Nationalities IR ================ */
            #nationalities_ir .nat-edit-link {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              min-width: 2rem;
              min-height: 2rem;
              border-radius: 0.5rem;
              text-decoration: none;
            }
            
            #nationalities_ir .nat-edit-link:hover {
              background: rgba(148, 163, 184, 0.15);
            }
            
            #nationalities_ir .nat-edit-link:focus {
              outline: 2px solid var(--ut-focus-outline-color, #2563eb);
              outline-offset: 2px;
            }
            ```
