      <ProgramUnit Name="DO_INTERFACE" ProgramUnitText="/*******************************************&amp;#10;   Code modified by the Forms Migration Assistant&amp;#10;   04-Nov-2014 07:00 PM&amp;#10; *******************************************/&amp;#10;&amp;#10;procedure do_interface  IS&amp;#10;    v_insert_done boolean default false;&amp;#10;&#x9;&#x9;------------------------------------------------------------------------&amp;#10;&#x9;&#x9;procedure chg_prmpt(p_block varchar2,p_item_name varchar2) is&amp;#10;    v_found varchar2(30);&#x9;&#x9;&amp;#10;&#x9;&#x9;v_tmp varchar2(30);&amp;#10;&#x9;&#x9;v_prompt varchar2(30);&amp;#10;&#x9;&#x9;v_item varchar2(30);&amp;#10;&#x9;&#x9;--v_insert_done boolean default false;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;begin&amp;#10;        if not (p_block is null) then&amp;#10;        &#x9;  v_item :=p_block ||'.'||p_item_name;&amp;#10;        else&amp;#10;        &#x9;  v_item :=p_item_name;&amp;#10;        end if;&amp;#10;     &#x9;&#x9;v_prompt:=&#x9;get_Item_Property(v_item ,prompt_text);&amp;#10;     &#x9;&#x9;--message (v_prompt);&amp;#10;        select COUNT(*) &amp;#10;  &#x9;&#x9;&#x9;into v_found&amp;#10;  &#x9;&#x9;&#x9;from trans&amp;#10;  &#x9;&#x9;&#x9;where cntl=p_item_name ;&amp;#10;        if v_found=0 then&amp;#10;  &#x9;&#x9;&#x9;      &#x9;insert into trans (cntl,str_a,str_e) values (p_item_name,v_prompt ,v_prompt);&amp;#10;  &#x9;&#x9;&#x9;      &#x9;v_insert_done:=true;&amp;#10;  &#x9;&#x9;&#x9;end if;&amp;#10;  &#x9;&#x9;&#x9;if :global.lang='A' THEN&amp;#10;&#x9;&#x9;      &#x9;&#x9;select str_a into v_tmp from trans where cntl=p_item_name;&amp;#10;  &#x9;&#x9;&#x9;else&amp;#10;  &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;select str_e into v_tmp from trans where cntl=p_item_name;&amp;#10;  &#x9;&#x9;&#x9;end if;&amp;#10;     &#x9;&#x9;Set_Item_Property(v_item,prompt_text,v_tmp);&amp;#10;  &#x9;&#x9;&#x9;exception&amp;#10;  &#x9;&#x9;&#x9;&#x9;when others then&amp;#10;  &#x9;&#x9;&#x9;&#x9;NULL;&amp;#10;&#x9;&#x9;end;&amp;#10;BEGIN&amp;#10;  if :global.lang='A' THEN&amp;#10;  &#x9;&#x9;set_form_property('clinics',direction,RIGHT_TO_LEFT);&amp;#10;  &#x9;&#x9;set_window_property('window1',direction,RIGHT_TO_LEFT);&amp;#10;  ELSE&amp;#10;  &#x9;  set_form_property('clinics',direction,LEFT_TO_RIGHT);&amp;#10;  &#x9;  set_window_property('window1',direction,LEFT_TO_RIGHT);&amp;#10;  END IF;&amp;#10;  --chg_prmpt(NULL,'CLINICID');&amp;#10;  --chg_prmpt(NULL,'CLINICNAME');&amp;#10;  --chg_prmpt(NULL,'CLINICNAME_AR');&amp;#10;  if v_insert_done then&amp;#10;  &#x9;COMMIT_FORM;&amp;#10;  end if;&amp;#10;END;&amp;#10;&amp;#10;" ProgramUnitType="Procedure"/>
