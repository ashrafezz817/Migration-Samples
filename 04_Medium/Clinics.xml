      <ProgramUnit Name="HIDE_AN_ITEM" ProgramUnitText="PROCEDURE Hide_an_Item( item_name VARCHAR2, hide_it BOOLEAN) IS  &amp;#10;   it_id   Item;  &amp;#10; BEGIN  &amp;#10;   it_id := Find_Item(item_name);  &amp;#10;   IF Id_Null(it_id) THEN  &amp;#10;    null;&amp;#10;     --messag('No such item: '||item_name);  &amp;#10;     --RAISE Form_Trigger_Failure;  &amp;#10;   ELSE  &amp;#10;     IF hide_it THEN  &amp;#10;       Set_Item_Property(it_id,VISIBLE,PROPERTY_FALSE);  &amp;#10;     ELSE  &amp;#10;       Set_Item_Property(it_id,VISIBLE,PROPERTY_TRUE);  &amp;#10;       Set_Item_Property(it_id,ENABLED,PROPERTY_TRUE);  &amp;#10;       Set_Item_Property(it_id,NAVIGABLE,PROPERTY_TRUE);  &amp;#10;     END IF;  &amp;#10;   END IF;  &amp;#10; END;  &amp;#10;  " ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CHK_SEC" ProgramUnitText="procedure chk_sec(P_USER_NO VARCHAR2,blk_name in varchar2,P_FORM_NAME VARCHAR2) is&amp;#10;blk_id Block; &amp;#10;blk_state varchar2(10);&amp;#10;begin&amp;#10;&#x9;blk_id:=Find_Block(blk_name); &amp;#10;  blk_state:=Get_Block_Property(blk_id,INSERT_ALLOWED);&amp;#10;  if blk_state='TRUE' AND GET_U_PREV20(P_USER_NO,P_FORM_NAME,'I',null,:global.current_info_center_id)=0 THEN&amp;#10;  &#x9;Set_Block_Property(blk_id,INSERT_ALLOWED,PROPERTY_FALSE);&amp;#10;  END IF;&amp;#10;  blk_state:=Get_Block_Property(blk_id,UPDATE_ALLOWED);&amp;#10;  if blk_state='TRUE' AND GET_U_PREV20(P_USER_NO,P_FORM_NAME,'U',null,:global.current_info_center_id)=0 THEN&amp;#10;  &#x9;Set_Block_Property(blk_id,UPDATE_ALLOWED,PROPERTY_FALSE);&amp;#10;  END IF;&amp;#10;  blk_state:=Get_Block_Property(blk_id,DELETE_ALLOWED);&amp;#10;  if blk_state='TRUE' AND GET_U_PREV20(P_USER_NO,P_FORM_NAME,'D',null,:global.current_info_center_id)=0 THEN&amp;#10;  &#x9;Set_Block_Property(blk_id,DELETE_ALLOWED,PROPERTY_FALSE);&amp;#10;  END IF;&amp;#10;  blk_state:=Get_Block_Property(blk_id,QUERY_ALLOWED);&amp;#10;  if blk_state='TRUE' AND GET_U_PREV20(P_USER_NO,P_FORM_NAME,'S',null,:global.current_info_center_id)=0 THEN&amp;#10;  &#x9;Set_Block_Property(blk_id,QUERY_ALLOWED,PROPERTY_FALSE);&amp;#10;  END IF;&amp;#10;&amp;#10;end;&amp;#10;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="MESSAG" ProgramUnitText="PROCEDURE messag(str varchar)  IS&amp;#10;&#x9;AL_ID&#x9;&#x9;ALERT;&amp;#10;&#x9;AL_BUT&#x9;&#x9;NUMBER;&amp;#10;BEGIN&amp;#10;&#x9;AL_ID:=FIND_ALERT('ERR_ALERT');&amp;#10;&#x9;SET_ALERT_PROPERTY(AL_ID,ALERT_MESSAGE_TEXT,str);&amp;#10;&#x9;AL_BUT:=SHOW_ALERT(AL_ID);&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
