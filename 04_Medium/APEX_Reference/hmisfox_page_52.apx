    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @breadcrumb
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 53
                clearCache: 53
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: fnd_app_security.has_permission('CLINICS_CREATE') = 'TRUE'
        }
    )

    dynamicAction refresh-after-create (
        name: Refresh after create
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @clinics-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-after-update (
        name: refresh after update
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @clinics-report
        }

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @clinics-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

