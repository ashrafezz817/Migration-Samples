page 52 (
    name: Clinics
    alias: CLINICS
    title: Clinics
    pageGroup: @clinical
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        fileUrls: #APP_FILES#empty-state.css
        inline:
            ```css
            /* ================= Status Icon: Clinics IR ================ */
            
            #clinics-report .clinic-status-toggle {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              min-width: 2rem;
              min-height: 2rem;
              border: 0;
              border-radius: 0.5rem;
              background: transparent;
              text-decoration: none;
            }
            
            #clinics-report .clinic-status-toggle .fa {
              font-size: 1.25rem;
            }
            
            #clinics-report .status-toggle--on {
              color: #16a34a;
            }
            
            #clinics-report .status-toggle--off {
              color: #94a3b8;
            }
            
            #clinics-report .status-toggle--invalid {
              color: #dc2626;
            }
            ```
    }
    security {
        authorizationScheme: @has-permission
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    advanced {
        enableDuplicatePageSubmissions: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: regionBody
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region clinics (
        name: Clinics
        type: staticContent
        layout {
            sequence: 10
            slot: regionBody
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        accessibility {
            useLandmark: false
        }
    )

    region clinics-report (
        name: Clinics Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CLINICID,
                       CLINICNAME,
                       OLD_PAT_TIME,
                       NEW_PAT_TIME,
                       REVIEW_DATES,
                       CLINICNAME_AR,
                       AGE_MIN,
                       AGE_MAX,
                       CASE
                       WHEN SIX = 1 THEN 'Male'
                       WHEN SIX = 2 THEN 'Female'
                       WHEN SIX IS NULL THEN 'No Restriction'
                       ELSE 'Unknown'
                       END AS SIX,
                       SYS_CAT_TYPE,
                       CASE VS_IS_MUST
                       WHEN 'Y' THEN
                            '<span class="clinic-status-toggle" title="Vital signs required" aria-label="Required">
                              <span class="fa fa-toggle-on status-toggle--on" aria-hidden="true"></span>
                            </span>'
                       WHEN 'N' THEN
                            '<span class="clinic-status-toggle" title="Vital signs not required" aria-label="Not Required">
                              <span class="fa fa-toggle-off status-toggle--off" aria-hidden="true"></span>
                            </span>'
                       ELSE     
                           '<span class="clinic-status-toggle" title="Invalid vital signs setting" aria-label="Invalid status">
                              <span class="fa fa-exclamation-triangle status-toggle--invalid" aria-hidden="true"></span>
                            </span>'
                       END AS VS_IS_MUST,     
                       CCHI_CODE,
                       OBJECT_VERSION_NUMBER,
                       CREATED_BY,
                       CREATION_DATE,
                       LAST_UPDATED_BY,
                       LAST_UPDATE_DATE,
                       LAST_UPDATE_LOGIN
                  from CLINICS
                  order by upper(clinicname)
                ```
        }
        layout {
            sequence: 30
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
            cssClasses: use-empty-state
        }
        advanced {
            htmlDomId: clinics-report
        }
        link {
            linkColumn: customTarget
            target: {
                page: 53
                items: {
                    P53_CLINICID: #CLINICID#
                }
                clearCache: 53
            }
            conditionType: expression
            plsqlExpression: fnd_app_security.has_permission('CLINICS_UPDATE') = 'TRUE'
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound:
                ```
                <div class="empty-state empty-state--region empty-state--image-dune">
                  <h3 class="empty-state__title">No clinics found</h3>
                  <p class="empty-state__text">
                    No clinics exist.
                  </p>
                </div>
                ```
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            pivot: false
        }
        advanced {
            savedReportMappingIdentifier: 16839907911928634
        }

