    dynamicAction service-pricing-changed (
        name: Bundle Component Pricing Changed
        execution {
            sequence: 190
            eventScope: dynamic
        }
        when {
            selectionType: columns
            interactiveGrid: @bundle-components
            columns: [
                SERVICEID
                QTY
                OFFER_PRICE
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        l_org_price
                            offers_dtl.org_price%type;
                    
                        l_ignored_org_discount
                            offers_dtl.org_disc%type;
                    
                        l_vat_rate
                            services.vat_rate%type;
                    
                        l_qty
                            number;
                    
                        l_bundle_unit_price
                            number;
                    
                        l_original_line_total
                            number;
                    
                        l_bundle_line_total
                            number;
                    begin
                        if :SERVICEID is null then
                            :ORG_PRICE           := null;
                            :VAT_STATUS          := null;
                            :ORIGINAL_LINE_TOTAL := null;
                            :BUNDLE_LINE_TOTAL   := null;
                            :SAVINGS             := null;
                    
                            return;
                        end if;
                    
                        bil_offers_admin.get_bundle_component_pricing(
                            p_offer_id       => :P63_OFERID,
                            p_service_id     => :SERVICEID,
                            o_org_price      => l_org_price,
                            o_org_discount   => l_ignored_org_discount,
                            o_vat_rate       => l_vat_rate
                        );
                    
                        :ORG_PRICE :=
                            l_org_price;
                    
                        :VAT_STATUS :=
                            case
                                when l_vat_rate is null then
                                    'Exempt'
                                else
                                    to_char(
                                        l_vat_rate,
                                        'TM9'
                                    ) || '% VAT'
                            end;
                    
                        l_qty :=
                            nvl(
                                to_number(
                                    :QTY,
                                    '999G999G990D00'
                                ),
                                1
                            );
                    
                        l_original_line_total :=
                            round(
                                l_qty * nvl(l_org_price, 0),
                                2
                            );
                    
                        :ORIGINAL_LINE_TOTAL :=
                            l_original_line_total;
                    
                        if :OFFER_PRICE is null then
                            :BUNDLE_LINE_TOTAL := null;
                            :SAVINGS           := null;
                        else
                            l_bundle_unit_price :=
                                to_number(
                                    :OFFER_PRICE,
                                    '999G999G990D00'
                                );
                    
                            l_bundle_line_total :=
                                round(
                                    l_qty * l_bundle_unit_price,
                                    2
                                );
                    
                            :BUNDLE_LINE_TOTAL :=
                                l_bundle_line_total;
                    
                            :SAVINGS :=
                                round(
                                    l_original_line_total -
                                    l_bundle_line_total,
                                    2
                                );
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P63_OFERID
                    SERVICEID
                    QTY
                    OFFER_PRICE
                ]
                itemsToReturn: [
                    ORG_PRICE
                    VAT_STATUS
                    ORIGINAL_LINE_TOTAL
                    BUNDLE_LINE_TOTAL
                    SAVINGS
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation offer-price-cannot-be-negative (
        name: Bundle Components - Bundle price must not exceed original price
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @bundle-components
            plsqlExpression:
                ```plsql
                :OFFER_PRICE is not null
                and :ORG_PRICE is not null
                and to_number(
                        :OFFER_PRICE,
                        '999G999G990D00'
                    ) >= 0
                and to_number(
                        :OFFER_PRICE,
                        '999G999G990D00'
                    )
                    <=
                    to_number(
                        :ORG_PRICE,
                        '999G999G990D00'
                    )
                ```
        }
        error {
            errorMessage: Bundle Unit Price must be between 0 and Plan Unit Price.
            associatedColumn: OFFER_PRICE
        }
    )

    validation quantity-can-not-be-negative (
        name: Bundle Components - Quantity must be a positive integer
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @bundle-components
            plsqlExpression:
                ```plsql
                :QTY is not null
                and :QTY between 1 and 999
                and :QTY = trunc(:QTY)
                ```
        }
        error {
            errorMessage: Quantity must be a whole number between 1 and 999.
            associatedColumn: QTY
        }
    )

    validation saved-service-cannot-be-changed (
        name: Saved Service Cannot Be Changed
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @bundle-components
            plsqlExpression:
                ```plsql
                :ROW_ID is null
                or :SERVICEID = :ORIGINAL_SERVICEID
                ```
        }
        error {
            errorMessage: A saved bundle component service cannot be changed. Remove the component and add the correct service.
            associatedColumn: SERVICEID
        }
    )

    process new (
        name: Resolve Selected Bundle Status
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    :P63_BUNDLE_RETIRED := null;
                
                    if :P63_OFERID is not null then
                        select case
                                   when o.is_deleted = 'Y' then 'Y'
                                   else 'N'
                               end
                          into :P63_BUNDLE_RETIRED
                          from offers o
                         where o.oferid = :P63_OFERID
                           and o.offer_type = 0
                           and o.offer_info_center = :G_INFO_CENTER_ID;
                    end if;
                
                exception
                    when no_data_found then
                        :P63_OFERID         := null;
                        :P63_BUNDLE_RETIRED := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41632836074840462
        }
    )

    process save-offer-service-lines (
        name: Save Bundle Components
        type: executeCode
        editableRegion: @bundle-components
        source {
            plsqlCode:
                ```plsql
                declare
                    l_expected_detail_ovn offers_dtl.object_version_number%type;
                    l_header_ovn          offers.object_version_number%type;
                begin
                    case :APEX$ROW_STATUS
                
                        when 'C' then
                            bil_offers_admin.add_bundle_component(
                                p_offer_id     => :P63_OFERID,
                                p_service_id   => :SERVICEID,
                                p_quantity     => :QTY,
                                p_bundle_price => :OFFER_PRICE,
                                o_row_id       => :ROW_ID,
                                o_detail_ovn   => :OBJECT_VERSION_NUMBER,
                                o_header_ovn   => l_header_ovn
                            );
                
                        when 'U' then
                            l_expected_detail_ovn :=
                                :OBJECT_VERSION_NUMBER;
                
                            bil_offers_admin.update_bundle_component(
                                p_offer_id            => :P63_OFERID,
                                p_row_id              => :ROW_ID,
                                p_quantity            => :QTY,
                                p_bundle_price        => :OFFER_PRICE,
                                p_expected_detail_ovn => l_expected_detail_ovn,
                                o_detail_ovn          => :OBJECT_VERSION_NUMBER,
                                o_header_ovn          => l_header_ovn
                            );
                
                        when 'D' then
                            bil_offers_admin.remove_bundle_component(
                                p_offer_id            => :P63_OFERID,
                                p_row_id              => :ROW_ID,
                                p_expected_detail_ovn => :OBJECT_VERSION_NUMBER,
                                o_header_ovn          => l_header_ovn
                            );
                
                    end case;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 41618792442840415
        }
        serverSideCondition {
            executionScope: allSubmittedRows
        }
        security {
            authorizationScheme: @can-manage-bundled-offers-lines
        }
    )

)

