    region bundle-overview (
        name: Bundle Overview
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    o.oferid,
                    o.offer_name,
                    nullif(trim(o.notes), '') as description,
                
                    to_char(
                        o.start_date,
                        :APP_NLS_DATE_FORMAT
                    )
                    || ' - ' ||
                    to_char(
                        o.enddate,
                        :APP_NLS_DATE_FORMAT
                    ) as effective_period,
                
                    case
                        when o.valid_dayes is null then
                            'Not set'
                        else
                            to_char(o.valid_dayes) || ' days'
                    end as valid_days_display,
                
                    pl.list_name,
                
                    to_char(
                        nvl(o.org_price, 0),
                        'FM999G999G990D00'
                    ) as original_total,
                
                    to_char(
                        nvl(o.new_price, 0),
                        'FM999G999G990D00'
                    ) as bundle_total,
                
                    to_char(
                        nvl(o.org_price, 0) -
                        nvl(o.new_price, 0),
                        'FM999G999G990D00'
                    ) as savings,
                
                    case
                        when o.last_update_date is null then
                            nvl(trim(o.last_updated_by), 'Unknown')
                        else
                            nvl(trim(o.last_updated_by), 'Unknown')
                            || ' · ' ||
                            to_char(
                                o.last_update_date,
                                :APP_DATE_TIME_FORMAT
                            )
                    end as last_updated,
                
                    case
                        when o.is_deleted = 'Y' then 'Retired'
                        when trunc(sysdate) < trunc(o.start_date) then 'Upcoming'
                        when trunc(sysdate) > trunc(o.enddate) then 'Expired'
                        else 'Active'
                    end as status_label,
                
                    case
                        when o.is_deleted = 'Y' then
                            'app-badge--destructive'
                
                        when trunc(sysdate) < trunc(o.start_date) then
                            'app-badge--info'
                
                        when trunc(sysdate) > trunc(o.enddate) then
                            'app-badge--secondary'
                
                        else
                            'app-badge--success'
                    end as status_class
                
                from offers o
                
                join price_list_master pl
                  on pl.list_id = o.list_id
                
                where o.oferid = :P63_OFERID
                  and o.offer_type = 0
                  and o.offer_info_center = :G_INFO_CENTER_ID
                ```
            pageItemsToSubmit: P63_OFERID
        }
        layout {
            sequence: 30
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: bundle_overview
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P63_OFERID
        }
        componentAppearance {
            display: partial
        }
        settings {
            overline: Bundle ID &OFERID.
            title: &OFFER_NAME.
            description:
                ```html
                <div class="bundle-overview-status">
                    <span class="app-badge &STATUS_CLASS!ATTR. app-badge--solid app-badge--md">&STATUS_LABEL!HTML.</span>
                </div>
                
                {if DESCRIPTION/}
                <div class="bundle-overview-description">&DESCRIPTION!HTML.</div>
                {else/}
                <div class="bundle-overview-description bundle-overview-empty">No description provided.</div>
                {endif/}
                
                <div class="bundle-overview-layout">
                    <div class="bundle-overview-meta">
                        <div class="bundle-overview-detail">
                            <span class="bundle-overview-detail__label">Effective Period</span>
                            <span class="bundle-overview-detail__value">&EFFECTIVE_PERIOD!HTML.</span>
                        </div>
                        <div class="bundle-overview-detail">
                            <span class="bundle-overview-detail__label">Validity Days</span>
                            <span class="bundle-overview-detail__value">&VALID_DAYS_DISPLAY!HTML.</span>
                        </div>
                        <div class="bundle-overview-detail">
                            <span class="bundle-overview-detail__label">Price List</span>
                            <span class="bundle-overview-detail__value bundle-overview-detail__value--accent">&LIST_NAME!HTML.</span>
                        </div>
                        <div class="bundle-overview-detail">
                            <span class="bundle-overview-detail__label">Last Updated</span>
                            <span class="bundle-overview-detail__value">&LAST_UPDATED!HTML.</span>
                        </div>
                    </div>
                
                    <div class="bundle-overview-savings">
                        <span class="bundle-overview-savings__label">Savings</span>
                        <div class="bundle-overview-savings__amount">
                            &SAVINGS!HTML.<span class="bundle-overview-savings__currency">SAR</span>
                        </div>
                        <span class="bundle-overview-savings__sub">Difference between original and bundle totals, excluding VAT</span>
                        <div class="bundle-overview-savings__divider"></div>
                        <div class="bundle-overview-savings__totals">
                            <div>
                                <span class="bundle-overview-savings__totlabel">Original Total</span>
                                <span class="bundle-overview-savings__strike">&ORIGINAL_TOTAL!HTML.</span>
                            </div>
                            <div>
                                <span class="bundle-overview-savings__totlabel">Bundle Total</span>
                                <span class="bundle-overview-savings__pill">&BUNDLE_TOTAL!HTML.</span>
                            </div>
                        </div>
                        <div class="bundle-overview-savings__note">
                          All amounts exclude VAT.
                        </div>
                    </div>
                </div>
                ```
        }

