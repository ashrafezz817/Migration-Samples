    region bundle-list (
        name: Bundle List
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with q as (
                    select
                        o.oferid,
                        o.offer_name,
                        nullif(trim(o.notes), '') as description,
                        o.start_date,
                        o.enddate,
                
                        case
                            when o.is_deleted = 'Y' then
                            'Retired'
                            when trunc(sysdate) < trunc(o.start_date) then
                            'Upcoming'
                            when trunc(sysdate) > trunc(o.enddate) then
                            'Expired'
                        else
                            'Active'
                        end as status_label,
                 
                        case
                            when o.is_deleted = 'Y' then
                                'app-badge--danger'
                            when trunc(sysdate) < trunc(o.start_date) then
                                'app-badge--primary'
                            when trunc(sysdate) > trunc(o.enddate) then
                                'app-badge--neutral'
                            else
                                'app-badge--success'
                        end as status_class,
                
                        apex_page.get_url(
                            p_page   => 63,
                            p_items  => 'P63_OFERID',
                            p_values => o.oferid
                        ) as bundle_link,
                
                        case
                            when o.oferid = :P63_OFERID then
                                'is-active'
                            else
                                null
                        end as card_class
                
                    from offers o
                
                    where o.offer_type = 0
                      and o.offer_info_center = :G_INFO_CENTER_ID
                
                      and (
                            nullif(trim(:P63_SEARCH), '') is null
                
                            or instr(
                                   to_char(o.oferid),
                                   trim(:P63_SEARCH)
                               ) > 0
                
                            or instr(
                                   upper(o.offer_name),
                                   upper(trim(:P63_SEARCH))
                               ) > 0
                
                            or instr(
                                   upper(nvl(o.notes, '')),
                                   upper(trim(:P63_SEARCH))
                               ) > 0
                          )
                )
                select
                    oferid,
                    offer_name,
                    description,
                    start_date,
                    enddate,
                    status_label,
                    status_class,
                    bundle_link,
                    card_class,
                
                    '<a class="app-side-card ' ||
                        apex_escape.html_attribute(card_class) ||
                        '" href="' ||
                        apex_escape.html_attribute(bundle_link) ||
                        '" title="' ||
                        apex_escape.html_attribute(
                            'View bundled offer ' || offer_name
                        ) ||
                        '" aria-label="' ||
                        apex_escape.html_attribute(
                            'View bundled offer ' || offer_name
                        ) ||
                        '"' ||
                    case
                        when card_class = 'is-active' then
                            ' aria-current="page"'
                        else
                            null
                    end ||
                    '>' ||
                
                        '<span class="app-side-card__top">' ||
                            '<span class="app-side-card__title">' ||
                                apex_escape.html(offer_name) ||
                            '</span>' ||
                        '</span>' ||
                
                        '<span class="app-side-card__meta">' ||
                            'Bundle ID ' || to_char(oferid) ||
                        '</span>' ||
                
                        '<span class="app-side-card__badges">' ||
                            '<span class="app-badge ' ||
                                apex_escape.html_attribute(status_class) ||
                                ' app-badge--light app-badge--sm">' ||
                                apex_escape.html(status_label) ||
                            '</span>' ||
                        '</span>'||
                
                        '<span class="app-side-card__sub">' ||
                            apex_escape.html(
                                nvl(description, 'No description')
                            ) ||
                        '</span>' ||
                
                    '</a>' as bundle_card
                
                from q
                order by
                    case status_label
                        when 'Active'   then 1
                        when 'Upcoming' then 2
                        when 'Expired'  then 3
                        when 'Retired'  then 4
                        else 5
                    end,
                    lower(offer_name),
                    oferid
                ```
            pageItemsToSubmit: [
                P63_SEARCH
                P63_OFERID
            ]
        }
        layout {
            sequence: 20
            slot: REGION_POSITION_02
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: app-side-list
        }
