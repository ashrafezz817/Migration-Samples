        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function (options) {
                    "use strict";
                
                    const $ = apex.jQuery;
                
                    const editable =
                        $v("P63_BUNDLE_RETIRED") !== "Y";
                
                    const gridOptions =
                        apex.util.getNestedObject(
                            options,
                            "defaultGridViewOptions"
                        );
                
                    const modelOptions =
                        apex.util.getNestedObject(
                            options,
                            "defaultModelOptions"
                        );
                
                    const text =
                        apex.util.getNestedObject(
                            options,
                            "text"
                        );
                
                    const toolbarData =
                        $.apex.interactiveGrid.copyDefaultToolbar();
                
                    const rightActionsGroup =
                        toolbarData.toolbarFind("actions4");
                
                    const previousInitActions =
                        options.initActions;
                
                    /*
                     * Disable editing when the selected bundled offer
                     * has been retired.
                     */
                    gridOptions.editable = editable;
                
                    /*
                     * Keep rows marked for deletion visible until Save.
                     */
                    gridOptions.hideDeletedRows = false;
                    modelOptions.onlyMarkForDelete = true;
                
                    text.addRowButton = "Add Component";
                
                    /*
                     * Remove unnecessary standard Interactive Grid
                     * toolbar groups.
                     */
                    [
                        "search",
                        "reports",
                        "views",
                        "actions1"
                    ].forEach(function (id) {
                        toolbarData.toolbarRemove(id);
                    });
                
                    /*
                     * Add native Interactive Grid row actions
                     * to the right side of the toolbar.
                     */
                    if (rightActionsGroup) {
                        rightActionsGroup.controls = [
                            {
                                type: "BUTTON",
                                action: "selection-revert",
                                iconOnly: false
                            },
                            {
                                type: "BUTTON",
                                action: "selection-delete",
                                iconOnly: false
                            }
                        ];
                    }
                
                    options.toolbarData = toolbarData;
                
                    options.initActions = function (actions) {
                        let removeAction;
                        let revertAction;
                
                        /*
                         * Preserve initialization supplied by APEX
                         * or other region code.
                         */
                        if (previousInitActions) {
                            previousInitActions(actions);
                        }
                
                        actions.hide("single-row-view");
                
                        /*
                         * Rename the native delete-selected action.
                         */
                        removeAction =
                            actions.lookup("selection-delete");
                
                        if (removeAction) {
                            removeAction.label =
                                "Remove Selected";
                
                            removeAction.title =
                                "Mark the selected bundle components for removal";
                
                            removeAction.icon = "";
                
                            actions.update(
                                "selection-delete"
                            );
                        }
                
                        /*
                         * Revert restores the selected rows to their
                         * state when the grid was last refreshed.
                         */
                        revertAction =
                            actions.lookup("selection-revert");
                
                        if (revertAction) {
                            revertAction.label =
                                "Revert Selected";
                
                            revertAction.title =
                                "Discard all unsaved changes for the selected bundle components";
                
                            revertAction.icon = "";
                
                            actions.update(
                                "selection-revert"
                            );
                        }
                    };
                
                    return options;
                }
                ```
        }
