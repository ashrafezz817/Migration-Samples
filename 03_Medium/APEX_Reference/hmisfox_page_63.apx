        column SERVICEID (
            type: popupLov
            heading {
                heading: Service
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with offer_context as (
                        select
                            o.oferid,
                            o.list_id,
                            o.offer_info_center,
                            o.is_deleted,
                    
                            ins_comp_util.get_price_plan(
                                o.offer_info_center,
                                ins_comp_util.get_cash_comp_code
                            ) as plan_code
                    
                        from offers o
                    
                        where o.oferid = :P63_OFERID
                          and o.offer_type = 0
                          and o.offer_info_center = :G_INFO_CENTER_ID
                    ),
                    lov_values as (
                        /*
                         * Services currently eligible for a new bundle component.
                         * Services already active on the offer are excluded.
                         */
                        select
                            trim(ppd.serviceid)
                                || ' - '
                                || trim(s.servicedesc) as display_value,
                    
                            ppd.serviceid as return_value
                    
                        from offer_context oc
                    
                        join price_plan_dtl ppd
                          on ppd.list_id = oc.list_id
                         and ppd.plan_code = oc.plan_code
                    
                        join services s
                          on s.serviceid = ppd.serviceid
                         and s.list_id = oc.list_id
                    
                        where oc.is_deleted = 'N'
                    
                          and not exists (
                              select 1
                              from offers_dtl d
                              where d.oferid = oc.oferid
                                and d.list_id = oc.list_id
                                and d.serviceid = ppd.serviceid
                                and d.is_deleted = 'N'
                          )
                    
                        union all
                    
                        /*
                         * Resolve the display value for the existing saved row.
                         *
                         * ORIGINAL_SERVICEID is populated for database rows and
                         * is null for newly inserted client-side rows.
                         */
                        select
                            trim(s.serviceid)
                                || ' - '
                                || trim(s.servicedesc) as display_value,
                    
                            s.serviceid as return_value
                    
                        from offer_context oc
                    
                        join services s
                          on s.serviceid = :ORIGINAL_SERVICEID
                         and s.list_id = oc.list_id
                    
                        where :ORIGINAL_SERVICEID is not null
                    )
                    select
                        display_value,
                        return_value
                    from lov_values
                    order by
                        display_value
                    ```
            }
            cascadingLov {
                parentColumns: ORIGINAL_SERVICEID
                itemsToSubmit: P63_OFERID
            }
            layout {
                sequence: 60
            }
            appearance {
                width: 360
            }
            validation {
                valueRequired: true
                maxLength: 20
            }
            source {
                databaseColumn: SERVICEID
                dataType: varchar2
            }
