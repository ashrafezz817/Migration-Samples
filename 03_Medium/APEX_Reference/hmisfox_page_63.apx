    region bundle-components (
        name: Bundle Components
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with component_base as (
                    select
                        d.row_id,
                        d.oferid,
                        d.list_id,
                        d.serviceid,
                        d.serviceid as original_serviceid,
                        d.qty,
                        d.org_price,
                        d.offer_price,
                        d.object_version_number,
                        s.vat_rate
                
                    from offers_dtl d
                
                    join offers o
                      on o.oferid = d.oferid
                     and o.list_id = d.list_id
                
                    join services s
                      on s.serviceid = d.serviceid
                     and s.list_id = d.list_id
                
                    where d.oferid = :P63_OFERID
                      and o.offer_type = 0
                      and o.offer_info_center = :G_INFO_CENTER_ID
                      and (
                            (
                                o.is_deleted = 'N'
                                and d.is_deleted = 'N'
                            )
                            or
                            (
                                o.is_deleted = 'Y'
                                and d.is_deleted = 'Y'
                                and d.delete_reason = 'OFFER_RETIRED'
                            )
                          )
                )
                select
                    row_id,
                    oferid,
                    list_id,
                    serviceid,
                    original_serviceid,
                    qty,
                    org_price,
                    offer_price,
                
                    case
                        when vat_rate is null then
                            'Exempt'
                        else
                            to_char(vat_rate, 'TM9') || '% VAT'
                    end as vat_status,
                
                    round(
                        qty * org_price,
                        2
                    ) as original_line_total,
                
                    round(
                        qty * offer_price,
                        2
                    ) as bundle_line_total,
                
                    round(
                        qty * org_price,
                        2
                    )
                    -
                    round(
                        qty * offer_price,
                        2
                    ) as savings,
                
                    object_version_number
                
                from component_base
                ```
            pageItemsToSubmit: P63_OFERID
        }
