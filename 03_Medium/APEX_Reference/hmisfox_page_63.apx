    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P63_SEARCH
        }
        clientSideCondition {
            type: item=value
            item: JAVASCRIPT_EXPRESSION
            value: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.p63BundleSearch.refreshNow();
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-after-create (
        name: Refresh After Bundle Create
        execution {
            sequence: 180
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @breadcrumb
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const newOfferId =
                        this.data &&
                        this.data.P64_OFERID;
                    
                    if (!newOfferId) {
                        return;
                    }
                    
                    if (apex.page.isChanged()) {
                        const offerListRegion =
                            apex.region("bundle_list")
                    
                        if (offerListRegion) {
                            offerListRegion.refresh();
                        }
                    
                        apex.message.alert(
                            "The new bundled offer was created, but it was not selected because this page has unsaved changes. Save or discard the current changes, then select the new bundled offer from the list."
                        );
                    
                        return;
                    }
                    
                    apex.item("P63_OFERID").setValue(
                        newOfferId
                    );
                    
                    apex.page.submit({
                        request: "SELECT_CREATED_OFFER",
                        showWait: true
                    });
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-after-update (
        name: Refresh After Bundle Update
        execution {
            sequence: 170
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @bundle-overview
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        :P63_BUNDLE_RETIRED := null;
                    
                        if :P63_OFERID is not null then
                            select case
                                       when o.is_deleted = 'Y' then 'Y'
                                       else 'N'
                                   end
                              into :P63_BUNDLE_RETIRED
                              from offers o
                             where o.oferid = :P63_OFERID
                               and o.offer_type = 0
                               and o.offer_info_center = :G_INFO_CENTER_ID;
                        end if;
                    
                    exception
                        when no_data_found then
                            :P63_OFERID         := null;
                            :P63_BUNDLE_RETIRED := null;
                    end;
                    ```
                itemsToSubmit: P63_OFERID
                itemsToReturn: [
                    P63_OFERID
                    P63_BUNDLE_RETIRED
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bundle-list
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bundle-components
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P63_BUNDLE_RETIRED
                value: Y
            }
        )

        action native-refresh_2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bundle-overview
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

