    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            window.p63BundleSearch = (function () {
                "use strict";
            
                let timerId = null;
            
                function refreshNow() {
                    if (timerId !== null) {
                        window.clearTimeout(timerId);
                        timerId = null;
                    }
            
                    const region =
                        apex.region("bundle_list");
            
                    if (region) {
                        region.refresh();
                    }
                }
            
                function refreshDebounced() {
                    if (timerId !== null) {
                        window.clearTimeout(timerId);
                    }
            
                    timerId = window.setTimeout(
                        function () {
                            timerId = null;
                            refreshNow();
                        },
                        300
                    );
                }
            
                return {
                    refreshNow: refreshNow,
                    refreshDebounced: refreshDebounced
                };
            })();
            
            
            
            ```
    }
    css {
        fileUrls: [
            #APP_FILES#empty-state.css
            #APP_FILES#badges.css
        ]
        inline:
            ```css
            /* =========================================================
               BUNDLE OVERVIEW
               Allows long bundle names, descriptions, and detail values
               to wrap without overflowing the Content Row.
               ========================================================= */
            
            #bundle_overview {
                overflow-wrap: anywhere;
            }
            
            
            /* =========================================================
               BUNDLE DESCRIPTION
               Keeps the bundle description visually secondary to the
               bundle name while maintaining readable contrast.
               ========================================================= */
            
            .bundle-overview-description {
                max-width: 80ch;
                margin-top: 4px;
            
                font-size: 13px;
                line-height: 1.5;
                color: #344054;
            }
            
            .bundle-overview-empty {
                font-style: italic;
                color: var(
                    --ut-component-text-muted-color,
                    #667085
                );
            }
            
            
            /* =========================================================
               BUNDLE DETAILS
               Distributes bundle metadata and financial totals evenly
               across the available region width.
               ========================================================= */
            
            .bundle-overview-layout {
                display: flex;
                gap: 20px;
                margin-top: 20px;
                align-items: stretch;
            }
            
            /* Left: metadata grid */
            .bundle-overview-meta {
                flex: 1.4;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
                align-content: center;
            }
            
            .bundle-overview-detail {
                background: #f7f9fb;
                border-radius: 8px;
                padding: 12px 14px;
                min-width: 0;
            }
            
            .bundle-overview-detail__label {
                display: block;
                margin-bottom: 5px;
                font-size: 11px;
                font-weight: 600;
                line-height: 1.4;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                color: var(--ut-component-text-muted-color, #667085);
            }
            
            .bundle-overview-detail__value {
                display: block;
                overflow-wrap: anywhere;
                font-size: 12px;
                font-weight: 500;
                color: #101828;
            }
            
            /* Right: savings hero panel */
            .bundle-overview-savings {
                position: relative;
                overflow: hidden;
                background: #23891E;
                border-radius: 12px;
                padding: 16px 18px;
                color: #ffffff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                flex: 0.7;
                gap: 4px;
                box-shadow: 0 8px 20px rgba(16, 24, 40, 0.14);
            }
            
            .bundle-overview-savings::after {
                content: none;
                position: absolute;
                top: -40px;
                right: -40px;
                width: 140px;
                height: 140px;
                border-radius: 50%;
                background: #ffffff;
            }
            
            .bundle-overview-savings__label {
                position: relative;
                display: block;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: #ffffff;
            }
            
            .bundle-overview-savings__amount {
                position: relative;
                margin-top: 4px;
                font-size: 26px;
                font-weight: 400;
                font-variant-numeric: tabular-nums;
            }
            
            .bundle-overview-savings__currency {
                margin-left: 6px;
                font-size: 15px;
                font-weight: 600;
                color: #ffffff;
            }
            
            .bundle-overview-savings__sub {
                position: relative;
                display: block;
                margin-top: 4px;
                font-size: 11px;
                color: #ffffff;
            }
            
            .bundle-overview-savings__divider {
                position: relative;
                height: 1px;
                background: #ffffff;
                margin: 12px 0;
            }
            
            .bundle-overview-savings__totals {
                position: relative;
                display: flex;
                justify-content: space-between;
                gap: 16px;
            }
            
            .bundle-overview-savings__totlabel {
                display: block;
                margin-bottom: 6px;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                color: #ffffff;
            }
            
            .bundle-overview-savings__strike {
                font-size: 14px;
                font-weight: 600;
                text-decoration: line-through;
                color: #ffffff;
            }
            
            .bundle-overview-savings__pill {
                display: inline-block;
                background: #22c55e;
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                padding: 3px 10px;
                border-radius: 6px;
            }
            
            .bundle-overview-savings__note {
                position: relative;
                font-size: 10px;
                font-weight: 500;
                line-height: 1.4;
                color: rgba(255, 255, 255, 0.9);
            }
            
            /* Stack on narrow screens */
            @media (max-width: 900px) {
                .bundle-overview-layout {
                    flex-direction: column;
                }
            }
            @media (max-width: 600px) {
                .bundle-overview-meta {
                    grid-template-columns: 1fr;
                }
            }
            
            
            /* =========================================================
               BUNDLE FINANCIAL VALUES
               Makes Original Total, Bundle Total, and Savings more
               prominent and keeps their digits consistently aligned.
               ========================================================= */
            
            .bundle-overview-detail--financial
            .bundle-overview-detail__value {
                font-size: 16px;
                font-weight: 700;
                font-variant-numeric: tabular-nums;
            }
            
            
            /* =========================================================
               TABLET LAYOUT
               Uses two balanced columns when four columns become too
               narrow for comfortable reading.
               ========================================================= */
            
            @media (max-width: 1100px) {
                .bundle-overview-details {
                    grid-template-columns:
                        repeat(2, minmax(0, 1fr));
            
                    gap: 18px 24px;
                }
            }
            
            
            /* =========================================================
               MOBILE LAYOUT
               Stacks all bundle facts vertically on narrow screens.
               ========================================================= */
            
            @media (max-width: 600px) {
                .bundle-overview-details {
                    grid-template-columns: 1fr;
                    gap: 14px;
                }
            
                .bundle-overview-detail--financial
                .bundle-overview-detail__value {
                    font-size: 15px;
                }
            }
            
            /* =========================================================
               BUNDLE STATUS
               Displays the prominent solid status badge at inline end.
               ========================================================= */
            
            .bundle-overview-status {
                display: flex;
                align-items: center;
                justify-content: flex-end;
            
                width: 100%;
                margin-bottom: 10px;
            }
            
            @media (max-width: 600px) {
                .bundle-overview-status {
                    justify-content: flex-start;
                }
            }
            ```
