        readOnly {
            type: expression
            plsqlExpression:
                ```plsql
                :P64_OFERID is not null
                and nvl(
                        fnd_app_security.has_permission(
                            'BILLING_BUNDLED_OFFERS_UPDATE'
                        ),
                        'FALSE'
                    ) <> 'TRUE'
                ```
