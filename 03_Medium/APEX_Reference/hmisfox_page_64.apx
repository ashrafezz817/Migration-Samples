    process initialize-manage-offer (
        name: Initialize Manage Offer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P64_OFERID is null then
                        :P64_OFFER_NAME           := null;
                        :P64_START_DATE           := trunc(sysdate);
                        :P64_ENDDATE              := trunc(sysdate) + 30;
                        :P64_VALID_DAYES          := null;
                        :P64_DESCRIPTION          := null;
                        :P64_OBJECT_VERSION_NUMBER := null;
                    else
                        select
                            o.offer_name,
                            o.start_date,
                            o.enddate,
                            o.valid_dayes,
                            o.notes,
                            o.object_version_number
                        into
                            :P64_OFFER_NAME,
                            :P64_START_DATE,
                            :P64_ENDDATE,
                            :P64_VALID_DAYES,
                            :P64_DESCRIPTION,
                            :P64_OBJECT_VERSION_NUMBER
                        from offers o
                        where o.oferid = :P64_OFERID
                          and o.offer_type = 0
                          and o.is_deleted = 'N'
                          and o.offer_info_center = :G_INFO_CENTER_ID;
                    end if;
                
                exception
                    when no_data_found then
                        raise_application_error(
                            -20003,
                            'The bundled offer was not found or is not available for the current information center.'
                        );
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 43074204650804239
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_application.g_request is null
        }
    )

