    validation end-date-must-not-precede-start-date (
        name: End Date Must Not Precede Start Date
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression:
                ```plsql
                apex_session_state.get_timestamp('P64_ENDDATE')
                >=
                apex_session_state.get_timestamp('P64_START_DATE')
                ```
        }
        error {
            errorMessage: End Date must be on or after Start Date.
            associatedItem: @P64_ENDDATE
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    validation valid-days-must-be-a-whole-number (
        name: Valid Days Must Be a Whole Number
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression:
                ```plsql
                :P64_VALID_DAYES between 0 and 9999
                and :P64_VALID_DAYES = trunc(:P64_VALID_DAYES)
                ```
        }
        error {
            errorMessage: Valid Days must be a whole number from 0 through 9999.
            associatedItem: @P64_VALID_DAYES
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process authorize-offer-mode (
        name: Authorize Offer Mode
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_can_create boolean :=
                        nvl(
                            fnd_app_security.has_permission(
                                'BILLING_BUNDLED_OFFERS_CREATE'
                            ),
                            'FALSE'
                        ) = 'TRUE';
                
                    l_can_update boolean :=
                        nvl(
                            fnd_app_security.has_permission(
                                'BILLING_BUNDLED_OFFERS_UPDATE'
                            ),
                            'FALSE'
                        ) = 'TRUE';
                
                    l_can_retire boolean :=
                        nvl(
                            fnd_app_security.has_permission(
                                'BILLING_BUNDLED_OFFERS_RETIRE'
                            ),
                            'FALSE'
                        ) = 'TRUE';
                begin
                    if :P64_OFERID is null then
                        if not l_can_create then
                            raise_application_error(
                                -20001,
                                'You are not authorized to create bundled offers.'
                            );
                        end if;
                    else
                        if not l_can_update
                           and not l_can_retire
                        then
                            raise_application_error(
                                -20002,
                                'You are not authorized to manage this bundled offer.'
                            );
                        end if;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 43073843230804237
        }
    )

    process close-dialog (
        name: Close Dialog
